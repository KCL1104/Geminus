      "arrival": {
        "distribution": {
          "type": "exponential",
          "mean": 4
        }
      }
    },
    {
      "id": "line",
      "type": "queue"
    },
    {
      "id": "counter",
      "type": "process",
      "service_time": {
        "distribution": {
          "type": "triangular",
          "min": 3,
          "mode": 6,
          "max": 12
        }
      },
      "requires": [
        {
          "resource_id": "clerk",
          "units": 1
        }
      ]
