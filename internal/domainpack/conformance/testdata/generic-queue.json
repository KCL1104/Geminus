    {
      "id": "follow_up",
      "type": "decision"
    },
    {
      "id": "leave",
      "type": "sink",
      "outcome": "completed"
    }
  ],
  "flows": [
    {
      "id": "arrive",
      "from": "arrivals",
      "to": "line",
      "routing": {
        "type": "probability",
        "probability": 1
      }
    },
    {
      "id": "serve",
      "from": "line",
      "to": "counter",
      "routing": {
        "type": "probability",
        "probability": 1
      }
    },
    {
      "id": "check",
      "from": "counter",
