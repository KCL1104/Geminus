        "type": "probability",
        "probability": 1
      }
    },
    {
      "id": "again",
      "from": "follow_up",
      "to": "line",
      "routing": {
        "type": "probability",
        "probability": 0.1
      }
    },
    {
      "id": "done",
      "from": "follow_up",
      "to": "leave",
      "routing": {
        "type": "probability",
        "probability": 0.9
      }
    }
  ],
  "constraints": [],
  "metrics": [
