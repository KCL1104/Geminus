  "entity_types": [
    {
      "id": "customer",
      "name": "Customer"
    }
  ],
  "resources": [
    {
      "id": "clerk",
      "type": "generic",
      "name": "Clerk",
      "capacity": 2,
      "queue_discipline": "fifo"
    }
  ],
  "nodes": [
    {
      "id": "arrivals",
      "type": "source",
