    },
    {
      "id": "first_fail",
      "type": "flow_count",
      "flow_id": "test_fail"
    },
    {
      "id": "scrapped",
      "type": "sink_count",
      "sink_id": "scrap"
    },
    {
      "id": "daily_output",
      "type": "period_throughput",
      "period": 1440
    }
  ],
  "calendars": [
    {
      "id": "two_shift",
      "name": "Two shifts",
      "period": 1440,
      "shifts": [
        {
          "start": 360,
          "end": 840,
          "label": "day"
        },
        {
          "start": 840,
          "end": 1320,
          "label": "evening"
        }
      ],
      "exceptions": [
        {
          "start": 7200,
          "end": 8640,
