# Configuration sketch, NOT a runnable application configuration.
# Resolve providers / credentials / approved decisions in T-001 and T-002.
APP_ENV=development
DATABASE_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
# Browser session (BFF, ADR-018, T-043; docs/runbooks/auth0.md). Server-side only;
# the client secret and SESSION_KEYS come from a secret manager, never this file.
BFF_APP_ORIGIN=
BFF_API_URL=
BFF_OIDC_ISSUER=
BFF_OIDC_AUTHORIZATION_URL=
BFF_OIDC_TOKEN_URL=
BFF_OIDC_REVOCATION_URL=
BFF_OIDC_END_SESSION_URL=
BFF_OIDC_JWKS_URL=
BFF_OIDC_CLIENT_ID=
BFF_OIDC_CLIENT_SECRET=
BFF_OIDC_AUDIENCE=
SESSION_KEYS=
# Object storage (D-044, T-023): "disabled" (default, or empty), "filesystem", which is for
# development and tests only (APP_ENV development or test; refused for production and when
# APP_ENV is unset) and needs a clean absolute OBJECT_STORAGE_ROOT that exists, or "s3" (T-039,
# ADR-029), a private S3-compatible bucket: all of OBJECT_STORAGE_S3_* (the access key ID and
# secret come from the platform's secret store, never this file; URL style "virtual-hosted" or
# "path"). Runs that bind datasets or record a sampled trace are refused (503) while it is disabled.
# All variables: docs/runbooks/deploy.md §4.
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_ROOT=
OBJECT_STORAGE_S3_ENDPOINT=
OBJECT_STORAGE_S3_BUCKET=
OBJECT_STORAGE_S3_REGION=
OBJECT_STORAGE_S3_URL_STYLE=
# Operator commands (T-039, D-042): their own logins, never the runtime DATABASE_URL. Set in the
# migration step and the operator's shell only (secret: they hold passwords).
# GEMINUS_MIGRATE_DATABASE_URL=   cmd/migrate (geminus_migrator)
# GEMINUS_PROVISION_DATABASE_URL= cmd/provision-tenant (geminus_provisioner)
# AI (T-024, ADR-027 PROPOSED). AI_PROVIDER: "disabled" (default, or empty); "fake", the
# deterministic test answerer, for APP_ENV development or test only; "anthropic" (H-001), which
# also needs AI_POLICY_APPROVAL to name an owner approval of model, quota and data policy that
# this build records (internal/config/aiapproval). No approval is recorded yet
# (H-017), so live AI cannot be enabled. AI_MODEL is required with "anthropic" and has no default.
# The keys (D-018) are read only once live AI is approved, from GEMINUS_ANTHROPIC_API_KEY_A
# (label org-a) and the optional GEMINUS_ANTHROPIC_API_KEY_B (org-b). They are deliberately not
# listed here: never put real API keys in this file or anywhere in the repository; inject them
# from a secret manager. AI_API_KEY is refused.
AI_PROVIDER=disabled
AI_POLICY_APPROVAL=
AI_MODEL=
# Budgets: positive integers (AI_MAX_RETRIES may be 0); empty keeps internal/ai/provider.DefaultBudget,
# and provider.New refuses values above BudgetCaps. No service calls the provider before T-025.
AI_MAX_PROMPT_BYTES=
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_SECONDS=
AI_ATTEMPT_TIMEOUT_SECONDS=
AI_MAX_RETRIES=
AI_MAX_CONCURRENT_PER_ORGANIZATION=
# Worker (T-019, ADR-024): a name for this worker's leases, and the organizations it serves (D-008), comma-separated.
WORKER_ID=
WORKER_ORGANIZATION_IDS=
# D-007 initial candidate limits; require review before deployment. Not read yet: every run
# freezes internal/runs.DefaultLimits (these values; replications are capped by the run schema) at
# enqueue (T-023).
SIMULATION_TIMEOUT_SECONDS=300
SIMULATION_MAX_REPLICATIONS=1000
SIMULATION_MAX_EVENTS=10000000
SIMULATION_MAX_ACTIVE_ENTITIES=100000
SIMULATION_MAX_TRACE_EVENTS=100000
UPLOAD_MAX_BYTES=50000000
UPLOAD_MAX_ROWS=100000
