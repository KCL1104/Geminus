-- T-023 (migration 0009; TEST-019, TEST-020, TEST-021): a simulation run
-- moves only along its lifecycle and each runtime role only its own way;
-- the run follows its job; a result is stored only for its running run,
-- reproducing its frozen input; the trace is named all or nothing.
-- Disposable dt_test_* database only (scripts/run_db_tests.sh). One
-- transaction, rolled back. Generated by scripts/render_db_tests.py.
\set ON_ERROR_STOP 1
BEGIN;
CREATE FUNCTION pg_temp.fail(msg text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF current_setting('dt.collect', true) = 'on' THEN RAISE WARNING 'FAILED: %', msg;
  ELSE RAISE EXCEPTION 'FAILED: %', msg; END IF;
END $$;
CREATE FUNCTION pg_temp.must_fail(stmt text, state text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE got text; msg text;
BEGIN
  BEGIN
    EXECUTE stmt;
    RAISE EXCEPTION USING ERRCODE = 'P0099'; -- roll the unexpected success back
  EXCEPTION WHEN OTHERS THEN
    got := SQLSTATE; msg := SQLERRM;
  END;
  IF got = 'P0099' THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but the statement succeeded: %s', state, stmt));
  ELSIF got <> state THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but got %s (%s) for: %s', state, got, msg, stmt));
  END IF;
END $$;
CREATE FUNCTION pg_temp.check(ok boolean, what text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF ok IS NOT TRUE THEN PERFORM pg_temp.fail(what); END IF;
END $$;
-- A completed run's result as the worker stores it: the run's frozen
-- input, its digest, and the trace artifact (or none).
CREATE FUNCTION pg_temp.result(run text, digest text, art text) RETURNS jsonb LANGUAGE sql AS $$
  SELECT jsonb_build_object('run_id', run, 'status', 'completed', 'engine_version', 'des-go-0.1.0',
    'reproducibility', jsonb_build_object('seed', 7, 'replications', 2, 'model_hash', '{{IR_A1_HASH}}',
      'effective_model_hash', '{{IR_A1_HASH}}', 'config_hash', '{{H1}}', 'dataset_manifest_hash', '{{EMPTY_MANIFEST_HASH}}',
      'result_digest', digest),
    'trace', jsonb_build_object('available', art IS NOT NULL, 'sampled_events', 3, 'artifact_id', art))
$$;
CREATE FUNCTION pg_temp.state(run text) RETURNS text LANGUAGE sql AS $$
  SELECT concat_ws(' ', status, completed_replications, events_processed, progress_revision, cancellation_requested,
    error->>'code', finished_at IS NOT NULL)
  FROM twin.simulation_runs WHERE organization_id='{{ORG_A}}' AND id=run
$$;
-- What an operator's direct UPDATE of a run did: 'moved', or 'refused'
-- (55000, rolled back).
CREATE FUNCTION pg_temp.operator_moves(run text, change text) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
  EXECUTE format('UPDATE twin.simulation_runs SET %s, progress_revision=progress_revision+1 WHERE organization_id=%L AND id=%L',
    change, '{{ORG_A}}', run);
  RETURN 'moved';
EXCEPTION WHEN SQLSTATE '55000' THEN
  RETURN 'refused';
END $$;
GRANT EXECUTE ON FUNCTION pg_temp.result(text, text, text), pg_temp.state(text), pg_temp.operator_moves(text, text) TO PUBLIC;

