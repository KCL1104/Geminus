INSERT INTO twin.model_versions(id,organization_id,model_id,version,schema_version,parent_version_id,ir,hash,created_by) VALUES
  ('{{MV_A1}}','{{ORG_A}}','{{MDL_A}}',1,'0.1',NULL,'{{IR_A1}}','{{IR_A1_HASH}}','{{USR_A}}'),
  ('{{MV_A2}}','{{ORG_A}}','{{MDL_A}}',2,'0.1','{{MV_A1}}','{{IR_A2}}','{{IR_A2_HASH}}','{{USR_A}}'),
