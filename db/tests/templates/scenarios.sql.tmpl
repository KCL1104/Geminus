UPDATE twin.models SET latest_version_id='{{MV_A21}}' WHERE organization_id='{{ORG_A}}' AND id='{{MDL_A2}}';
SET CONSTRAINTS ALL IMMEDIATE;
SET CONSTRAINTS ALL DEFERRED;

-- Grants: the API reads and creates scenarios and never changes or deletes
-- one; the worker only reads them (0002); nobody calls the guard.
SELECT pg_temp.check(has_table_privilege('twin_api','twin.scenarios','SELECT') AND has_table_privilege('twin_api','twin.scenarios','INSERT'),
  'the API reads and creates scenarios');
SELECT pg_temp.check(NOT has_table_privilege('twin_api','twin.scenarios','UPDATE') AND NOT has_table_privilege('twin_api','twin.scenarios','DELETE')
    AND NOT has_table_privilege('twin_api','twin.scenarios','TRUNCATE'), 'the API never changes or deletes a scenario');
SELECT pg_temp.check(has_table_privilege('twin_worker','twin.scenarios','SELECT') AND NOT has_table_privilege('twin_worker','twin.scenarios','INSERT')
    AND NOT has_table_privilege('twin_worker','twin.scenarios','UPDATE') AND NOT has_table_privilege('twin_worker','twin.scenarios','DELETE'),
  'the worker only reads scenarios');
SELECT pg_temp.check(NOT has_function_privilege('public','twin.protect_scenario_creation()','EXECUTE'), 'PUBLIC cannot call the creation guard');
SELECT pg_temp.check(EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
    WHERE n.nspname='twin' AND p.proname='protect_scenario_creation' AND p.proconfig @> ARRAY['search_path=pg_catalog, pg_temp']),
  'the creation guard fixes its search_path');
SELECT pg_temp.check(relforcerowsecurity AND relrowsecurity, 'scenarios force RLS') FROM pg_class WHERE oid='twin.scenarios'::regclass;
SELECT pg_temp.check(EXISTS (SELECT 1 FROM pg_indexes WHERE schemaname='twin' AND tablename='scenarios' AND indexname='scenarios_base_idx'
    AND indexdef LIKE '%(organization_id, base_version_id, created_at, id)%'), 'the list has its index');

SET LOCAL ROLE twin_api;
-- A person's scenario on the latest version and one on the older version
-- (D-067: any version), for the scoped user, at the transaction's time.
SELECT pg_temp.scenario('{{SCN_A4}}', '{{MDL_A}}', '{{MV_A2}}', 'Eight CI runners', '{{USR_A}}') \gexec
SELECT pg_temp.scenario('{{SCN_A5}}', '{{MDL_A}}', '{{MV_A1}}', repeat('é', 200), '{{USR_A}}') \gexec
SET CONSTRAINTS ALL IMMEDIATE; -- a scenario without a source proposal needs none at commit (0013)
SET CONSTRAINTS ALL DEFERRED;
SELECT pg_temp.check(count(*) = 2 AND bool_and(created_at = now() AND source_proposal_id IS NULL AND created_by = '{{USR_A}}'),
  'the two scenarios are the scoped user''s, now, without a source proposal')
  FROM twin.scenarios WHERE organization_id='{{ORG_A}}' AND id IN ('{{SCN_A4}}','{{SCN_A5}}');

-- D-080 (b): the API creates a scenario for the scoped user only, and at
-- the time of its transaction.
SELECT pg_temp.must_fail(pg_temp.scenario('{{SCN_A6}}', '{{MDL_A}}', '{{MV_A2}}', 'For someone else', '{{USR_A2}}'), '42501');
SELECT pg_temp.must_fail($q$INSERT INTO twin.scenarios(id,organization_id,model_id,base_version_id,name,patch,patch_hash,created_by,created_at)
    VALUES ('{{SCN_A6}}','{{ORG_A}}','{{MDL_A}}','{{MV_A2}}','Back-dated','[]','{{EMPTY_MANIFEST_HASH}}','{{USR_A}}',now() - interval '1 day')$q$, '55000');
SELECT pg_temp.must_fail($q$INSERT INTO twin.scenarios(id,organization_id,model_id,base_version_id,name,patch,patch_hash,created_by,created_at)
    VALUES ('{{SCN_A6}}','{{ORG_A}}','{{MDL_A}}','{{MV_A2}}','Ahead','[]','{{EMPTY_MANIFEST_HASH}}','{{USR_A}}',now() + interval '1 second')$q$, '55000');
-- D-080 (a): a name is 1 to 200 characters.
SELECT pg_temp.must_fail(pg_temp.scenario('{{SCN_A6}}', '{{MDL_A}}', '{{MV_A2}}', n, '{{USR_A}}'), '23514')
  FROM unnest(ARRAY['', repeat('x', 201)]) AS n;
-- 0001: the base is a version of the same organization and model; the
-- patch is an array; the organization is the transaction's (RLS).
SELECT pg_temp.must_fail(pg_temp.scenario('{{SCN_A6}}', '{{MDL_A}}', '{{MV_A21}}', 'Another model''s version', '{{USR_A}}'), '23503');
SELECT pg_temp.must_fail(pg_temp.scenario('{{SCN_A6}}', '{{MDL_A}}', '{{MV_B1}}', 'Another tenant''s version', '{{USR_A}}'), '23503');
SELECT pg_temp.must_fail(pg_temp.scenario('{{SCN_A6}}', '{{MDL_A}}', '{{MV_X}}', 'No such version', '{{USR_A}}'), '23503');
SELECT pg_temp.must_fail($q$INSERT INTO twin.scenarios(id,organization_id,model_id,base_version_id,name,patch,patch_hash,created_by)
    VALUES ('{{SCN_A6}}','{{ORG_A}}','{{MDL_A}}','{{MV_A2}}','Not a patch','{"op":"test"}','{{EMPTY_MANIFEST_HASH}}','{{USR_A}}')$q$, '23514');
SELECT pg_temp.must_fail($q$INSERT INTO twin.scenarios(id,organization_id,model_id,base_version_id,name,patch,patch_hash,created_by)
    VALUES ('{{SCN_A6}}','{{ORG_B}}','{{MDL_B}}','{{MV_B1}}','Into tenant B','[]','{{EMPTY_MANIFEST_HASH}}','{{USR_A}}')$q$, '42501');
SELECT pg_temp.must_fail($q$INSERT INTO twin.scenarios(id,organization_id,model_id,base_version_id,name,patch,patch_hash,created_by)
    VALUES ('{{SCN_A6}}','{{ORG_A}}','{{MDL_A}}','{{MV_A2}}','Bad hash','[]','sha256:x','{{USR_A}}')$q$, '23514');

-- TEST-004: nobody changes or deletes a scenario; the API has no privilege
-- to, and the schema owner is refused by 0001's trigger.
SELECT pg_temp.must_fail(format('UPDATE twin.scenarios SET %s WHERE organization_id=%L AND id=%L', s, '{{ORG_A}}', '{{SCN_A4}}'), '42501')
  FROM unnest(ARRAY[$q$name='Renamed'$q$, $q$patch='[{"op":"test","path":"/name","value":"x"}]'$q$, $q$base_version_id='{{MV_A1}}'$q$]) AS s;
SELECT pg_temp.must_fail(format('DELETE FROM twin.scenarios WHERE organization_id=%L AND id=%L', '{{ORG_A}}', '{{SCN_A4}}'), '42501');
SELECT pg_temp.must_fail('TRUNCATE twin.scenarios', '42501');
SET LOCAL ROLE twin_owner;
SELECT pg_temp.must_fail(format('UPDATE twin.scenarios SET %s WHERE organization_id=%L AND id=%L', s, '{{ORG_A}}', '{{SCN_A4}}'), '55000')
  FROM unnest(ARRAY[$q$name='Renamed'$q$, $q$patch_hash='{{H1}}'$q$, $q$created_by='{{USR_A2}}'$q$]) AS s;
SELECT pg_temp.must_fail(format('DELETE FROM twin.scenarios WHERE organization_id=%L AND id=%L', '{{ORG_A}}', '{{SCN_A4}}'), '55000');
-- CASCADE: proposals and runs reference scenarios, and without it the
-- foreign keys would refuse before the trigger (constraints.sql does the
-- same for versions).
SELECT pg_temp.must_fail('TRUNCATE twin.scenarios CASCADE', '55000');
-- The schema owner is not held to the creator and the time (operators).
INSERT INTO twin.scenarios(id,organization_id,model_id,base_version_id,name,patch,patch_hash,created_by,created_at)
  VALUES ('{{SCN_A7}}','{{ORG_A}}','{{MDL_A}}','{{MV_A2}}','Restored','[]','{{EMPTY_MANIFEST_HASH}}','{{USR_A2}}',now() - interval '1 day');
SELECT pg_temp.check(name = 'Eight CI runners' AND patch = '[]'::jsonb, 'the scenario is as it was created')
  FROM twin.scenarios WHERE organization_id='{{ORG_A}}' AND id='{{SCN_A4}}';

-- TEST-010: a transaction sees only its own organization's scenarios,
-- and none without one; the API cannot read tenant B's from tenant A.
SET LOCAL ROLE twin_api;
SELECT pg_temp.check(count(*) = 3, 'tenant A sees its three scenarios') FROM twin.scenarios;
SELECT pg_temp.check(count(*) = 0, 'tenant A does not see tenant B''s scenario') FROM twin.scenarios WHERE id='{{SCN_B1}}';
SELECT set_config('app.organization_id','{{ORG_B}}',true), set_config('app.user_id','{{USR_B}}',true);
SELECT pg_temp.check(count(*) = 1 AND bool_and(id = '{{SCN_B1}}'), 'tenant B sees only its own') FROM twin.scenarios;
SELECT set_config('app.organization_id','',true), set_config('app.user_id','',true);
SELECT pg_temp.check(count(*) = 0, 'no organization, no scenario') FROM twin.scenarios;
SET LOCAL ROLE twin_worker;
SELECT set_config('app.organization_id','{{ORG_A}}',true);
SELECT pg_temp.check(count(*) = 3, 'the worker reads the organization''s scenarios') FROM twin.scenarios;
SELECT pg_temp.must_fail(pg_temp.scenario('{{SCN_A8}}', '{{MDL_A}}', '{{MV_A2}}', 'By the worker', '{{USR_A}}'), '42501');

-- The list reads a version's scenarios in (created_at, id) order: the
-- three on version 2, two of them created in this transaction, so the ID
-- breaks the tie.
SET LOCAL ROLE twin_api;
SELECT set_config('app.user_id','{{USR_A}}',true);
SELECT pg_temp.scenario('{{SCN_A9}}', '{{MDL_A}}', '{{MV_A2}}', 'Nine CI runners', '{{USR_A}}') \gexec
SELECT pg_temp.check(array_agg(id::text ORDER BY created_at, id) = ARRAY['{{SCN_A7}}','{{SCN_A4}}','{{SCN_A9}}']::text[],
  'the version''s scenarios in (created_at, id) order')
  FROM twin.scenarios WHERE organization_id='{{ORG_A}}' AND base_version_id='{{MV_A2}}';
ROLLBACK;
