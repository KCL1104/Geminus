-- T-028 (migration 0015; REQ-010, D-004, D-021, D-067; D-080 APPROVED;
-- TEST-004, TEST-008, TEST-010): a scenario a person saves through the API
-- is an immutable row of its own organization, on a version of the same
-- model (any version, not only the latest: D-067), for the scoped user, at
-- the time of its transaction, with a name of 1 to 200 characters; RLS
-- hides it from every other organization and from a transaction without
-- one; nobody changes or deletes it; the worker cannot create one; the
-- list's index exists. Disposable dt_test_* database only
-- (scripts/run_db_tests.sh). One transaction, rolled back. Generated by
-- scripts/render_db_tests.py.
\set ON_ERROR_STOP 1
BEGIN;
CREATE FUNCTION pg_temp.fail(msg text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF current_setting('dt.collect', true) = 'on' THEN RAISE WARNING 'FAILED: %', msg;
  ELSE RAISE EXCEPTION 'FAILED: %', msg; END IF;
END $$;
CREATE FUNCTION pg_temp.must_fail(stmt text, state text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE got text; msg text;
BEGIN
  BEGIN
    EXECUTE stmt;
    RAISE EXCEPTION USING ERRCODE = 'P0099'; -- roll the unexpected success back
  EXCEPTION WHEN OTHERS THEN
    got := SQLSTATE; msg := SQLERRM;
  END;
  IF got = 'P0099' THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but the statement succeeded: %s', state, stmt));
  ELSIF got <> state THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but got %s (%s) for: %s', state, got, msg, stmt));
  END IF;
END $$;
CREATE FUNCTION pg_temp.check(ok boolean, what text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF ok IS NOT TRUE THEN PERFORM pg_temp.fail(what); END IF;
END $$;
-- The INSERT of a scenario of tenant A without a source proposal: id,
-- model, base version, name and creator as given, an empty patch with its
-- D-019 hash.
CREATE FUNCTION pg_temp.scenario(id text, mdl text, base text, name text, creator text) RETURNS text LANGUAGE sql AS $$
  SELECT format('INSERT INTO twin.scenarios(id,organization_id,model_id,base_version_id,name,patch,patch_hash,created_by) '
      'VALUES (%L,%L,%L,%L,%L,%L,%L,%L)',
    id, '{{ORG_A}}', mdl, base, name, '[]', '{{EMPTY_MANIFEST_HASH}}', creator)
$$;
GRANT EXECUTE ON FUNCTION pg_temp.scenario(text, text, text, text, text) TO PUBLIC;

SET LOCAL ROLE twin_owner;
