  FROM pg_policy WHERE polrelid IN ('twin.memberships'::regclass, 'twin.organizations'::regclass);

-- No organization selected, user a: a's own memberships (A owner, C
-- editor), not b's membership of A, and only the organizations a belongs to.
SET LOCAL ROLE twin_api;
SELECT pg_temp.scope('', '{{USR_A}}');
SELECT pg_temp.check(pg_temp.seen_memberships() = '{{ORG_A}}:{{USR_A}}:owner {{ORG_C}}:{{USR_A}}:editor',
