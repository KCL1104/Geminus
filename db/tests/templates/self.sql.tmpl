-- The organizations policy reads memberships as the API role, so
-- memberships' policies filter that subquery too: without own_memberships
-- (dropped in a savepoint) the self scope sees no organization.
SET LOCAL ROLE twin_owner;
SAVEPOINT subquery;
DROP POLICY own_memberships ON twin.memberships;
SET LOCAL ROLE twin_api;
SELECT pg_temp.scope('', '{{USR_A}}');
SELECT pg_temp.check(pg_temp.seen_organizations() = '',
  'own_organizations'' subquery ignores memberships'' RLS: ' || pg_temp.seen_organizations());
SET LOCAL ROLE twin_owner;
ROLLBACK TO SAVEPOINT subquery;
SELECT pg_temp.check(count(*) = 1, 'own_memberships restored') FROM pg_policy WHERE polname = 'own_memberships';
-- And own_organizations states both of its conditions itself, so it does
-- not rest on memberships' policies alone: with a probe policy that shows
-- the API every membership (added in a savepoint), it still shows only the
-- user's own organizations, and nothing beyond tenant_isolation once an
-- organization is selected.
SAVEPOINT probe;
CREATE POLICY probe_all_memberships ON twin.memberships FOR SELECT TO twin_api USING (true);
SET LOCAL ROLE twin_api;
SELECT pg_temp.scope('', '{{USR_A}}');
SELECT pg_temp.check(pg_temp.seen_organizations() = '{{ORG_A}}:Tenant A {{ORG_C}}:Tenant C',
  'own_organizations needs memberships'' RLS to name the user: ' || pg_temp.seen_organizations());
SELECT pg_temp.scope('{{ORG_A}}', '{{USR_A}}');
SELECT pg_temp.check(pg_temp.seen_organizations() = '{{ORG_A}}:Tenant A',
  'own_organizations applies with an organization selected: ' || pg_temp.seen_organizations());
SET LOCAL ROLE twin_owner;
ROLLBACK TO SAVEPOINT probe;
SELECT pg_temp.check(count(*) = 0, 'the probe policy is gone') FROM pg_policy WHERE polname = 'probe_all_memberships';

