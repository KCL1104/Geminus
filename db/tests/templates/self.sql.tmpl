-- The policies: SELECT only, permissive, for twin_api alone (the worker and
-- provisioning get nothing), and nothing else was added to these tables.
SELECT pg_temp.check(count(*) = 2, 'own_memberships and own_organizations are permissive SELECT policies for twin_api only')
  FROM pg_policy p
  WHERE (p.polname, p.polrelid) IN (('own_memberships', 'twin.memberships'::regclass), ('own_organizations', 'twin.organizations'::regclass))
    AND p.polcmd = 'r' AND p.polpermissive AND p.polroles = ARRAY['twin_api'::regrole::oid] AND p.polwithcheck IS NULL;
