-- With an organization selected the policies add nothing: the API sees
-- exactly what tenant_isolation shows, which is what the owner role (whose
-- only policy is tenant_isolation) sees with the same settings. Selected
-- organizations include ones the user is not a member of: RLS selects
-- rows, membership is the application's check (tenant.DB.Run).
SET LOCAL ROLE twin_api;
SELECT pg_temp.look('api');
SET LOCAL ROLE twin_owner;
SELECT pg_temp.look('owner');
SELECT pg_temp.check(s.memberships = c.want_memberships AND s.organizations = c.want_organizations,
    format('the API with %s selected as %s sees %s / %s', s.org, s.usr, s.memberships, s.organizations))
  FROM seen s JOIN scoped c ON (c.org, c.usr) = (s.org, s.usr) WHERE s.role = 'api';
SELECT pg_temp.check(count(*) = 5, 'organization-scoped views differ from tenant_isolation''s: ' || coalesce(string_agg(a.org, ', '), ''))
  FROM seen a JOIN seen o ON o.role = 'owner' AND a.role = 'api' AND (a.org, a.usr) = (o.org, o.usr)
  WHERE (a.memberships, a.organizations, a.other) = (o.memberships, o.organizations, o.other);
SELECT pg_temp.check(other <> '', 'the comparison saw no other tenant rows for ' || org) FROM seen WHERE org <> '{{ORG_X}}';
-- The policies are the API's: the owner role with no organization
