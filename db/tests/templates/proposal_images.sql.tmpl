-- T-056 (migration 0017): the photo an edit proposal is asked for with is
-- recorded with its proposal, in the transaction that creates it, for the
-- scoped user, in the shape the server stores (key, hash, size, type,
-- pixels), and never changes; a proposal without an intent has exactly one
-- photo, one with an intent none (at commit); RLS and grants as 0002.
-- Disposable dt_test_* database only (scripts/run_db_tests.sh). One
-- transaction, rolled back. Generated by scripts/render_db_tests.py.
\set ON_ERROR_STOP 1
BEGIN;
CREATE FUNCTION pg_temp.fail(msg text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF current_setting('dt.collect', true) = 'on' THEN RAISE WARNING 'FAILED: %', msg;
  ELSE RAISE EXCEPTION 'FAILED: %', msg; END IF;
END $$;
CREATE FUNCTION pg_temp.must_fail(stmt text, state text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE got text; msg text;
BEGIN
  BEGIN
    EXECUTE stmt;
    RAISE EXCEPTION USING ERRCODE = 'P0099'; -- roll the unexpected success back
  EXCEPTION WHEN OTHERS THEN
    got := SQLSTATE; msg := SQLERRM;
  END;
  IF got = 'P0099' THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but the statement succeeded: %s', state, stmt));
  ELSIF got <> state THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but got %s (%s) for: %s', state, got, msg, stmt));
  END IF;
END $$;
-- The statements run one after the other and the deferred checks run as
-- at commit; all of it is rolled back, and the outcome must be state.
CREATE FUNCTION pg_temp.must_fail_at_commit(stmts text[], state text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE got text; msg text; s text;
BEGIN
  BEGIN
    FOREACH s IN ARRAY stmts LOOP
      EXECUTE s;
    END LOOP;
    SET CONSTRAINTS ALL IMMEDIATE;
    RAISE EXCEPTION USING ERRCODE = 'P0099'; -- roll the unexpected success back
  EXCEPTION WHEN OTHERS THEN
    got := SQLSTATE; msg := SQLERRM;
  END;
  SET CONSTRAINTS ALL DEFERRED;
  IF got = 'P0099' THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s at commit but it committed: %s', state, array_to_string(stmts, '; ')));
  ELSIF got <> state THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s at commit but got %s (%s) for: %s', state, got, msg, array_to_string(stmts, '; ')));
  END IF;
END $$;
CREATE FUNCTION pg_temp.check(ok boolean, what text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF ok IS NOT TRUE THEN PERFORM pg_temp.fail(what); END IF;
END $$;
-- The INSERT of a generating proposal (mode, intent as SQL literals).
CREATE FUNCTION pg_temp.proposal(id text, mode text, intent text) RETURNS text LANGUAGE sql AS $$
  SELECT format($f$INSERT INTO twin.ai_proposals(id,organization_id,model_id,base_version_id,mode,status,intent,created_by,id_pool)
    VALUES (%L,'{{ORG_A}}','{{MDL_A}}','{{MV_A1}}',%L,'generating',%L,'{{USR_A}}','{{POOL_1}}')$f$, id, mode, intent)
$$;
-- The INSERT of a proposal's image, its key under the proposal's prefix;
-- the other members as SQL literals.
CREATE FUNCTION pg_temp.image(id text, size text, media text, w text, h text) RETURNS text LANGUAGE sql AS $$
  SELECT format($f$INSERT INTO twin.ai_proposal_images(organization_id,proposal_id,object_key,content_hash,size_bytes,media_type,width,height)
    VALUES ('{{ORG_A}}',%L,%L,'{{H1}}',%s,%L,%s,%s)$f$, id, 'tenant/{{ORG_A}}/assets/proposal-images/' || id || '/image', size, media, w, h)
$$;
GRANT EXECUTE ON FUNCTION pg_temp.fail(text), pg_temp.must_fail(text, text), pg_temp.must_fail_at_commit(text[], text),
  pg_temp.check(boolean, text), pg_temp.proposal(text, text, text), pg_temp.image(text, text, text, text, text) TO PUBLIC;

