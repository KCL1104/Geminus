SELECT pg_temp.must_fail($q$INSERT INTO twin.ai_proposal_images(organization_id,proposal_id,object_key,content_hash,size_bytes,media_type,width,height)
  VALUES ('{{ORG_A}}','{{AIP_A32}}','tenant/{{ORG_A}}/assets/proposal-images/{{AIP_A32}}/image','{{H1}}',10,'image/png',64,64)$q$, '55000');
