SELECT pg_temp.check(NOT has_function_privilege('public','twin.protect_ai_proposal_image()','EXECUTE')
  AND NOT has_function_privilege('public','twin.check_proposal_source()','EXECUTE'), 'PUBLIC calls neither trigger function');

