-- Grants: the API inserts and reads, the worker reads, nobody updates,
-- deletes or truncates; PUBLIC has nothing; RLS is forced.
SELECT pg_temp.check(has_table_privilege('twin_api','twin.ai_proposal_images','SELECT') AND has_table_privilege('twin_api','twin.ai_proposal_images','INSERT')
  AND NOT has_table_privilege('twin_api','twin.ai_proposal_images','UPDATE') AND NOT has_table_privilege('twin_api','twin.ai_proposal_images','DELETE')
  AND NOT has_table_privilege('twin_api','twin.ai_proposal_images','TRUNCATE'), 'the API inserts and reads images only');
