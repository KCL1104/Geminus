  replace(pg_temp.image('{{AIP_A33}}', '100', 'image/png', '64', '64'), '{{H1}}', 'sha256:short'),
  replace(pg_temp.image('{{AIP_A33}}', '100', 'image/png', '64', '64'), '/image''', '/../image'''),
  replace(pg_temp.image('{{AIP_A33}}', '100', 'image/png', '64', '64'), 'proposal-images/{{AIP_A33}}', 'proposal-images/{{AIP_A31}}'),
  replace(pg_temp.image('{{AIP_A33}}', '100', 'image/png', '64', '64'), 'tenant/{{ORG_A}}/assets', 'tenant/{{ORG_B}}/assets'),
