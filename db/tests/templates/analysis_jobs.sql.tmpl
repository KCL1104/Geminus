-- T-030 (migration 0018; AI_SPEC §9, D-010, D-026; TEST-024): an analysis
-- starts generating with nothing generated, for the scoped user; its request
-- (runs, question, output locale) never changes, for any role; the API
-- changes nothing of an analysis; the analysis is completed only in the
-- transaction that completes its job and fails only once its job has failed
-- or been cancelled, with the job's error and nothing its attempt wrote; a
-- job completes only once its analysis is completed; an analysis has one
-- job; a completed or failed analysis never changes; each state holds what
-- it may; only the API, the worker and the schema owner write analyses.
-- Disposable dt_test_* database only (scripts/run_db_tests.sh). One
-- transaction, rolled back. Generated by scripts/render_db_tests.py.
\set ON_ERROR_STOP 1
BEGIN;
CREATE FUNCTION pg_temp.fail(msg text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF current_setting('dt.collect', true) = 'on' THEN RAISE WARNING 'FAILED: %', msg;
  ELSE RAISE EXCEPTION 'FAILED: %', msg; END IF;
END $$;
CREATE FUNCTION pg_temp.must_fail(stmt text, state text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE got text; msg text;
BEGIN
  BEGIN
    EXECUTE stmt;
    RAISE EXCEPTION USING ERRCODE = 'P0099'; -- roll the unexpected success back
  EXCEPTION WHEN OTHERS THEN
    got := SQLSTATE; msg := SQLERRM;
  END;
  IF got = 'P0099' THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but the statement succeeded: %s', state, stmt));
  ELSIF got <> state THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but got %s (%s) for: %s', state, got, msg, stmt));
  END IF;
END $$;
CREATE FUNCTION pg_temp.check(ok boolean, what text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF ok IS NOT TRUE THEN PERFORM pg_temp.fail(what); END IF;
END $$;
-- An UPDATE of one analysis of tenant A, as a statement for must_fail.
CREATE FUNCTION pg_temp.upd(ana text, change text) RETURNS text LANGUAGE sql AS $$
  SELECT format('UPDATE twin.ai_analyses SET %s WHERE organization_id=%L AND id=%L', change, '{{ORG_A}}', ana)
$$;
GRANT EXECUTE ON FUNCTION pg_temp.upd(text, text) TO PUBLIC;
-- An INSERT of a generating analysis of SIM_A2 against SIM_A1 that also sets
-- the columns cols (each after a comma) to vals.
CREATE FUNCTION pg_temp.ins(ana text, creator text, cols text, vals text) RETURNS text LANGUAGE sql AS $$
  SELECT format('INSERT INTO twin.ai_analyses(id,organization_id,run_id,baseline_run_id,status,created_by%s) VALUES (%L,%L,%L,%L,%L,%L%s)',
    cols, ana, '{{ORG_A}}', '{{SIM_A2}}', '{{SIM_A1}}', 'generating', creator, vals)
$$;
GRANT EXECUTE ON FUNCTION pg_temp.ins(text, text, text, text) TO PUBLIC;

SET LOCAL ROLE twin_owner;
SELECT set_config('app.oidc_issuer','https://test.invalid',true), set_config('app.oidc_subject','subject_a',true),
       set_config('app.organization_id','{{ORG_A}}',true), set_config('app.user_id','{{USR_A}}',true);
INSERT INTO twin.users(id,oidc_issuer,oidc_subject) VALUES ('{{USR_A}}','https://test.invalid','subject_a');
SELECT set_config('app.oidc_subject','subject_a2',true);
INSERT INTO twin.users(id,oidc_issuer,oidc_subject) VALUES ('{{USR_A2}}','https://test.invalid','subject_a2');
SELECT set_config('app.oidc_subject','subject_a',true);
INSERT INTO twin.organizations(id,organization_id,name) VALUES ('{{ORG_A}}','{{ORG_A}}','Tenant A');
INSERT INTO twin.memberships(organization_id,user_id,role) VALUES ('{{ORG_A}}','{{USR_A}}','owner'),('{{ORG_A}}','{{USR_A2}}','editor');
INSERT INTO twin.projects(id,organization_id,name,created_by) VALUES ('{{PRJ_A}}','{{ORG_A}}','Project A','{{USR_A}}');
INSERT INTO twin.models(id,organization_id,project_id,name,domain,created_by)
  VALUES ('{{MDL_A}}','{{ORG_A}}','{{PRJ_A}}','Model A','software_delivery','{{USR_A}}');
INSERT INTO twin.model_versions(id,organization_id,model_id,version,schema_version,ir,hash,created_by)
  VALUES ('{{MV_A1}}','{{ORG_A}}','{{MDL_A}}',1,'0.1','{{IR_A1}}','{{IR_A1_HASH}}','{{USR_A}}');
SET CONSTRAINTS ALL IMMEDIATE; -- the version's deferred manifest check passes
SET CONSTRAINTS ALL DEFERRED;
INSERT INTO twin.simulation_runs(id,organization_id,model_id,model_version_id,name,scenario_patch,config,seed,replications,
    engine_version,model_hash,effective_model_hash,config_hash,dataset_manifest_hash,dataset_bindings,execution_limits,created_by,status)
  SELECT r, '{{ORG_A}}', '{{MDL_A}}', '{{MV_A1}}', 'run', '[]', '{}', 7, 2, 'des-go-0.1.0', '{{IR_A1_HASH}}', '{{IR_A1_HASH}}', '{{H1}}',
    '{{EMPTY_MANIFEST_HASH}}', '[]', '{"max_events":1000}', '{{USR_A}}', 'queued' FROM unnest(ARRAY['{{SIM_A1}}','{{SIM_A2}}']) AS r;

-- The API creates an analysis for the scoped user, generating, with its
-- request and nothing generated.
SET LOCAL ROLE twin_api;
SELECT pg_temp.ins('{{ANA_A1}}', '{{USR_A}}', ',question,output_locale', $v$,'Why is ICT the bottleneck?','zh-Hant'$v$) \gexec
SELECT pg_temp.ins(a, '{{USR_A}}', '', '')
  FROM unnest(ARRAY['{{ANA_A2}}','{{ANA_A3}}','{{ANA_A4}}','{{ANA_A5}}','{{ANA_A6}}']) AS a \gexec
SELECT pg_temp.check(output_locale = 'zh-Hant' AND question = 'Why is ICT the bottleneck?', 'the request is stored')
  FROM twin.ai_analyses WHERE organization_id='{{ORG_A}}' AND id='{{ANA_A1}}';
SELECT pg_temp.check(output_locale = 'en' AND question IS NULL AND provider_metadata = '{}', 'the request defaults: en, no question')
  FROM twin.ai_analyses WHERE organization_id='{{ORG_A}}' AND id='{{ANA_A2}}';
-- Nothing generated at the start, whatever is offered; for the scoped user only.
SELECT pg_temp.must_fail(pg_temp.ins('{{ANA_A7}}', '{{USR_A}}', c, v), '55000') FROM (VALUES
  (',analysis', $v$,'{"scenario":{"summary":"s"}}'$v$),
  (',provider_metadata', $v$,'{"provider":"api"}'$v$),
  (',error', $v$,'{"code":"X","message":"x","retryable":false}'$v$)) AS t(c, v);
SELECT pg_temp.must_fail(format('INSERT INTO twin.ai_analyses(id,organization_id,run_id,status,created_by) VALUES (%L,%L,%L,%L,%L)',
  '{{ANA_A7}}', '{{ORG_A}}', '{{SIM_A2}}', 'completed', '{{USR_A}}'), '55000');
SELECT pg_temp.must_fail(pg_temp.ins('{{ANA_A7}}', '{{USR_A2}}', '', ''), '42501');
-- A baseline is another run; the output locale and question are bounded.
SELECT pg_temp.must_fail(format('INSERT INTO twin.ai_analyses(id,organization_id,run_id,baseline_run_id,status,created_by) VALUES (%L,%L,%L,%L,%L,%L)',
  '{{ANA_A7}}', '{{ORG_A}}', '{{SIM_A2}}', '{{SIM_A2}}', 'generating', '{{USR_A}}'), '23514');
SELECT pg_temp.must_fail(pg_temp.ins('{{ANA_A7}}', '{{USR_A}}', c, v), '23514') FROM (VALUES
  (',output_locale', $v$,'fr'$v$), (',question', $v$,''$v$), (',question', format(',%L', repeat('x', 10001)))) AS t(c, v);
-- The API changes nothing of an analysis (it has no UPDATE at all).
SELECT pg_temp.must_fail(pg_temp.upd('{{ANA_A1}}', $q$question='rewritten'$q$), '42501');

-- Each analysis has one job; a second one is refused.
INSERT INTO twin.jobs(id,organization_id,type,status,payload,ai_analysis_id)
  SELECT j, '{{ORG_A}}', 'analysis', 'queued', '{}', a FROM (VALUES
    ('{{JOB_A71}}','{{ANA_A1}}'),('{{JOB_A72}}','{{ANA_A2}}'),('{{JOB_A73}}','{{ANA_A3}}'),('{{JOB_A74}}','{{ANA_A4}}'),
    ('{{JOB_A75}}','{{ANA_A5}}'),('{{JOB_A76}}','{{ANA_A6}}')) AS t(j, a);
SELECT pg_temp.must_fail($q$INSERT INTO twin.jobs(id,organization_id,type,status,payload,ai_analysis_id)
  VALUES ('{{JOB_A77}}','{{ORG_A}}','analysis','queued','{}','{{ANA_A1}}')$q$, '23505');

-- Its request never changes, for any role; neither the worker nor the
-- owner fails an analysis by hand: only its job.
SET LOCAL ROLE twin_owner;
SELECT pg_temp.must_fail(pg_temp.upd('{{ANA_A1}}', s), '55000') FROM unnest(ARRAY[
  $q$question='rewritten'$q$, $q$output_locale='en'$q$, $q$baseline_run_id=NULL$q$, $q$created_at=now() - interval '1 day'$q$,
  $q$status='failed', error='{"code":"X","message":"x","retryable":false}'$q$
]) AS s;
SET LOCAL ROLE twin_worker;
SELECT pg_temp.must_fail(pg_temp.upd('{{ANA_A1}}', $q$status='failed', error='{"code":"X","message":"x","retryable":false}'$q$), '55000');

-- The worker claims the jobs of ANA_A1..A6.
UPDATE twin.jobs SET status='running', attempt=attempt+1, lease_token=lease_token+1, locked_at=now(), locked_by='w',
    lease_expires_at=now()+interval '30 seconds'
  WHERE organization_id='{{ORG_A}}' AND id IN ('{{JOB_A71}}','{{JOB_A72}}','{{JOB_A73}}','{{JOB_A75}}','{{JOB_A76}}');
-- What each state holds.
SELECT pg_temp.must_fail(pg_temp.upd('{{ANA_A6}}', s), '23514') FROM unnest(ARRAY[
  $q$status='completed'$q$,
  $q$status='completed', analysis='[]'$q$,
  $q$status='completed', analysis='{"scenario":{"summary":"s"}}', error='{"code":"X","message":"x","retryable":false}'$q$,
  $q$analysis='{"scenario":{"summary":"s"}}'$q$,
  $q$error='{"code":"X","message":"x","retryable":false}'$q$,
  $q$provider_metadata='[]'$q$
]) AS s;

-- An analysis is completed with its job's completion, in one transaction.
UPDATE twin.ai_analyses SET status='completed', analysis='{"scenario":{"summary":"s"}}', provider_metadata='{"provider":"fake","role":"analyst"}'
  WHERE organization_id='{{ORG_A}}' AND id='{{ANA_A1}}';
UPDATE twin.jobs SET status='completed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A71}}';
SET CONSTRAINTS ALL IMMEDIATE;
SET CONSTRAINTS ALL DEFERRED;
SELECT pg_temp.check(status = 'completed', 'completed with its job') FROM twin.ai_analyses WHERE organization_id='{{ORG_A}}' AND id='{{ANA_A1}}';
-- ...and only then: completed while the job still runs, it is refused at commit.
DO $$
BEGIN
  UPDATE twin.ai_analyses SET status='completed', analysis='{"scenario":{"summary":"s"}}'
    WHERE organization_id='{{ORG_A}}' AND id='{{ANA_A2}}';
  SET CONSTRAINTS ALL IMMEDIATE;
  RAISE EXCEPTION 'FAILED: an analysis was completed while its job still ran';
EXCEPTION WHEN SQLSTATE '55000' THEN NULL;
END $$;
SET CONSTRAINTS ALL DEFERRED;
SELECT pg_temp.check(status = 'generating', 'the refused analysis is still generating')
  FROM twin.ai_analyses WHERE organization_id='{{ORG_A}}' AND id='{{ANA_A2}}';
-- A job completes only once its analysis is completed.
SELECT pg_temp.must_fail($q$UPDATE twin.jobs SET status='completed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A76}}'$q$, '55000');
-- A completed analysis never changes, for any role.
SELECT pg_temp.must_fail(pg_temp.upd('{{ANA_A1}}', $q$analysis='{"scenario":{"summary":"rewritten"}}'$q$), '55000');
SET LOCAL ROLE twin_owner;
SELECT pg_temp.must_fail(pg_temp.upd('{{ANA_A1}}', s), '55000') FROM unnest(ARRAY[
  $q$analysis='{"scenario":{"summary":"rewritten"}}'$q$, $q$status='generating', analysis=NULL$q$
]) AS s;

-- The analysis follows its job. A retry leaves it generating; the job
-- failing for good fails it, with the job's error, in the same statement.
SET LOCAL ROLE twin_worker;
UPDATE twin.jobs SET status='queued', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL,
    error='{"code":"AI_TIMEOUT","message":"the AI provider did not answer in time","retryable":true}'
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A73}}';
SELECT pg_temp.check(status = 'generating' AND error IS NULL, 'a retried job moved its analysis: ' || status)
  FROM twin.ai_analyses WHERE organization_id='{{ORG_A}}' AND id='{{ANA_A3}}';
UPDATE twin.jobs SET status='running', attempt=attempt+1, lease_token=lease_token+1, locked_at=now(), locked_by='w',
    lease_expires_at=now()+interval '30 seconds'
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A73}}';
UPDATE twin.jobs SET status='failed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL,
    error='{"code":"ANALYSIS_UNGROUNDED","message":"the AI answer cites what the results do not hold","retryable":false}'
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A73}}';
SELECT pg_temp.check(status = 'failed' AND error->>'code' = 'ANALYSIS_UNGROUNDED' AND analysis IS NULL,
    'the analysis did not follow its failed job: ' || status)
  FROM twin.ai_analyses WHERE organization_id='{{ORG_A}}' AND id='{{ANA_A3}}';
-- The API has no route that ends an analysis job and no UPDATE on analyses,
-- so it cannot end one; an operator cancelling a queued job: JOB_CANCELLED.
SET LOCAL ROLE twin_api;
SELECT pg_temp.must_fail($q$UPDATE twin.jobs SET status='cancelled' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A74}}'$q$, '42501');
SET LOCAL ROLE twin_owner;
UPDATE twin.jobs SET status='cancelled' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A74}}';
SELECT pg_temp.check(status = 'failed' AND error->>'code' = 'JOB_CANCELLED', 'the analysis did not follow its cancelled job: ' || status)
  FROM twin.ai_analyses WHERE organization_id='{{ORG_A}}' AND id='{{ANA_A4}}';
-- An operator ending a running job without an error: INTERNAL, and what the
-- attempt wrote (its provider metadata) is cleared.
SET LOCAL ROLE twin_worker;
UPDATE twin.ai_analyses SET provider_metadata='{"provider":"fake"}' WHERE organization_id='{{ORG_A}}' AND id='{{ANA_A5}}';
SET LOCAL ROLE twin_owner;
UPDATE twin.jobs SET status='failed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A75}}';
SELECT pg_temp.check(status = 'failed' AND error->>'code' = 'INTERNAL' AND provider_metadata = '{}',
    'the analysis did not follow its job ended by hand: ' || status)
  FROM twin.ai_analyses WHERE organization_id='{{ORG_A}}' AND id='{{ANA_A5}}';
-- Failed is final, for every role.
SELECT pg_temp.must_fail(pg_temp.upd('{{ANA_A3}}', s), '55000') FROM unnest(ARRAY[
  $q$status='generating', error=NULL$q$,
  $q$error='{"code":"OTHER","message":"x","retryable":false}'$q$
]) AS s;
-- Any other role is refused whatever privileges it is given.
RESET ROLE;
GRANT SELECT, UPDATE ON twin.ai_analyses TO twin_provisioner;
SET LOCAL ROLE twin_provisioner;
SELECT pg_temp.must_fail(pg_temp.upd('{{ANA_A6}}', $q$provider_metadata='{"x":1}'$q$), '55000');
RESET ROLE;
REVOKE SELECT, UPDATE ON twin.ai_analyses FROM twin_provisioner;
ROLLBACK;
