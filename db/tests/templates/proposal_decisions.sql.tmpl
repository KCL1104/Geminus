-- T-026 (migration 0013; AI_SPEC §6, D-003, D-004, D-030; D-068, D-069
-- APPROVED; TEST-006, TEST-007): a decision keeps the person's comment,
-- only on an approved or rejected proposal, written by the decision; the
-- worker cannot write the column (no UPDATE privilege; it reads it as it
-- reads every column); a conflicted proposal names who found the
-- conflict; a version or scenario that names a source proposal is that
-- approved proposal's one effect when the transaction commits (a version:
-- the next one after the proposal's base, so an approval on a base that is
-- no longer the latest cannot commit; a scenario: the proposal's base,
-- patch and hash), for the API and the schema owner alike.
-- Disposable dt_test_* database only (scripts/run_db_tests.sh). One
-- transaction, rolled back. Generated by scripts/render_db_tests.py.
\set ON_ERROR_STOP 1
BEGIN;
CREATE FUNCTION pg_temp.fail(msg text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF current_setting('dt.collect', true) = 'on' THEN RAISE WARNING 'FAILED: %', msg;
  ELSE RAISE EXCEPTION 'FAILED: %', msg; END IF;
END $$;
CREATE FUNCTION pg_temp.must_fail(stmt text, state text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE got text; msg text;
BEGIN
  BEGIN
    EXECUTE stmt;
    RAISE EXCEPTION USING ERRCODE = 'P0099'; -- roll the unexpected success back
  EXCEPTION WHEN OTHERS THEN
    got := SQLSTATE; msg := SQLERRM;
  END;
  IF got = 'P0099' THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but the statement succeeded: %s', state, stmt));
  ELSIF got <> state THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but got %s (%s) for: %s', state, got, msg, stmt));
  END IF;
END $$;
-- The statements run one after the other and the deferred checks run as
-- at commit; all of it is rolled back, and the outcome must be state.
CREATE FUNCTION pg_temp.must_fail_at_commit(stmts text[], state text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE got text; msg text; s text;
BEGIN
  BEGIN
    FOREACH s IN ARRAY stmts LOOP
      EXECUTE s;
    END LOOP;
    SET CONSTRAINTS ALL IMMEDIATE;
    RAISE EXCEPTION USING ERRCODE = 'P0099'; -- roll the unexpected success back
  EXCEPTION WHEN OTHERS THEN
    got := SQLSTATE; msg := SQLERRM;
  END;
  SET CONSTRAINTS ALL DEFERRED;
  IF got = 'P0099' THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s at commit but it committed: %s', state, array_to_string(stmts, '; ')));
  ELSIF got <> state THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s at commit but got %s (%s) for: %s', state, got, msg, array_to_string(stmts, '; ')));
  END IF;
END $$;
CREATE FUNCTION pg_temp.check(ok boolean, what text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF ok IS NOT TRUE THEN PERFORM pg_temp.fail(what); END IF;
END $$;
GRANT EXECUTE ON FUNCTION pg_temp.must_fail_at_commit(text[], text) TO PUBLIC;
-- An UPDATE of one proposal of tenant A.
CREATE FUNCTION pg_temp.upd(aip text, change text) RETURNS text LANGUAGE sql AS $$
  SELECT format('UPDATE twin.ai_proposals SET %s WHERE organization_id=%L AND id=%L', change, '{{ORG_A}}', aip)
$$;
GRANT EXECUTE ON FUNCTION pg_temp.upd(text, text) TO PUBLIC;
-- The INSERT of a version of model A (the IR of version 2; the database
-- checks only that the hash is the text's).
CREATE FUNCTION pg_temp.version(id text, num int, parent text, source text) RETURNS text LANGUAGE sql AS $$
  SELECT format('INSERT INTO twin.model_versions(id,organization_id,model_id,version,schema_version,parent_version_id,ir,hash,source_proposal_id,created_by) '
      'VALUES (%L,%L,%L,%s,%L,%L,%L,%L,%L,%L)',
    id, '{{ORG_A}}', '{{MDL_A}}', num, '0.1', parent, '{{IR_A2}}', '{{IR_A2_HASH}}', source, '{{USR_A}}')
$$;
GRANT EXECUTE ON FUNCTION pg_temp.version(text, int, text, text) TO PUBLIC;
-- The INSERT of a scenario of model A on version 1.
CREATE FUNCTION pg_temp.scenario(id text, patch text, hash text, source text) RETURNS text LANGUAGE sql AS $$
  SELECT format('INSERT INTO twin.scenarios(id,organization_id,model_id,base_version_id,name,patch,patch_hash,source_proposal_id,created_by) '
      'VALUES (%L,%L,%L,%L,%L,%L,%L,%L,%L)',
    id, '{{ORG_A}}', '{{MDL_A}}', '{{MV_A1}}', 'What if', patch, hash, source, '{{USR_A}}')
$$;
GRANT EXECUTE ON FUNCTION pg_temp.scenario(text, text, text, text) TO PUBLIC;

