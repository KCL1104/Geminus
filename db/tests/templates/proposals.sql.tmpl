SELECT pg_temp.check(NOT has_function_privilege('public','twin.id_pool_ok(jsonb)','EXECUTE'),
  'PUBLIC cannot call the pool check');

-- The API creates a proposal with its pool; no pool, or a pool of the
-- wrong shape, is refused.
SET LOCAL ROLE twin_api;
SELECT pg_temp.insert_sql('{{AIP_A1}}', $p$'{{POOL_1}}'$p$) \gexec
SELECT pg_temp.must_fail(pg_temp.insert_sql('{{AIP_A2}}', 'NULL'), '23502');
SELECT pg_temp.must_fail(pg_temp.insert_sql('{{AIP_A2}}', format('%L::jsonb', pool)), '23514') FROM (VALUES
  ('[]'), ('"pool"'), ('{}'),
  -- a kind missing, an extra kind
  ('{{POOL_1}}'::jsonb - 'flow'),
  (jsonb_set('{{POOL_1}}'::jsonb, '{entity_type}', '{{POOL_1}}'::jsonb->'node')),
  -- 15 or 17 IDs of a kind; not an array
  (jsonb_set('{{POOL_1}}'::jsonb, '{flow}', ('{{POOL_1}}'::jsonb->'flow') - 0)),
  (jsonb_set('{{POOL_1}}'::jsonb, '{flow}', ('{{POOL_1}}'::jsonb->'flow') || '["flow_01m4ydqk00ta99999999999999"]')),
  (jsonb_set('{{POOL_1}}'::jsonb, '{node}', '{"0":"node_01m4ydqk00ta00000000000001"}')),
  -- an ID that is not a string, of another kind, uppercase, too short or long, outside the ULID range
  (jsonb_set('{{POOL_1}}'::jsonb, '{node,0}', '1')),
  (jsonb_set('{{POOL_1}}'::jsonb, '{node,0}', '"flow_01m4ydqk00ta99999999999999"')),
  (jsonb_set('{{POOL_1}}'::jsonb, '{resource,3}', '"node_01m4ydqk00ta99999999999999"')),
  (jsonb_set('{{POOL_1}}'::jsonb, '{node,0}', '"NODE_01M4YDQK00TA99999999999999"')),
  (jsonb_set('{{POOL_1}}'::jsonb, '{node,0}', '"node_01M4YDQK00TA99999999999999"')),
  (jsonb_set('{{POOL_1}}'::jsonb, '{node,0}', '"node_01m4ydqk00ta9999999999999"')),
  (jsonb_set('{{POOL_1}}'::jsonb, '{node,0}', '"node_01m4ydqk00ta999999999999999"')),
  (jsonb_set('{{POOL_1}}'::jsonb, '{node,0}', '"node_81m4ydqk00ta99999999999999"')),
  (jsonb_set('{{POOL_1}}'::jsonb, '{node,0}', '"node_01m4ydqk00tu99999999999999"')),
  (jsonb_set('{{POOL_1}}'::jsonb, '{node,0}', '" node_01m4ydqk00ta9999999999999"')),
  -- the same ID twice in a kind
  (jsonb_set('{{POOL_1}}'::jsonb, '{node,5}', ('{{POOL_1}}'::jsonb->'node'->4)))
) AS t(pool);

-- The pool never changes: not for the API, not with the rest of the
-- generated content, not after the decision, not for the owner; the
-- worker cannot even name the column.
SELECT pg_temp.must_fail(s, '55000') FROM unnest(ARRAY[
  $q$UPDATE twin.ai_proposals SET id_pool='{{POOL_2}}' WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}'$q$,
  $q$UPDATE twin.ai_proposals SET id_pool=jsonb_set(id_pool, '{node,0}', '"node_01m4ydqk00ta99999999999999"') WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}'$q$
]) AS s;
UPDATE twin.ai_proposals SET id_pool=id_pool WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}'; -- the same value is no change
SET LOCAL ROLE twin_worker;
SELECT pg_temp.must_fail($q$UPDATE twin.ai_proposals SET id_pool='{{POOL_2}}' WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}'$q$, '42501');
SELECT pg_temp.must_fail($q$UPDATE twin.ai_proposals SET status='needs_input', questions='["which tester?"]', id_pool='{{POOL_2}}' WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}'$q$, '42501');
UPDATE twin.ai_proposals SET status='needs_input', questions='["which tester?"]', summary='needs input'
  WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}';
SET LOCAL ROLE twin_owner;
SELECT pg_temp.must_fail($q$UPDATE twin.ai_proposals SET id_pool='{{POOL_2}}' WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}'$q$, '55000');
UPDATE twin.ai_proposals SET status='rejected', decided_by='{{USR_A}}' WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}';
SELECT pg_temp.must_fail($q$UPDATE twin.ai_proposals SET id_pool='{{POOL_2}}' WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}'$q$, '55000');
SELECT pg_temp.check(id_pool = '{{POOL_1}}'::jsonb AND status = 'rejected', 'the proposal kept the pool it was created with')
  FROM twin.ai_proposals WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}';
-- A second proposal may get the same IDs: a pool belongs to one proposal
-- and is checked against that proposal's base, not across proposals.
SET LOCAL ROLE twin_api;
SELECT pg_temp.insert_sql('{{AIP_A3}}', $p$'{{POOL_1}}'$p$) \gexec
SELECT pg_temp.check(count(*) = 2, 'two proposals, each with its pool') FROM twin.ai_proposals WHERE organization_id='{{ORG_A}}';
RESET ROLE;
ROLLBACK;
