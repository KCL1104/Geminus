CREATE FUNCTION pg_temp.call(inv text, seq int, tool text, job text, token bigint, overrides jsonb DEFAULT '{}') RETURNS text LANGUAGE sql AS $$
  SELECT format('INSERT INTO twin.investigation_tool_calls SELECT * FROM jsonb_populate_record(NULL::twin.investigation_tool_calls, %L)',
    jsonb_build_object('organization_id', '{{ORG_A}}', 'investigation_id', inv, 'seq', seq, 'tool', tool,
      'arguments', CASE tool WHEN 'invalid_call' THEN NULL
        WHEN 'propose_what_if' THEN '{"idea":"Add a second tester at ICT","from_suggestion":null}'::jsonb
        WHEN 'propose_model_edit' THEN '{"idea":"Add a second tester at ICT"}'::jsonb
        WHEN 'finish' THEN '{"outcome":"no_improvement","best_scenario_id":null}'::jsonb
        ELSE '{"proposal_id":"{{AIP_A41}}"}'::jsonb END,
      'arguments_hash', CASE WHEN tool <> 'invalid_call' THEN '{{H2}}' END, 'note', 'Testing the bottleneck first.',
      'job_id', job, 'lease_token', token,
      'status', CASE tool WHEN 'invalid_call' THEN 'refused' WHEN 'finish' THEN 'done' ELSE 'pending' END,
      'error', CASE tool WHEN 'invalid_call' THEN '{"code":"UNKNOWN_TOOL","path":""}'::jsonb END,
      'requested_at', now()) || overrides)
$$;
