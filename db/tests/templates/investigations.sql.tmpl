-- ===================================================================
-- Who may do what (H-063): the worker reads both tables, appends calls,
-- records observations and ends its own investigation; the API starts and
-- stops investigations and carries out calls; nobody deletes either; RLS
-- is forced; the worker gains no grant on any existing table.
SELECT pg_temp.check(c.relrowsecurity AND c.relforcerowsecurity, c.relname || ' forces RLS')
  FROM pg_class c WHERE c.oid IN ('twin.investigations'::regclass, 'twin.investigation_tool_calls'::regclass);
SELECT pg_temp.check(has_column_privilege(r, 'twin.' || t, a.attname, 'UPDATE') = (a.attname = ANY (cols)),
    format('%s UPDATE on %s.%s', r, t, a.attname))
  FROM (VALUES
    ('twin_api', 'investigations', ARRAY['status', 'reason', 'finished_at', 'stop_requested_by']),
    ('twin_worker', 'investigations', ARRAY['status', 'reason', 'ai_outcome', 'finished_at']),
    ('twin_api', 'investigation_tool_calls', ARRAY['status', 'proposal_id', 'scenario_id', 'baseline_run_id', 'run_id', 'analysis_id',
      'draft_revision', 'error', 'resolved_at']),
    ('twin_worker', 'investigation_tool_calls', ARRAY['observation', 'observation_hash', 'observed_at'])) AS g(r, t, cols)
  JOIN pg_attribute a ON a.attrelid = ('twin.' || t)::regclass AND a.attnum > 0 AND NOT a.attisdropped;
SELECT pg_temp.check(has_table_privilege(r, 'twin.' || t, p) = ok, format('%s %s on %s', r, p, t)) FROM (VALUES
  ('twin_api', 'investigations', 'SELECT', true), ('twin_api', 'investigations', 'INSERT', true),
  ('twin_api', 'investigations', 'DELETE', false), ('twin_api', 'investigations', 'TRUNCATE', false),
  ('twin_worker', 'investigations', 'SELECT', true), ('twin_worker', 'investigations', 'INSERT', false),
  ('twin_worker', 'investigations', 'DELETE', false),
  ('twin_api', 'investigation_tool_calls', 'SELECT', true), ('twin_api', 'investigation_tool_calls', 'INSERT', false),
  ('twin_api', 'investigation_tool_calls', 'DELETE', false),
  ('twin_worker', 'investigation_tool_calls', 'SELECT', true), ('twin_worker', 'investigation_tool_calls', 'INSERT', true),
  ('twin_worker', 'investigation_tool_calls', 'DELETE', false),
  ('twin_provisioner', 'investigations', 'SELECT', false), ('twin_provisioner', 'investigation_tool_calls', 'SELECT', false),
  ('public', 'investigations', 'SELECT', false), ('public', 'investigation_tool_calls', 'SELECT', false)) AS g(r, t, p, ok);
-- The worker writes no label: its column grants on the labelled tables
-- did not change (0002).
SELECT pg_temp.check(NOT has_column_privilege('twin_worker', 'twin.' || t, c, 'UPDATE'), format('the worker cannot write %s.%s', t, c))
  FROM (VALUES ('ai_proposals', 'investigation_id'), ('ai_proposals', 'investigation_index'), ('ai_proposals', 'applied_draft_revision'),
    ('simulation_runs', 'investigation_id'), ('simulation_runs', 'investigation_slot'), ('ai_analyses', 'investigation_id'),
