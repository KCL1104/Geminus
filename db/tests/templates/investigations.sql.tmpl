-- ===================================================================
-- The 11th investigation of a UTC day is refused (the owner starts and
-- stops them; the count is under an advisory lock of the organization).
SET LOCAL ROLE twin_owner;
DO $$
DECLARE n integer; i integer := 0; got text;
BEGIN
  BEGIN
    LOOP
      SELECT count(*) INTO n FROM twin.investigations WHERE organization_id = '{{ORG_A}}'
        AND created_at >= (date_trunc('day', now() AT TIME ZONE 'UTC') AT TIME ZONE 'UTC');
      EXIT WHEN n >= 10;
      i := i + 1;
      EXECUTE pg_temp.inv(format('inv_01M4YDQK00TA%s', lpad((900 + i)::text, 14, '0')), '{{USR_A3}}', 'edit');
      EXECUTE pg_temp.upd_inv(format('inv_01M4YDQK00TA%s', lpad((900 + i)::text, 14, '0')),
        $q$status='stopped', reason='stopped_by_person', stop_requested_by='{{USR_A}}'$q$);
    END LOOP;
    BEGIN
      EXECUTE pg_temp.inv('inv_01M4YDQK00TA00000000000999', '{{USR_A3}}', 'edit');
      got := 'inserted';
    EXCEPTION WHEN check_violation THEN GET STACKED DIAGNOSTICS got = CONSTRAINT_NAME;
    END;
    RAISE EXCEPTION USING ERRCODE = 'P0098', MESSAGE = coalesce(got, '');
  EXCEPTION WHEN SQLSTATE 'P0098' THEN got := SQLERRM;
  END;
  IF got IS DISTINCT FROM 'investigations_daily_limit' THEN
    PERFORM pg_temp.fail(format('the 11th investigation of the day: %s', got));
  END IF;
END $$;

