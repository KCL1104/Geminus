CREATE FUNCTION pg_temp.inv(id text, creator text, mode text, overrides jsonb DEFAULT '{}') RETURNS text LANGUAGE sql AS $$
  SELECT format('INSERT INTO twin.investigations SELECT * FROM jsonb_populate_record(NULL::twin.investigations, %L)',
    jsonb_build_object('id', id, 'organization_id', '{{ORG_A}}', 'model_id', '{{MDL_A}}', 'base_version_id', '{{MV_A1}}', 'mode', mode,
      'source', 'request', 'intent', 'Cut the lead time', 'context', '{}'::jsonb, 'output_locale', 'en', 'research', false,
      'proposal_model', 'muse-spark-1.3', 'planner_model', 'muse-spark-1.3', 'prompt_template_version', 'investigator-0.1.0',
      'objective', CASE mode WHEN 'scenario' THEN '{"metric_path":"/metrics/lead_time_minutes/p50","better":"lower"}'::jsonb END,
      'run_config', CASE mode WHEN 'scenario' THEN pg_temp.run_config() END,
      'run_config_hash', CASE mode WHEN 'scenario' THEN '{{H1}}' END,
      'baseline_name', CASE mode WHEN 'scenario' THEN 'Baseline' END,
      'caps', CASE mode WHEN 'scenario' THEN '{"what_ifs":3,"runs":4,"explanations":4,"steps":14,"minutes":20}'::jsonb
        ELSE '{"what_ifs":1,"runs":0,"explanations":0,"steps":14,"minutes":20}'::jsonb END,
      'status', 'running', 'deadline_at', now() + interval '20 minutes', 'created_by', creator, 'created_at', now()) || overrides)
$$;
