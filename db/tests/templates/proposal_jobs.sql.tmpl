-- T-025 (migration 0012; AI_SPEC §4, D-002, D-011, D-027, D-046;
-- TEST-006, TEST-007): a proposal starts generating with nothing
-- generated, for the scoped user; its request never changes, for any role;
-- the API changes nothing of a generating proposal; the proposal is
-- generated only in the transaction that completes its job and fails only
-- with its job, with the job's error; a job completes only once its
-- proposal is generated; a proposal has one job; each state holds what it
-- may; only the API, the worker and the schema owner write proposals.
-- Disposable dt_test_* database only (scripts/run_db_tests.sh). One
-- transaction, rolled back. Generated by scripts/render_db_tests.py.
\set ON_ERROR_STOP 1
BEGIN;
CREATE FUNCTION pg_temp.fail(msg text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF current_setting('dt.collect', true) = 'on' THEN RAISE WARNING 'FAILED: %', msg;
  ELSE RAISE EXCEPTION 'FAILED: %', msg; END IF;
END $$;
CREATE FUNCTION pg_temp.must_fail(stmt text, state text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE got text; msg text;
BEGIN
  BEGIN
    EXECUTE stmt;
    RAISE EXCEPTION USING ERRCODE = 'P0099'; -- roll the unexpected success back
  EXCEPTION WHEN OTHERS THEN
    got := SQLSTATE; msg := SQLERRM;
  END;
  IF got = 'P0099' THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but the statement succeeded: %s', state, stmt));
  ELSIF got <> state THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but got %s (%s) for: %s', state, got, msg, stmt));
  END IF;
END $$;
CREATE FUNCTION pg_temp.check(ok boolean, what text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF ok IS NOT TRUE THEN PERFORM pg_temp.fail(what); END IF;
END $$;
-- An UPDATE of one proposal of tenant A, as a statement for must_fail.
CREATE FUNCTION pg_temp.upd(aip text, change text) RETURNS text LANGUAGE sql AS $$
  SELECT format('UPDATE twin.ai_proposals SET %s WHERE organization_id=%L AND id=%L', change, '{{ORG_A}}', aip)
$$;
GRANT EXECUTE ON FUNCTION pg_temp.upd(text, text) TO PUBLIC;
-- An INSERT of a generating edit proposal of tenant A that also sets the
-- columns cols (each after a comma) to vals.
CREATE FUNCTION pg_temp.ins(aip text, creator text, cols text, vals text) RETURNS text LANGUAGE sql AS $$
  SELECT format('INSERT INTO twin.ai_proposals(id,organization_id,model_id,base_version_id,mode,status,intent,created_by,id_pool%s) '
      'VALUES (%L,%L,%L,%L,%L,%L,%L,%L,%L%s)', cols,
    aip, '{{ORG_A}}', '{{MDL_A}}', '{{MV_A1}}', 'edit', 'generating', 'add a tester', creator, '{{POOL_1}}', vals)
$$;
GRANT EXECUTE ON FUNCTION pg_temp.ins(text, text, text, text) TO PUBLIC;

SET LOCAL ROLE twin_owner;
SELECT set_config('app.oidc_issuer','https://test.invalid',true), set_config('app.oidc_subject','subject_a',true),
       set_config('app.organization_id','{{ORG_A}}',true), set_config('app.user_id','{{USR_A}}',true);
INSERT INTO twin.users(id,oidc_issuer,oidc_subject) VALUES ('{{USR_A}}','https://test.invalid','subject_a');
SELECT set_config('app.oidc_subject','subject_a2',true);
INSERT INTO twin.users(id,oidc_issuer,oidc_subject) VALUES ('{{USR_A2}}','https://test.invalid','subject_a2');
SELECT set_config('app.oidc_subject','subject_a',true);
INSERT INTO twin.organizations(id,organization_id,name) VALUES ('{{ORG_A}}','{{ORG_A}}','Tenant A');
INSERT INTO twin.memberships(organization_id,user_id,role) VALUES ('{{ORG_A}}','{{USR_A}}','owner'),('{{ORG_A}}','{{USR_A2}}','editor');
INSERT INTO twin.projects(id,organization_id,name,created_by) VALUES ('{{PRJ_A}}','{{ORG_A}}','Project A','{{USR_A}}');
INSERT INTO twin.models(id,organization_id,project_id,name,domain,created_by)
  VALUES ('{{MDL_A}}','{{ORG_A}}','{{PRJ_A}}','Model A','software_delivery','{{USR_A}}');
INSERT INTO twin.model_versions(id,organization_id,model_id,version,schema_version,ir,hash,created_by)
  VALUES ('{{MV_A1}}','{{ORG_A}}','{{MDL_A}}',1,'0.1','{{IR_A1}}','{{IR_A1_HASH}}','{{USR_A}}');
SET CONSTRAINTS ALL IMMEDIATE; -- the version's deferred manifest check passes
SET CONSTRAINTS ALL DEFERRED;

-- The API creates a proposal for the scoped user, generating, with its
-- request and nothing generated.
SET LOCAL ROLE twin_api;
SELECT pg_temp.ins('{{AIP_A1}}', '{{USR_A}}', ',output_locale,selected_entity_ids', $v$,'zh-Hant','["work","worker"]'$v$) \gexec
SELECT pg_temp.ins(a, '{{USR_A}}', '', '')
  FROM unnest(ARRAY['{{AIP_A2}}','{{AIP_A3}}','{{AIP_A4}}','{{AIP_A5}}','{{AIP_A6}}','{{AIP_A7}}']) AS a \gexec
SELECT pg_temp.check(output_locale = 'zh-Hant' AND selected_entity_ids = '["work","worker"]', 'the request is stored')
  FROM twin.ai_proposals WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}';
SELECT pg_temp.check(output_locale = 'en' AND selected_entity_ids = '[]' AND provider_metadata = '{}', 'the request defaults: en, nothing selected')
  FROM twin.ai_proposals WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A2}}';
-- Nothing generated at the start, whatever is offered.
SELECT pg_temp.must_fail(pg_temp.ins('{{AIP_A10}}', '{{USR_A}}', c, v), '55000') FROM (VALUES
  (',summary', $v$,'a summary'$v$),
  (',assumptions', $v$,'["an assumption"]'$v$),
  (',patch', $v$,'[{"op":"replace","path":"/name","value":"x"}]'$v$),
  (',patch_hash', $v$,'{{H1}}'$v$),
  (',expected_effects', $v$,'["an effect"]'$v$),
  (',questions', $v$,'["a question?"]'$v$),
  (',candidate_dataset_bindings', $v$,'[{"logical_ref":"dataset:a"}]'$v$),
  (',provider_risk_claim', $v$,'low'$v$),
  (',server_risk_level,risk_level', $v$,'low','low'$v$),
  (',confidence', $v$,0.5$v$),
  (',validation', $v$,'{"valid":true,"issues":[]}'$v$),
  (',provider_metadata', $v$,'{"provider":"fake"}'$v$),
  (',error', $v$,'{"code":"X","message":"x","retryable":false}'$v$)
) AS t(c, v);
SELECT pg_temp.must_fail(format($q$INSERT INTO twin.ai_proposals(id,organization_id,model_id,base_version_id,mode,status,intent,created_by,id_pool,questions,summary)
    VALUES ('{{AIP_A10}}','{{ORG_A}}','{{MDL_A}}','{{MV_A1}}','edit',%L,'t','{{USR_A}}','{{POOL_1}}','["q?"]','s')$q$, s), '55000')
  FROM unnest(ARRAY['needs_input','ready','invalid','failed','approved','rejected','conflicted']) AS s;
-- For the scoped user only.
SELECT pg_temp.must_fail(pg_temp.ins('{{AIP_A10}}', '{{USR_A2}}', '', ''), '42501');
-- A request in the contract's shape only.
SELECT pg_temp.must_fail(pg_temp.ins('{{AIP_A10}}', '{{USR_A}}', c, v), '23514') FROM (VALUES
  (',output_locale', $v$,'zh-TW'$v$),
  (',output_locale', $v$,'EN'$v$),
  (',selected_entity_ids', $v$,'{"a":1}'$v$),
  (',selected_entity_ids', ',' || quote_literal((SELECT jsonb_agg('n' || i) FROM generate_series(1, 501) AS i)::text))
) AS t(c, v);

-- The request, ID, creator and creation time never change, for any role.
SELECT pg_temp.must_fail(pg_temp.upd('{{AIP_A1}}', s), '55000') FROM unnest(ARRAY[
  $q$output_locale='en'$q$,
  $q$selected_entity_ids='["work"]'$q$,
  $q$created_by='{{USR_A2}}'$q$,
  $q$created_at=created_at-interval '1 day'$q$,
  $q$intent='another intent'$q$
]) AS s;
SET LOCAL ROLE twin_owner;
SELECT pg_temp.must_fail(pg_temp.upd('{{AIP_A1}}', s), '55000') FROM unnest(ARRAY[
  $q$output_locale='en'$q$,
  $q$selected_entity_ids='[]'$q$,
  $q$created_by='{{USR_A2}}'$q$
]) AS s;
SET LOCAL ROLE twin_worker;
SELECT pg_temp.must_fail(pg_temp.upd('{{AIP_A1}}', s), '42501') FROM unnest(ARRAY[
  $q$output_locale='en'$q$,
  $q$selected_entity_ids='[]'$q$
]) AS s;

-- The API changes nothing of a generating proposal; its job does.
SET LOCAL ROLE twin_api;
SELECT pg_temp.must_fail(pg_temp.upd('{{AIP_A1}}', s), '55000') FROM unnest(ARRAY[
  $q$summary='written by the API'$q$,
  $q$provider_metadata='{"provider":"api"}'$q$,
  $q$status='needs_input', summary='s', questions='["q?"]'$q$,
  $q$status='failed', error='{"code":"X","message":"x","retryable":false}'$q$
]) AS s;
UPDATE twin.ai_proposals SET intent=intent WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}'; -- no change is no change
-- Each proposal has one job; a second one is refused.
INSERT INTO twin.jobs(id,organization_id,type,status,payload,ai_proposal_id)
  SELECT j, '{{ORG_A}}', 'model_proposal', 'queued', '{}', a FROM (VALUES
    ('{{JOB_A31}}','{{AIP_A1}}'),('{{JOB_A32}}','{{AIP_A2}}'),('{{JOB_A33}}','{{AIP_A3}}'),('{{JOB_A34}}','{{AIP_A4}}'),
    ('{{JOB_A35}}','{{AIP_A5}}'),('{{JOB_A36}}','{{AIP_A6}}'),('{{JOB_A37}}','{{AIP_A7}}')) AS t(j, a);
SELECT pg_temp.must_fail($q$INSERT INTO twin.jobs(id,organization_id,type,status,payload,ai_proposal_id)
  VALUES ('{{JOB_A38}}','{{ORG_A}}','model_proposal','queued','{}','{{AIP_A1}}')$q$, '23505');

-- Neither the worker nor the owner fails a proposal by hand: only its job.
SET LOCAL ROLE twin_worker;
SELECT pg_temp.must_fail(pg_temp.upd('{{AIP_A1}}', $q$status='failed', error='{"code":"X","message":"x","retryable":false}'$q$), '55000');
SET LOCAL ROLE twin_owner;
SELECT pg_temp.must_fail(pg_temp.upd('{{AIP_A1}}', $q$status='failed', error='{"code":"X","message":"x","retryable":false}'$q$), '55000');

-- The worker claims the jobs of AIP_A1..A7.
SET LOCAL ROLE twin_worker;
UPDATE twin.jobs SET status='running', attempt=attempt+1, lease_token=lease_token+1, locked_at=now(), locked_by='w',
    lease_expires_at=now()+interval '30 seconds'
  WHERE organization_id='{{ORG_A}}' AND id IN ('{{JOB_A31}}','{{JOB_A32}}','{{JOB_A33}}','{{JOB_A35}}','{{JOB_A36}}','{{JOB_A37}}');

-- What each state holds (the worker fills AIP_A6).
SELECT pg_temp.must_fail(pg_temp.upd('{{AIP_A6}}', s), '23514') FROM unnest(ARRAY[
  $q$status='needs_input', summary='s'$q$,
  $q$status='needs_input', questions='["q?"]'$q$,
  $q$status='needs_input', summary='s', questions='["q?"]', patch='[{"op":"replace","path":"/name","value":"x"}]'$q$,
  $q$status='invalid'$q$,
  $q$status='invalid', validation='{"valid":true,"issues":[]}'$q$,
  $q$status='invalid', validation='{"valid":false,"issues":[]}', summary='kept'$q$,
  $q$status='invalid', validation='{"valid":false,"issues":[]}', patch='[{"op":"replace","path":"/name","value":"x"}]'$q$,
  $q$error='{"code":"X","message":"x","retryable":false}'$q$,
  $q$provider_metadata='[]'$q$
]) AS s;

-- A proposal is generated with its job's completion, in one transaction.
UPDATE twin.ai_proposals SET status='needs_input', summary='which tester?', questions='["Which tester?"]',
    provider_metadata='{"provider":"fake","role":"modeler"}'
  WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A1}}';
UPDATE twin.jobs SET status='completed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A31}}';
UPDATE twin.ai_proposals SET status='invalid',
    validation='{"valid":false,"issues":[{"code":"ID_POOL_VIOLATION","path":"/nodes/3/id","message":"m","severity":"error"}]}'
  WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A6}}';
UPDATE twin.jobs SET status='completed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A36}}';
SET CONSTRAINTS ALL IMMEDIATE; -- both were generated with their jobs
SET CONSTRAINTS ALL DEFERRED;
SELECT pg_temp.check(string_agg(status, ',' ORDER BY id) = 'needs_input,invalid', 'generated with their jobs')
  FROM twin.ai_proposals WHERE organization_id='{{ORG_A}}' AND id IN ('{{AIP_A1}}','{{AIP_A6}}');
-- ...and only then: generated while the job still runs, it is refused at
-- commit.
DO $$
BEGIN
  UPDATE twin.ai_proposals SET status='needs_input', summary='s', questions='["q?"]'
    WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A2}}';
  SET CONSTRAINTS ALL IMMEDIATE;
  RAISE EXCEPTION 'FAILED: a proposal was generated while its job still ran';
EXCEPTION WHEN SQLSTATE '55000' THEN NULL;
END $$;
SET CONSTRAINTS ALL DEFERRED;
SELECT pg_temp.check(status = 'generating', 'the refused proposal is still generating')
  FROM twin.ai_proposals WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A2}}';
-- A job completes only once its proposal is generated.
SELECT pg_temp.must_fail($q$UPDATE twin.jobs SET status='completed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A37}}'$q$, '55000');
-- A generated proposal is the reviewer's: the worker touches it no more.
SELECT pg_temp.must_fail(pg_temp.upd('{{AIP_A1}}', $q$summary='rewritten'$q$), '42501');

-- The proposal follows its job. A retry leaves it generating; the job
-- failing for good fails it, with the job's error, in the same statement.
UPDATE twin.jobs SET status='queued', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL,
    error='{"code":"AI_TIMEOUT","message":"the AI provider did not answer in time","retryable":true}'
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A33}}';
SELECT pg_temp.check(status = 'generating' AND error IS NULL, 'a retried job moved its proposal: ' || status)
  FROM twin.ai_proposals WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A3}}';
UPDATE twin.jobs SET status='running', attempt=attempt+1, lease_token=lease_token+1, locked_at=now(), locked_by='w',
    lease_expires_at=now()+interval '30 seconds'
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A33}}';
UPDATE twin.jobs SET status='failed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL,
    error='{"code":"AI_TIMEOUT","message":"the AI provider did not answer in time","retryable":true}'
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A33}}';
SELECT pg_temp.check(status = 'failed' AND error = '{"code":"AI_TIMEOUT","message":"the AI provider did not answer in time","retryable":true}'::jsonb,
    'the proposal did not follow its failed job: ' || status)
  FROM twin.ai_proposals WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A3}}';
-- The API cancelling a queued job (an operator's doing; the API has no
-- route for it): JOB_CANCELLED, although the API itself never moves a
-- generating proposal.
SET LOCAL ROLE twin_api;
UPDATE twin.jobs SET status='cancelled' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A34}}';
SELECT pg_temp.check(status = 'failed' AND error->>'code' = 'JOB_CANCELLED' AND error->>'retryable' = 'false',
    'the proposal did not follow its cancelled job: ' || status)
  FROM twin.ai_proposals WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A4}}';
-- An operator ending a running job without an error: INTERNAL.
SET LOCAL ROLE twin_owner;
UPDATE twin.jobs SET status='failed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A35}}';
SELECT pg_temp.check(status = 'failed' AND error->>'code' = 'INTERNAL', 'the proposal did not follow its job ended by hand: ' || status)
  FROM twin.ai_proposals WHERE organization_id='{{ORG_A}}' AND id='{{AIP_A5}}';
-- Failed is final, for every role.
SELECT pg_temp.must_fail(pg_temp.upd('{{AIP_A3}}', s), '55000') FROM unnest(ARRAY[
  $q$status='generating', error=NULL$q$,
  $q$error='{"code":"OTHER","message":"x","retryable":false}'$q$
]) AS s;
-- Any other role is refused whatever privileges it is given.
RESET ROLE;
GRANT SELECT, UPDATE ON twin.ai_proposals TO twin_provisioner;
SET LOCAL ROLE twin_provisioner;
SELECT pg_temp.must_fail(pg_temp.upd('{{AIP_A7}}', $q$summary='x'$q$), '55000');
RESET ROLE;
REVOKE SELECT, UPDATE ON twin.ai_proposals FROM twin_provisioner;
ROLLBACK;
