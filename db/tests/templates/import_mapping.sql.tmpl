-- doing; the API's own saves cancel only older ones): FAILED with
-- JOB_CANCELLED. An operator ending a running one without an error:
-- INTERNAL.
SELECT pg_temp.save('{{IMP_A13}}', 1) \gexec
SELECT pg_temp.job('{{JOB_A63}}', '{{IMP_A13}}', 1) \gexec
UPDATE twin.jobs SET status='cancelled' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A63}}';
SELECT pg_temp.check(status = 'FAILED' AND error->>'code' = 'JOB_CANCELLED' AND error->>'retryable' = 'false', 'cancelled: ' || status)
  FROM twin.imports WHERE organization_id='{{ORG_A}}' AND id='{{IMP_A13}}';
SELECT pg_temp.save('{{IMP_A16}}', 1) \gexec
SELECT pg_temp.job('{{JOB_A64}}', '{{IMP_A16}}', 1) \gexec
SET CONSTRAINTS ALL IMMEDIATE;
SET CONSTRAINTS ALL DEFERRED;

-- Following a job is the job's state, not the trigger depth (T-016
-- re-review; as T-025 review I1 for 0012): a write from a trigger of
-- another table that fails an import whose job has not ended is refused,
-- for an UPLOADED import and for a VALIDATING one alike.
SET LOCAL ROLE twin_owner;
CREATE FUNCTION twin.dt_fail_imports() RETURNS trigger LANGUAGE plpgsql AS $f$
BEGIN
  UPDATE twin.imports SET status='FAILED', error='{"code":"X","message":"x","retryable":false}'
    WHERE organization_id='{{ORG_A}}' AND id = current_setting('dt.fail_import');
  RETURN NULL;
END $f$;
CREATE TRIGGER dt_fail_imports AFTER UPDATE ON twin.projects FOR EACH ROW EXECUTE FUNCTION twin.dt_fail_imports();
SET LOCAL ROLE twin_api;
SELECT set_config('dt.fail_import', '{{IMP_A14}}', true);
SELECT pg_temp.must_fail($q$UPDATE twin.projects SET name='Project A, renamed' WHERE organization_id='{{ORG_A}}' AND id='{{PRJ_A}}'$q$, '55000');
SELECT set_config('dt.fail_import', '{{IMP_A16}}', true);
SELECT pg_temp.must_fail($q$UPDATE twin.projects SET name='Project A, renamed' WHERE organization_id='{{ORG_A}}' AND id='{{PRJ_A}}'$q$, '55000');
SET LOCAL ROLE twin_owner;
DROP TRIGGER dt_fail_imports ON twin.projects;
DROP FUNCTION twin.dt_fail_imports();
SELECT pg_temp.check(string_agg(status, ',' ORDER BY id) = 'UPLOADED,VALIDATING', 'a trigger failed an import whose job has not ended')
  FROM twin.imports WHERE organization_id='{{ORG_A}}' AND id IN ('{{IMP_A14}}','{{IMP_A16}}');
SET LOCAL ROLE twin_worker;
SELECT pg_temp.claim('{{JOB_A64}}') \gexec
SET LOCAL ROLE twin_owner;
UPDATE twin.jobs SET status='failed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A64}}';
SELECT pg_temp.check(status = 'FAILED' AND error->>'code' = 'INTERNAL', 'ended by hand: ' || status)
  FROM twin.imports WHERE organization_id='{{ORG_A}}' AND id='{{IMP_A16}}';

-- The checks hold by themselves, with every trigger off. (No trigger
-- event may be pending on the table when it is altered.)
SET CONSTRAINTS ALL IMMEDIATE;
SET CONSTRAINTS ALL DEFERRED;
ALTER TABLE twin.imports DISABLE TRIGGER USER;
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A15}}', s), '23514') FROM unnest(ARRAY[
  $q$status='MAPPING'$q$,
  $q$mapping='{"mappings":[]}'$q$,                                        -- a mapping without a revision
  $q$mapping_revision=1$q$,                                               -- a revision without a mapping
  $q$mapping='{"mappings":[]}', mapping_revision=1, status='VALIDATING', invalid_rows=0, error_report_object_key=NULL, error_report_content_hash=NULL, error_report_size_bytes=NULL, validation='{"valid":true,"issues":[]}'$q$,
  $q$mapping='{"mappings":[]}', mapping_revision=1, status='VALIDATING', error_report_object_key=NULL, error_report_content_hash=NULL, error_report_size_bytes=NULL$q$,
  $q$mapping='{"mappings":[]}', mapping_revision=1, status='VALIDATING', invalid_rows=0$q$,
  $q$mapping='{"mappings":[]}', mapping_revision=1, status='VALIDATING', invalid_rows=0, error_report_object_key=NULL, error_report_content_hash=NULL, error_report_size_bytes=NULL, canonical_preview='[null]'$q$,
  $q$mapping='{"mappings":[]}', mapping_revision=1, status='VALIDATED', invalid_rows=0, error_report_object_key=NULL, error_report_content_hash=NULL, error_report_size_bytes=NULL, validation='{"valid":true,"issues":[]}'$q$,
  $q$mapping='{"mappings":[]}', mapping_revision=1, status='VALIDATED', invalid_rows=0, error_report_object_key=NULL, error_report_content_hash=NULL, error_report_size_bytes=NULL, validation='{"valid":false,"issues":[]}', canonical_object_key='tenant/{{ORG_A}}/imports/{{IMP_A15}}/c.json', canonical_content_hash='{{H3}}', canonical_size_bytes=2$q$,
  $q$canonical_object_key='tenant/{{ORG_A}}/imports/{{IMP_A15}}/c.json', canonical_content_hash='{{H3}}', canonical_size_bytes=2$q$, -- not VALIDATED
  $q$canonical_object_key='tenant/{{ORG_A}}/imports/{{IMP_A15}}/c.json'$q$,
  $q$canonical_content_hash='{{H3}}', canonical_size_bytes=2$q$,
  $q$canonical_preview='{}'$q$,
  $q$canonical_preview=(SELECT jsonb_agg(null::text) FROM generate_series(1, 101))$q$
]) AS s;
-- Each canonical key below has its hash and size and a VALIDATED import,
-- so only the key's own check fails (D-035: under the import's own prefix).
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A15}}', format($q$mapping='{"mappings":[]}', mapping_revision=1, status='VALIDATED', invalid_rows=0,
    error_report_object_key=NULL, error_report_content_hash=NULL, error_report_size_bytes=NULL, validation='{"valid":true,"issues":[]}',
    canonical_object_key=%L, canonical_content_hash='{{H3}}', canonical_size_bytes=%s$q$, k, n)), '23514')
  FROM (VALUES
    ('tenant/{{ORG_A}}/imports/{{IMP_A11}}/c.json', 2),
    ('tenant/{{ORG_B}}/imports/{{IMP_A15}}/c.json', 2),
    ('tenant/{{ORG_A_WILD}}/imports/{{IMP_A15}}/c.json', 2),
    ('tenant/{{ORG_A}}/imports/{{IMP_A15}}/../c.json', 2),
    ('tenant/{{ORG_A}}/imports/{{IMP_A15}}/upload', 2),
    ('tenant/{{ORG_A}}/imports/{{IMP_A15}}/c.json', 1),
    ('tenant/{{ORG_A}}/imports/{{IMP_A15}}/c.json', 268435457)
  ) AS t(k, n);
ALTER TABLE twin.imports ENABLE TRIGGER USER;

-- The grants: the worker writes a validation's canonical columns, never
-- the mapping or its revision.
SELECT pg_temp.check(has_column_privilege('twin_worker', 'twin.imports', c, 'UPDATE'), 'the worker cannot write ' || c)
  FROM unnest(ARRAY['canonical_preview','canonical_object_key','canonical_content_hash','canonical_size_bytes','validation','invalid_rows','status','error']) AS c;
SELECT pg_temp.check(NOT has_column_privilege('twin_worker', 'twin.imports', c, 'UPDATE'), 'the worker can write ' || c)
  FROM unnest(ARRAY['mapping','mapping_revision','dataset_version_id','proposal_id']) AS c;
SELECT pg_temp.check(string_agg(id || ':' || status, ',' ORDER BY id) =
    '{{IMP_A11}}:VALIDATING,{{IMP_A12}}:FAILED,{{IMP_A13}}:FAILED,{{IMP_A14}}:UPLOADED,{{IMP_A15}}:AWAITING_MAPPING,{{IMP_A16}}:FAILED',
    'the imports ended as they did: ' || string_agg(id || ':' || status, ',' ORDER BY id))
  FROM twin.imports WHERE organization_id='{{ORG_A}}';

