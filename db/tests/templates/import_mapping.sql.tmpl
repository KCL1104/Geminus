-- T-017 (migration 0014; TEST-012, TEST-013; APPROVED D-009, D-037, D-043
-- (c); D-071, D-072 PROPOSED): a mapping is saved as the next revision of
-- a profiled import, which starts VALIDATING with the earlier validation
-- cleared and its validation job queued in the same transaction; only the
-- job of the current revision writes a validation, in the transaction
-- that completes it (the stale-job fence: an older revision's job writes
-- nothing, however it ends); the import follows that job to FAILED; what
-- VALIDATED and a validation that leaves the import to be mapped again
-- hold; the API never writes a validation, the worker never maps; a write
-- from any other trigger is not taken for a job's follow (the trigger
-- depth no longer decides it).
-- Disposable dt_test_* database only (scripts/run_db_tests.sh). One
-- transaction, rolled back. Generated by scripts/render_db_tests.py.
\set ON_ERROR_STOP 1
BEGIN;
CREATE FUNCTION pg_temp.fail(msg text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF current_setting('dt.collect', true) = 'on' THEN RAISE WARNING 'FAILED: %', msg;
  ELSE RAISE EXCEPTION 'FAILED: %', msg; END IF;
END $$;
CREATE FUNCTION pg_temp.must_fail(stmt text, state text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE got text; msg text;
BEGIN
  BEGIN
    EXECUTE stmt;
    RAISE EXCEPTION USING ERRCODE = 'P0099'; -- roll the unexpected success back
  EXCEPTION WHEN OTHERS THEN
    got := SQLSTATE; msg := SQLERRM;
  END;
  IF got = 'P0099' THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but the statement succeeded: %s', state, stmt));
  ELSIF got <> state THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but got %s (%s) for: %s', state, got, msg, stmt));
  END IF;
END $$;
-- must_fail_at_commit runs the statements stmts in order and then the
-- deferred checks, which must refuse them.
CREATE FUNCTION pg_temp.must_fail_at_commit(stmts text[], state text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE got text; msg text; stmt text;
BEGIN
  BEGIN
    FOREACH stmt IN ARRAY stmts LOOP
      EXECUTE stmt;
    END LOOP;
    SET CONSTRAINTS ALL IMMEDIATE;
    RAISE EXCEPTION USING ERRCODE = 'P0099';
  EXCEPTION WHEN OTHERS THEN
    got := SQLSTATE; msg := SQLERRM;
  END;
  SET CONSTRAINTS ALL DEFERRED;
  IF got = 'P0099' THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s at commit but it committed: %s', state, stmts));
  ELSIF got <> state THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s at commit but got %s (%s) for: %s', state, got, msg, stmts));
  END IF;
END $$;
CREATE FUNCTION pg_temp.check(ok boolean, what text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF ok IS NOT TRUE THEN PERFORM pg_temp.fail(what); END IF;
END $$;
-- An UPDATE of one import of tenant A, as a statement.
CREATE FUNCTION pg_temp.upd(imp text, change text) RETURNS text LANGUAGE sql AS $$
  SELECT format('UPDATE twin.imports SET %s WHERE organization_id=%L AND id=%L', change, '{{ORG_A}}', imp)
$$;
-- A person's save of mapping revision rev: VALIDATING with the earlier
-- validation cleared (the API's internal/storage/imports.SaveMapping); its
-- SET list, and the statement.
CREATE FUNCTION pg_temp.save_set(rev int) RETURNS text LANGUAGE sql AS $$
  SELECT format('mapping=%L, mapping_revision=%s, status=''VALIDATING'', validation=NULL, invalid_rows=0, '
    'canonical_preview=''[]'', canonical_object_key=NULL, canonical_content_hash=NULL, canonical_size_bytes=NULL, '
    'error_report_object_key=NULL, error_report_content_hash=NULL, error_report_size_bytes=NULL',
    '{"mappings":[{"source_column":"a","target_field":"case_id","transform":"identity"},{"source_column":"r","target_field":"metadata","transform":"identity"}],"rev":' || rev || '}', rev)
$$;
CREATE FUNCTION pg_temp.save(imp text, rev int) RETURNS text LANGUAGE sql AS $$
  SELECT pg_temp.upd(imp, pg_temp.save_set(rev))
$$;
-- The validation job of revision rev.
CREATE FUNCTION pg_temp.job(id text, imp text, rev int) RETURNS text LANGUAGE sql AS $$
  SELECT format('INSERT INTO twin.jobs(id,organization_id,type,status,payload,import_id) VALUES (%L,%L,''import_validate'',''queued'',%L,%L)',
    id, '{{ORG_A}}', json_build_object('import_id', imp, 'mapping_revision', rev, 'request_id', '{{REQ_A1}}')::text, imp)
$$;
-- A worker's claim of job id, and its end.
CREATE FUNCTION pg_temp.claim(id text) RETURNS text LANGUAGE sql AS $$
  SELECT format('UPDATE twin.jobs SET status=''running'', attempt=attempt+1, lease_token=lease_token+1, locked_at=now(), locked_by=''w'', '
    'lease_expires_at=now()+interval ''30 seconds'' WHERE organization_id=%L AND id=%L', '{{ORG_A}}', id)
$$;
CREATE FUNCTION pg_temp.finish(id text, status text, error text) RETURNS text LANGUAGE sql AS $$
  SELECT format('UPDATE twin.jobs SET status=%L, locked_at=NULL, locked_by=NULL, lease_expires_at=NULL, error=%L WHERE organization_id=%L AND id=%L',
    status, error, '{{ORG_A}}', id)
$$;
-- A validation's result for import imp, as the validator writes it: its
-- SET list, and the statement.
CREATE FUNCTION pg_temp.validated_set(imp text) RETURNS text LANGUAGE sql AS $$
  SELECT format('status=''VALIDATED'', validation=''{"valid":true,"issues":[]}'', '
    'canonical_preview=''[{"case_id":"SN-1","event_type":"operation","timestamp":"2026-10-13T06:12:00Z"}]'', '
    'canonical_object_key=%L, canonical_content_hash=''{{H3}}'', canonical_size_bytes=200',
    'tenant/{{ORG_A}}/imports/' || imp || '/canonical-r1-a1.json')
$$;
CREATE FUNCTION pg_temp.validated(imp text) RETURNS text LANGUAGE sql AS $$
  SELECT pg_temp.upd(imp, pg_temp.validated_set(imp))
$$;
CREATE FUNCTION pg_temp.not_valid(imp text) RETURNS text LANGUAGE sql AS $$
  SELECT pg_temp.upd(imp, format('status=''AWAITING_MAPPING'', '
    'validation=''{"valid":false,"issues":[{"code":"MAPPING_VALUE_INVALID","path":"/1/a","message":"timestamp: x","severity":"error"}]}'', '
    'invalid_rows=1, canonical_preview=''[{"case_id":"SN-1","event_type":"operation","timestamp":"2026-10-13T06:12:00Z"},null]'', '
    'error_report_object_key=%L, error_report_content_hash=''{{H2}}'', error_report_size_bytes=120',
    'tenant/{{ORG_A}}/imports/' || imp || '/validation-errors-r1-a1.csv'))
$$;
GRANT EXECUTE ON FUNCTION pg_temp.upd(text, text), pg_temp.save_set(int), pg_temp.save(text, int), pg_temp.job(text, text, int),
  pg_temp.claim(text), pg_temp.finish(text, text, text), pg_temp.validated_set(text), pg_temp.validated(text), pg_temp.not_valid(text),
  pg_temp.must_fail(text, text), pg_temp.must_fail_at_commit(text[], text) TO PUBLIC;

