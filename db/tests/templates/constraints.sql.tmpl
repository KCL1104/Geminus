  $q$UPDATE twin.jobs SET status='completed', locked_by=NULL, lease_expires_at=NULL WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A2}}'$q$,
  $q$UPDATE twin.jobs SET status='failed', locked_by=NULL, locked_at=NULL, error='{"code":"X","message":"x","retryable":false}' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A2}}'$q$
]) AS s;
UPDATE twin.jobs SET status='queued', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL, error='{"code":"X","message":"x","retryable":true}'
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A2}}';
UPDATE twin.jobs SET status='running', attempt=attempt+1, lease_token=lease_token+1, locked_at=now(), locked_by='w2', lease_expires_at=now()+interval '30 seconds'
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A2}}';
UPDATE twin.jobs SET status='completed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL, error=NULL WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A2}}';
SELECT pg_temp.check((SELECT status='completed' AND attempt=2 AND lease_token=2 FROM twin.jobs WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A2}}'),
