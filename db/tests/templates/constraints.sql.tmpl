REVOKE SELECT, INSERT, UPDATE ON twin.jobs FROM twin_provisioner;
GRANT INSERT ON twin.jobs TO twin_worker;
SET LOCAL ROLE twin_worker;
SELECT pg_temp.must_fail($q$INSERT INTO twin.jobs(id,organization_id,type,status,payload,import_id) VALUES ('job_01M4YDQK00TA00000000000097','{{ORG_A}}','import_validate','queued','{}','{{IMP_A1}}')$q$, '55000');
RESET ROLE;
REVOKE INSERT ON twin.jobs FROM twin_worker;
SET LOCAL ROLE twin_worker;
SELECT pg_temp.must_fail($q$UPDATE twin.jobs SET status='queued', error=NULL WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A4}}'$q$, '55000');
