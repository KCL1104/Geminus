UPDATE twin.jobs SET status='failed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL, error='{"code":"X","message":"x","retryable":false}'
  WHERE organization_id='{{ORG_A}}' AND id IN ('{{JOB_A4}}','{{JOB_A6}}');
UPDATE twin.jobs SET status='cancelled', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A5}}';

-- The API cannot end, take over or retry a running job (the lease is the
-- worker's).
SET LOCAL ROLE twin_api;
SELECT pg_temp.must_fail(s, '55000') FROM unnest(ARRAY[
  $q$UPDATE twin.jobs SET status='completed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET locked_by='api', lease_token=lease_token+1 WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET status='queued', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET status='cancelled', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  -- Nor with the lease left as it is.
  $q$UPDATE twin.jobs SET status='cancelled' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET status='queued' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$
]) AS s;

-- Identity and input are immutable even for the owner, on a running job
-- as on a finished one; a finished job is final for every role. Writing a
-- row unchanged is not a change.
SET LOCAL ROLE twin_owner;
SELECT pg_temp.must_fail(s, '55000') FROM unnest(ARRAY[
  $q$UPDATE twin.jobs SET payload='{"import_id":"other"}' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET max_attempts=10 WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET created_at=now()-interval '1 day' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  -- Attempts and tokens never go back, for the owner too (the worker's own
  -- rule refuses any change of them outside a claim).
  $q$UPDATE twin.jobs SET attempt=0 WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET lease_token=lease_token-1 WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET id='job_01M4YDQK00TA00000000000099' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET organization_id='{{ORG_B}}' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET type='import_mapping' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET type='simulation', import_id=NULL, simulation_run_id='{{SIM_A1}}' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  -- Each resource column on its own; only the trigger answers 55000, so a
  -- CHECK or foreign key refusing the row instead fails the test too.
  $q$UPDATE twin.jobs SET import_id='{{IMP_A2}}' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET simulation_run_id='{{SIM_A1}}' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET ai_proposal_id='{{AIP_A1}}' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET ai_analysis_id='{{ANA_A1}}' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}'$q$,
  $q$UPDATE twin.jobs SET status='running', attempt=attempt+1, lease_token=lease_token+1, locked_at=now(), locked_by='w', lease_expires_at=now()+interval '30 seconds'
     WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A2}}'$q$,
  $q$UPDATE twin.jobs SET heartbeat_at=clock_timestamp() WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A2}}'$q$,
  $q$UPDATE twin.jobs SET status='queued' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A3}}'$q$,
  $q$UPDATE twin.jobs SET status='completed' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A3}}'$q$,
  $q$UPDATE twin.jobs SET status='queued', error=NULL WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A4}}'$q$,
  $q$UPDATE twin.jobs SET status='completed' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A5}}'$q$,
  -- A queued job is claimed or cancelled, for the owner too.
  $q$UPDATE twin.jobs SET status='completed' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A8}}'$q$,
  $q$UPDATE twin.jobs SET status='failed', error='{"code":"X","message":"x","retryable":false}' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A8}}'$q$
]) AS s;
UPDATE twin.jobs SET status=status WHERE organization_id='{{ORG_A}}' AND id IN ('{{JOB_A2}}','{{JOB_A3}}','{{JOB_A4}}','{{JOB_A5}}');
-- An operator may still end a running job by hand; a login that is a
-- member of the owner and of a runtime role (here the suite's superuser,
-- a member of every role) counts as the owner.
RESET ROLE;
UPDATE twin.jobs SET status='failed', locked_at=NULL, locked_by=NULL, lease_expires_at=NULL, error='{"code":"OPERATOR","message":"x","retryable":false}'
  WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A7}}';
-- Any other role is refused, whatever privileges it is given (round 2 I2).
GRANT SELECT, INSERT, UPDATE ON twin.jobs TO twin_provisioner;
SET LOCAL ROLE twin_provisioner;
SELECT pg_temp.must_fail(s, '55000') FROM unnest(ARRAY[
  $q$UPDATE twin.jobs SET status='cancelled' WHERE organization_id='{{ORG_A}}' AND id='{{JOB_A8}}'$q$,
  $q$INSERT INTO twin.jobs(id,organization_id,type,status,payload,import_id) VALUES ('job_01M4YDQK00TA00000000000098','{{ORG_A}}','import_validate','queued','{}','{{IMP_A1}}')$q$
]) AS s;
-- Nor does the worker enqueue, even given INSERT.
