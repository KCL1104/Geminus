-- D-001: every ID column uses the domain of its kind; an ID-like column with
-- no expected domain is itself a failure, so new columns must be classified.
WITH cols AS (
  SELECT c.table_name, c.column_name, c.domain_name
  FROM information_schema.columns c
  WHERE c.table_schema='twin' AND c.table_name IN (SELECT tablename FROM pg_tables WHERE schemaname='twin')
    AND (c.column_name='id' OR c.column_name ~ '_id$' OR c.column_name IN ('created_by','updated_by','decided_by'))
), expected AS (
  SELECT c.*, CASE
      WHEN c.column_name='id' THEN p.domain
      WHEN c.table_name='audit_events' AND c.column_name='actor_id' THEN 'actor_ref'
      WHEN c.table_name='audit_events' AND c.column_name='target_id' THEN 'public_id'
      ELSE m.domain END AS want
  FROM cols c
  LEFT JOIN (VALUES
    ('organization_id','org_id'),('user_id','usr_id'),('actor_id','usr_id'),('project_id','prj_id'),('model_id','mdl_id'),
    ('base_version_id','mv_id'),('model_version_id','mv_id'),('parent_version_id','mv_id'),('latest_version_id','mv_id'),('new_version_id','mv_id'),
    ('dataset_id','ds_id'),('dataset_version_id','dsv_id'),('parent_dataset_version_id','dsv_id'),
    ('import_id','imp_id'),('source_import_id','imp_id'),('proposal_id','aip_id'),('source_proposal_id','aip_id'),('ai_proposal_id','aip_id'),
    ('scenario_id','scn_id'),('run_id','sim_id'),('simulation_run_id','sim_id'),('baseline_run_id','sim_id'),('ai_analysis_id','ana_id'),
    ('request_id','req_id'),('trace_artifact_id','art_id'),('created_by','usr_id'),('updated_by','usr_id'),('decided_by','usr_id')
  ) AS m(column_name, domain) ON m.column_name=c.column_name
  LEFT JOIN (VALUES
    ('users','usr_id'),('organizations','org_id'),('projects','prj_id'),('models','mdl_id'),('model_versions','mv_id'),
    ('datasets','ds_id'),('dataset_versions','dsv_id'),('imports','imp_id'),('ai_proposals','aip_id'),('scenarios','scn_id'),
    ('simulation_runs','sim_id'),('ai_analyses','ana_id'),('jobs','job_id'),('audit_events','aud_id')
  ) AS p(table_name, domain) ON p.table_name=c.table_name
)
SELECT pg_temp.check(count(*)=0, 'ID columns without their D-001 domain: ' ||
    coalesce(string_agg(table_name||'.'||column_name||'='||coalesce(domain_name,'text')||' want '||coalesce(want,'?'), ', '), ''))
  FROM expected WHERE want IS NULL OR domain_name IS DISTINCT FROM want;

