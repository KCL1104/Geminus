-- T-016 (migration 0010; TEST-012, TEST-029; D-009, D-035, D-037, D-043,
-- D-044): an import's upload never changes, for any role; its profile is
-- written once, by its job, and is there exactly when the import is past
-- profiling; the API never writes a profile, a preview or an error report;
-- an error report is named all or nothing; FAILED and COMMITTED imports are
-- final; only the API, the worker and the schema owner write imports.
-- Disposable dt_test_* database only (scripts/run_db_tests.sh). One
-- transaction, rolled back. Generated by scripts/render_db_tests.py.
\set ON_ERROR_STOP 1
BEGIN;
CREATE FUNCTION pg_temp.fail(msg text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF current_setting('dt.collect', true) = 'on' THEN RAISE WARNING 'FAILED: %', msg;
  ELSE RAISE EXCEPTION 'FAILED: %', msg; END IF;
END $$;
CREATE FUNCTION pg_temp.must_fail(stmt text, state text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE got text; msg text;
BEGIN
  BEGIN
    EXECUTE stmt;
    RAISE EXCEPTION USING ERRCODE = 'P0099'; -- roll the unexpected success back
  EXCEPTION WHEN OTHERS THEN
    got := SQLSTATE; msg := SQLERRM;
  END;
  IF got = 'P0099' THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but the statement succeeded: %s', state, stmt));
  ELSIF got <> state THEN
    PERFORM pg_temp.fail(format('expected SQLSTATE %s but got %s (%s) for: %s', state, got, msg, stmt));
  END IF;
END $$;
CREATE FUNCTION pg_temp.check(ok boolean, what text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF ok IS NOT TRUE THEN PERFORM pg_temp.fail(what); END IF;
END $$;
-- An UPDATE of one import of tenant A, as a statement for must_fail.
CREATE FUNCTION pg_temp.upd(imp text, change text) RETURNS text LANGUAGE sql AS $$
  SELECT format('UPDATE twin.imports SET %s WHERE organization_id=%L AND id=%L', change, '{{ORG_A}}', imp)
$$;
GRANT EXECUTE ON FUNCTION pg_temp.upd(text, text) TO PUBLIC;

SET LOCAL ROLE twin_owner;
SELECT set_config('app.oidc_issuer','https://test.invalid',true), set_config('app.oidc_subject','subject_a',true),
       set_config('app.organization_id','{{ORG_A}}',true), set_config('app.user_id','{{USR_A}}',true);
INSERT INTO twin.users(id,oidc_issuer,oidc_subject) VALUES ('{{USR_A}}','https://test.invalid','subject_a');
INSERT INTO twin.organizations(id,organization_id,name) VALUES ('{{ORG_A}}','{{ORG_A}}','Tenant A');
INSERT INTO twin.memberships(organization_id,user_id,role) VALUES ('{{ORG_A}}','{{USR_A}}','owner');
INSERT INTO twin.projects(id,organization_id,name,created_by) VALUES ('{{PRJ_A}}','{{ORG_A}}','Project A','{{USR_A}}');
INSERT INTO twin.models(id,organization_id,project_id,name,domain,created_by)
  VALUES ('{{MDL_A}}','{{ORG_A}}','{{PRJ_A}}','Model A','software_delivery','{{USR_A}}');
INSERT INTO twin.model_versions(id,organization_id,model_id,version,schema_version,ir,hash,created_by)
  VALUES ('{{MV_A1}}','{{ORG_A}}','{{MDL_A}}',1,'0.1','{{IR_A1}}','{{IR_A1_HASH}}','{{USR_A}}');

-- The API uploads: imports start as UPLOADED, each with one profile job.
SET LOCAL ROLE twin_api;
INSERT INTO twin.imports(id,organization_id,project_id,model_id,base_version_id,kind,filename,upload_object_key,upload_content_hash,size_bytes,status,created_by)
  SELECT i,'{{ORG_A}}','{{PRJ_A}}','{{MDL_A}}','{{MV_A1}}','csv_events','原始資料.csv','tenant/{{ORG_A}}/imports/'||i||'/upload','{{H1}}',10,'UPLOADED','{{USR_A}}'
  FROM unnest(ARRAY['{{IMP_A3}}','{{IMP_A4}}','{{IMP_A5}}','{{IMP_A6}}']) AS i;
INSERT INTO twin.jobs(id,organization_id,type,status,payload,import_id)
  VALUES ('{{JOB_A21}}','{{ORG_A}}','import_profile','queued','{"import_id":"{{IMP_A3}}"}','{{IMP_A3}}'),
         ('{{JOB_A22}}','{{ORG_A}}','import_profile','queued','{"import_id":"{{IMP_A4}}"}','{{IMP_A4}}');
-- An import starts UPLOADED.
SELECT pg_temp.must_fail($q$INSERT INTO twin.imports(id,organization_id,project_id,model_id,base_version_id,kind,filename,upload_object_key,upload_content_hash,size_bytes,status,created_by)
  VALUES ('{{IMP_A9}}','{{ORG_A}}','{{PRJ_A}}','{{MDL_A}}','{{MV_A1}}','csv_events','a.csv','tenant/{{ORG_A}}/imports/{{IMP_A9}}/upload','{{H1}}',10,'PROFILING','{{USR_A}}')$q$, '55000');

-- The API never writes what profiling finds, and does not move an import
-- while it is profiled: its job does.
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A3}}', s), '55000') FROM unnest(ARRAY[
  $q$preview='[{"a":"1"}]'$q$,
  $q$error_report_object_key='tenant/{{ORG_A}}/imports/{{IMP_A3}}/e.csv', error_report_content_hash='{{H2}}', error_report_size_bytes=10$q$,
  $q$status='FAILED', error='{"code":"X","message":"x","retryable":false}'$q$,
  $q$status='PROFILING'$q$
]) AS s;
-- Nor the upload itself, which no role ever changes.
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A3}}', s), '55000') FROM unnest(ARRAY[
  $q$filename='other.csv'$q$,
  $q$kind='json_events'$q$,
  $q$upload_object_key='tenant/{{ORG_A}}/imports/{{IMP_A4}}/upload'$q$,
  $q$upload_content_hash='{{H2}}'$q$,
  $q$size_bytes=11$q$,
  $q$base_version_id='{{MV_A2}}'$q$,
  $q$created_by='{{USR_A2}}'$q$,
  $q$created_at=created_at-interval '1 second'$q$
]) AS s;
-- The worker has no INSERT on imports.
SET LOCAL ROLE twin_worker;
SELECT pg_temp.must_fail($q$INSERT INTO twin.imports(id,organization_id,project_id,model_id,base_version_id,kind,filename,upload_object_key,upload_content_hash,size_bytes,status,created_by)
  VALUES ('{{IMP_A9}}','{{ORG_A}}','{{PRJ_A}}','{{MDL_A}}','{{MV_A1}}','csv_events','a.csv','tenant/{{ORG_A}}/imports/{{IMP_A9}}/upload','{{H1}}',10,'UPLOADED','{{USR_A}}')$q$, '42501');

-- A profile exists exactly when the import is past profiling.
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A3}}', s), '23514') FROM unnest(ARRAY[
  $q$profile='{"format":"csv","encoding":"utf-8","rows":0,"columns":[]}'$q$,
  $q$status='PROFILING', profile='{"format":"csv","encoding":"utf-8","rows":0,"columns":[]}'$q$,
  $q$status='AWAITING_MAPPING'$q$,
  $q$status='FAILED'$q$
]) AS s;
-- The worker profiles: PROFILING, then AWAITING_MAPPING with the profile,
-- the preview, the counts and the error report, all through its column
-- grants (D-037).
UPDATE twin.imports SET status='PROFILING' WHERE organization_id='{{ORG_A}}' AND id='{{IMP_A3}}';
-- A profile is a JSON object; an error report is named by key, hash and
-- size together, within 16 MiB, under the tenant's imports prefix (D-035).
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A3}}', s), '23514') FROM unnest(ARRAY[
  $q$status='AWAITING_MAPPING', profile='[]'$q$,
  $q$status='AWAITING_MAPPING', profile='{}', error_report_object_key='tenant/{{ORG_A}}/imports/{{IMP_A3}}/e.csv'$q$,
  $q$status='AWAITING_MAPPING', profile='{}', error_report_object_key='tenant/{{ORG_A}}/imports/{{IMP_A3}}/e.csv', error_report_content_hash='{{H2}}'$q$,
  $q$status='AWAITING_MAPPING', profile='{}', error_report_content_hash='{{H2}}', error_report_size_bytes=10$q$,
  $q$status='AWAITING_MAPPING', profile='{}', error_report_object_key='tenant/{{ORG_A}}/imports/{{IMP_A3}}/e.csv', error_report_content_hash='{{H2}}', error_report_size_bytes=0$q$,
  $q$status='AWAITING_MAPPING', profile='{}', error_report_object_key='tenant/{{ORG_A}}/imports/{{IMP_A3}}/e.csv', error_report_content_hash='{{H2}}', error_report_size_bytes=16777217$q$,
  $q$status='AWAITING_MAPPING', profile='{}', error_report_object_key='tenant/{{ORG_B}}/imports/{{IMP_A3}}/e.csv', error_report_content_hash='{{H2}}', error_report_size_bytes=10$q$,
  $q$status='AWAITING_MAPPING', profile='{}', error_report_object_key='tenant/{{ORG_A_WILD}}/imports/{{IMP_A3}}/e.csv', error_report_content_hash='{{H2}}', error_report_size_bytes=10$q$,
  $q$status='AWAITING_MAPPING', profile='{}', error_report_object_key='tenant/{{ORG_A}}/simulation-results/{{IMP_A3}}/e.csv', error_report_content_hash='{{H2}}', error_report_size_bytes=10$q$,
  $q$status='AWAITING_MAPPING', profile='{}', error_report_object_key='tenant/{{ORG_A}}/imports/{{IMP_A3}}/../e.csv', error_report_content_hash='{{H2}}', error_report_size_bytes=10$q$
]) AS s;
UPDATE twin.imports SET status='AWAITING_MAPPING',
    profile='{"format":"csv","encoding":"utf-8-bom","rows":3,"columns":[{"name":"欄","index":0,"inferred":"integer","non_empty":2,"max_length":2}]}',
    preview='[{"欄":"1"},{"欄":"22"},{"欄":""}]', total_rows=3, invalid_rows=1,
    error_report_object_key='tenant/{{ORG_A}}/imports/{{IMP_A3}}/profile-errors-1.csv', error_report_content_hash='{{H2}}', error_report_size_bytes=120
  WHERE organization_id='{{ORG_A}}' AND id='{{IMP_A3}}';
SELECT pg_temp.check(status='AWAITING_MAPPING' AND profile->>'encoding'='utf-8-bom' AND preview->1->>'欄'='22' AND error_report_size_bytes=120,
    'the worker wrote the profile: '||status)
  FROM twin.imports WHERE organization_id='{{ORG_A}}' AND id='{{IMP_A3}}';
-- The profile is written once, and a profiled import is never profiled
-- again, whoever asks.
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A3}}', s), '55000') FROM unnest(ARRAY[
  $q$profile='{"format":"csv","encoding":"utf-8","rows":3,"columns":[]}'$q$,
  $q$status='PROFILING', profile=NULL$q$,
  $q$status='UPLOADED', profile=NULL$q$
]) AS s;
SET LOCAL ROLE twin_owner;
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A3}}', s), '55000') FROM unnest(ARRAY[
  $q$profile='{"format":"csv","encoding":"utf-8","rows":3,"columns":[]}'$q$,
  $q$status='UPLOADED', profile=NULL, preview='[]', total_rows=0, invalid_rows=0$q$,
  $q$upload_content_hash='{{H2}}'$q$,
  $q$filename='renamed.csv'$q$
]) AS s;
-- The API still keeps the human-confirmed columns of a profiled import
-- (T-017) but never touches its profile, preview or error report.
SET LOCAL ROLE twin_api;
UPDATE twin.imports SET mapping='{"mappings":[]}', mapping_revision=mapping_revision+1 WHERE organization_id='{{ORG_A}}' AND id='{{IMP_A3}}';
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A3}}', s), '55000') FROM unnest(ARRAY[
  $q$preview='[]'$q$,
  $q$error_report_object_key=NULL, error_report_content_hash=NULL, error_report_size_bytes=NULL$q$
]) AS s;

-- A file that cannot be profiled: FAILED with its error, and final.
SET LOCAL ROLE twin_worker;
UPDATE twin.imports SET status='PROFILING' WHERE organization_id='{{ORG_A}}' AND id='{{IMP_A4}}';
UPDATE twin.imports SET status='FAILED', error='{"code":"JSON_DUPLICATE_KEY","message":"duplicate object member name","path":"/41/case_id","retryable":false}'
  WHERE organization_id='{{ORG_A}}' AND id='{{IMP_A4}}';
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A4}}', s), '55000') FROM unnest(ARRAY[
  $q$status='PROFILING', error=NULL$q$,
  $q$error='{"code":"X","message":"x","retryable":true}'$q$
]) AS s;
SET LOCAL ROLE twin_api;
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A4}}', $q$mapping='{"mappings":[]}'$q$), '55000');
SET LOCAL ROLE twin_owner;
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A4}}', s), '55000') FROM unnest(ARRAY[
  $q$status='UPLOADED', error=NULL$q$,
  $q$error='{"code":"X","message":"x","retryable":true}'$q$
]) AS s;

-- The owner moves an import only the ways the checks allow: from
-- UPLOADED straight to FAILED (an operator ending a stuck upload), never to
-- AWAITING_MAPPING without a profile.
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A5}}', $q$status='AWAITING_MAPPING'$q$), '23514');
UPDATE twin.imports SET status='FAILED', error='{"code":"OPERATOR","message":"ended by an operator","retryable":false}'
  WHERE organization_id='{{ORG_A}}' AND id='{{IMP_A5}}';
-- An unchanged row is no change.
SET LOCAL ROLE twin_api;
UPDATE twin.imports SET filename=filename WHERE organization_id='{{ORG_A}}' AND id='{{IMP_A6}}';

-- Any other role is refused whatever privileges it is given.
RESET ROLE;
GRANT SELECT, UPDATE ON twin.imports TO twin_provisioner;
SET LOCAL ROLE twin_provisioner;
SELECT pg_temp.must_fail(pg_temp.upd('{{IMP_A6}}', $q$status='PROFILING'$q$), '55000');
RESET ROLE;
REVOKE SELECT, UPDATE ON twin.imports FROM twin_provisioner;
SET LOCAL ROLE twin_owner;
SELECT pg_temp.check(string_agg(status, ',' ORDER BY id)='AWAITING_MAPPING,FAILED,FAILED,UPLOADED', 'the imports ended as they did: '||string_agg(status, ',' ORDER BY id))
  FROM twin.imports WHERE organization_id='{{ORG_A}}';

ROLLBACK;
