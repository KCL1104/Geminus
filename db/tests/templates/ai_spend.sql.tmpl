-- Structure: FORCE RLS and a policy on each table; the worker's
-- privileges are exactly these; the provisioning role has none.
SET LOCAL ROLE twin_owner;
SELECT pg_temp.check(c.relrowsecurity AND c.relforcerowsecurity AND EXISTS (SELECT 1 FROM pg_policy p WHERE p.polrelid = c.oid),
    c.relname || ' forces RLS with a policy')
  FROM pg_class c WHERE c.oid IN ('twin.ai_spend_periods'::regclass, 'twin.ai_spend_days'::regclass, 'twin.ai_spend_reservations'::regclass);
SELECT pg_temp.check(has_table_privilege('twin_worker', 'twin.' || t, p) = (p IN ('SELECT','INSERT')),
    format('twin_worker %s on %s', p, t))
  FROM unnest(ARRAY['ai_spend_periods','ai_spend_days','ai_spend_reservations']) AS t,
       unnest(ARRAY['SELECT','INSERT','UPDATE','DELETE','TRUNCATE','REFERENCES','TRIGGER']) AS p;
SELECT pg_temp.check(NOT has_table_privilege(r, 'twin.' || t, p), format('%s has no %s on %s', r, p, t))
  FROM unnest(ARRAY['twin_api','twin_provisioner']) AS r,
       unnest(ARRAY['ai_spend_periods','ai_spend_days','ai_spend_reservations']) AS t,
       unnest(ARRAY['SELECT','INSERT','UPDATE','DELETE','TRUNCATE']) AS p;
SELECT pg_temp.check(has_column_privilege('twin_worker', 'twin.' || t, c, 'UPDATE') = (c = ANY(allowed)),
    format('twin_worker UPDATE of %s.%s', t, c))
  FROM (VALUES ('ai_spend_periods', ARRAY['committed_nano_usd']),
               ('ai_spend_days', ARRAY['committed_nano_usd']),
               ('ai_spend_reservations', ARRAY['state','outcome','settled_nano_usd','input_tokens','output_tokens','cache_write_tokens',
                 'cache_read_tokens','unknown_attempts','credential_label','settled_at'])) AS v(t, allowed),
       LATERAL (SELECT attname::text AS c FROM pg_attribute WHERE attrelid = ('twin.' || v.t)::regclass AND attnum > 0 AND NOT attisdropped) AS cols;
SELECT pg_temp.check(count(*) = 2, 'check_ai_spend_day is a deferred constraint trigger on both tables')
  FROM pg_trigger WHERE tgname = 'check_ai_spend_day' AND tgdeferrable AND tginitdeferred
    AND tgrelid IN ('twin.ai_spend_days'::regclass, 'twin.ai_spend_reservations'::regclass);

