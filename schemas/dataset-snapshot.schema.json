{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin.example/spec/0.1/dataset-snapshot.schema.json",
  "title": "dataset-snapshot",
  "$comment": "D-006/D-019 numeric empirical snapshot: the bytes stored in private object storage. It does not carry its own hash: DatasetBinding.content_hash is SHA-256 of these exact stored bytes, verified before parsing. No arbitrary external URI.",
  "type": "object",
  "properties": {
    "dataset_version_id": {
      "$ref": "common.schema.json#/$defs/DatasetVersionID"
    },
    "organization_id": {
      "$ref": "common.schema.json#/$defs/OrganizationID"
    },
    "logical_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^dataset:[a-z0-9_.-]+$"
    },
    "unit": {
      "$ref": "common.schema.json#/$defs/TimeUnit"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1000000000000.0
      },
      "minItems": 1,
      "maxItems": 100000
    }
  },
  "required": [
    "dataset_version_id",
    "organization_id",
    "logical_ref",
    "unit",
    "samples"
  ],
  "additionalProperties": false
}
