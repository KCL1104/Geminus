{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin.example/spec/0.1/scenario.schema.json",
  "title": "scenario",
  "$comment": "SOURCE p.19 immutable base+patch semantics. PROPOSED D-004,D-012 immutable persisted Scenario; no canonical ModelVersion is created by scenario approval.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "base_version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "patch": {
      "$ref": "json-patch.schema.json"
    },
    "patch_hash": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_proposal_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "organization_id",
    "model_id",
    "base_version_id",
    "name",
    "patch",
    "patch_hash",
    "source_proposal_id",
    "created_by",
    "created_at"
  ],
  "additionalProperties": false
}
