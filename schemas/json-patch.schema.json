{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin.example/spec/0.1/json-patch.schema.json",
  "title": "json-patch",
  "$comment": "SOURCE RFC 6902 patches; PROPOSED D-014 restricted profile: add/remove/replace/test only, no empty root pointer. Application path allowlist is mandatory. Empty array allowed only for baseline/no-op contexts.",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "op": {
            "const": "add"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^/(?:[^~]|~[01])*$"
          },
          "value": {}
        },
        "required": [
          "op",
          "path",
          "value"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "const": "replace"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^/(?:[^~]|~[01])*$"
          },
          "value": {}
        },
        "required": [
          "op",
          "path",
          "value"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "const": "test"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^/(?:[^~]|~[01])*$"
          },
          "value": {}
        },
        "required": [
          "op",
          "path",
          "value"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "const": "remove"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^/(?:[^~]|~[01])*$"
          }
        },
        "required": [
          "op",
          "path"
        ],
        "additionalProperties": false
      }
    ]
  },
  "maxItems": 1000
}
