{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin.example/spec/0.1/http.schema.json",
  "title": "http",
  "$comment": "HTTP envelopes. SOURCE pp. 29–35 core payloads; PROPOSED D-001–D-004,D-008–D-015 missing lifecycle/listing/concurrency shapes. Never duplicate Model IR types here.",
  "$defs": {
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ProjectID"
        },
        "organization_id": {
          "$ref": "common.schema.json#/$defs/OrganizationID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "$ref": "common.schema.json#/$defs/UserID"
        }
      },
      "required": [
        "id",
        "organization_id",
        "name",
        "created_at",
        "created_by"
      ],
      "additionalProperties": false
    },
    "Membership": {
      "type": "object",
      "properties": {
        "organization_id": {
          "$ref": "common.schema.json#/$defs/OrganizationID"
        },
        "user_id": {
          "$ref": "common.schema.json#/$defs/UserID"
        },
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "editor",
            "viewer"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "organization_id",
        "user_id",
        "role",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Model": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ModelID"
        },
        "organization_id": {
          "$ref": "common.schema.json#/$defs/OrganizationID"
        },
        "project_id": {
          "$ref": "common.schema.json#/$defs/ProjectID"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "draft": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "base_version_id": {
              "$ref": "common.schema.json#/$defs/ModelVersionID"
            },
            "out_of_date": {
              "type": "boolean"
            }
          },
          "required": [
            "revision",
            "base_version_id",
            "out_of_date"
          ],
          "additionalProperties": false
        },
        "latest_version": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/ModelVersionID"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "organization_id",
        "project_id",
        "domain",
        "name",
        "draft",
        "latest_version",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Draft": {
      "type": "object",
      "properties": {
        "model_id": {
          "$ref": "common.schema.json#/$defs/ModelID"
        },
        "base_version_id": {
          "$ref": "common.schema.json#/$defs/ModelVersionID"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ir": {
          "$ref": "model-ir.schema.json"
        },
        "hash": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "out_of_date": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ValidationIssue"
          },
          "minItems": 0,
          "maxItems": 1000,
          "description": "D-028: semantic issues of the saved draft; publish and run reject drafts with errors."
        }
      },
      "required": [
        "model_id",
        "base_version_id",
        "revision",
        "ir",
        "hash",
        "out_of_date",
        "issues"
      ],
      "additionalProperties": false
    },
    "ModelVersion": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ModelVersionID"
        },
        "organization_id": {
          "$ref": "common.schema.json#/$defs/OrganizationID"
        },
        "model_id": {
          "$ref": "common.schema.json#/$defs/ModelID"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "schema_version": {
          "const": "0.1"
        },
        "parent_version_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/ModelVersionID"
            },
            {
              "type": "null"
            }
          ]
        },
        "ir": {
          "$ref": "model-ir.schema.json"
        },
        "hash": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dataset_bindings": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/DatasetBinding"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "comment": {
          "$comment": "D-041: Publish.comment as given; null when there was none (or it was empty), and for the first version.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "created_by": {
          "$ref": "common.schema.json#/$defs/UserID"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "organization_id",
        "model_id",
        "version",
        "schema_version",
        "parent_version_id",
        "ir",
        "hash",
        "dataset_bindings",
        "comment",
        "created_by",
        "created_at"
      ],
      "additionalProperties": false
    },
    "CreateProject": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "CreateModel": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "domain": {
          "const": "software_delivery"
        },
        "template": {
          "const": "default_delivery_pipeline"
        },
        "locale": {
          "$ref": "common.schema.json#/$defs/Locale",
          "description": "Language of the template's default names (REQ-022); en when absent. IDs are the same in every language, and the names become user data once created."
        }
      },
      "required": [
        "name",
        "domain",
        "template"
      ],
      "additionalProperties": false
    },
    "Publish": {
      "type": "object",
      "properties": {
        "expected_base_version_id": {
          "$ref": "common.schema.json#/$defs/ModelVersionID"
        },
        "comment": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        }
      },
      "required": [
        "expected_base_version_id"
      ],
      "additionalProperties": false
    },
    "ResetDraft": {
      "type": "object",
      "properties": {
        "expected_latest_version_id": {
          "$ref": "common.schema.json#/$defs/ModelVersionID"
        },
        "confirm_discard": {
          "const": true
        }
      },
      "required": [
        "expected_latest_version_id",
        "confirm_discard"
      ],
      "additionalProperties": false
    },
    "CancelSimulation": {
      "$comment": "T-023: the cancelSimulation body, an empty object (the run is in the path; the request is idempotent per Idempotency-Key).",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ProposalRequest": {
      "type": "object",
      "properties": {
        "base_version_id": {
          "$ref": "common.schema.json#/$defs/ModelVersionID"
        },
        "mode": {
          "type": "string",
          "enum": [
            "edit",
            "scenario"
          ]
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "context": {
          "type": "object",
          "properties": {
            "selected_entity_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "minItems": 0,
              "maxItems": 500
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "output_locale": {
          "$ref": "common.schema.json#/$defs/Locale",
          "description": "Language of the AI's prose (REQ-022, AI_SPEC §3); en when absent. The server validates it and states it in the provider instruction. Only prose follows it, never IDs, JSON Pointers, enum or reason codes, metric paths or units."
        }
      },
      "required": [
        "base_version_id",
        "mode",
        "intent"
      ],
      "additionalProperties": false
    },
    "ProposalAccepted": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "$ref": "common.schema.json#/$defs/ProposalID"
        },
        "status": {
          "const": "generating"
        }
      },
      "required": [
        "proposal_id",
        "status"
      ],
      "additionalProperties": false
    },
    "Approve": {
      "type": "object",
      "properties": {
        "expected_base_version_id": {
          "$ref": "common.schema.json#/$defs/ModelVersionID"
        },
        "comment": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        }
      },
      "required": [
        "expected_base_version_id"
      ],
      "additionalProperties": false
    },
    "Approval": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "proposal_id": {
              "$ref": "common.schema.json#/$defs/ProposalID"
            },
            "status": {
              "const": "approved"
            },
            "mode": {
              "const": "edit"
            },
            "new_version_id": {
              "$ref": "common.schema.json#/$defs/ModelVersionID"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "patch_hash": {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "draft_out_of_date": {
              "type": "boolean"
            }
          },
          "required": [
            "proposal_id",
            "status",
            "mode",
            "new_version_id",
            "version",
            "patch_hash",
            "draft_out_of_date"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "proposal_id": {
              "$ref": "common.schema.json#/$defs/ProposalID"
            },
            "status": {
              "const": "approved"
            },
            "mode": {
              "const": "scenario"
            },
            "scenario_id": {
              "$ref": "common.schema.json#/$defs/ScenarioID"
            },
            "patch_hash": {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "proposal_id",
            "status",
            "mode",
            "scenario_id",
            "patch_hash"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Reject": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "CreateScenario": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "patch": {
          "$ref": "json-patch.schema.json"
        }
      },
      "required": [
        "name",
        "patch"
      ],
      "additionalProperties": false
    },
    "SaveMapping": {
      "type": "object",
      "properties": {
        "expected_mapping_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mapping": {
          "$ref": "ai-mapping.schema.json"
        },
        "confirmed": {
          "const": true
        }
      },
      "required": [
        "expected_mapping_revision",
        "mapping",
        "confirmed"
      ],
      "additionalProperties": false
    },
    "CommitImport": {
      "type": "object",
      "properties": {
        "expected_mapping_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expected_base_version_id": {
          "$ref": "common.schema.json#/$defs/ModelVersionID"
        },
        "confirmed": {
          "const": true
        }
      },
      "required": [
        "expected_mapping_revision",
        "expected_base_version_id",
        "confirmed"
      ],
      "additionalProperties": false
    },
    "ImportAccepted": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ImportID"
        },
        "status": {
          "const": "UPLOADED"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false
    },
    "MappingSuggestionRequest": {
      "$comment": "T-024: the suggestImportMapping body (an inline empty object in openapi.yaml before).",
      "type": "object",
      "properties": {
        "output_locale": {
          "$ref": "common.schema.json#/$defs/Locale",
          "description": "Language of the AI's prose (REQ-022, AI_SPEC §3); en when absent. The server validates it and states it in the provider instruction. Only prose follows it, never IDs, JSON Pointers, enum or reason codes, metric paths or units."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ImportCommitted": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ImportID"
        },
        "status": {
          "const": "COMMITTED"
        },
        "dataset_version_id": {
          "$ref": "common.schema.json#/$defs/DatasetVersionID"
        },
        "proposal_id": {
          "$ref": "common.schema.json#/$defs/ProposalID"
        },
        "twin_mutated": {
          "const": false
        }
      },
      "required": [
        "id",
        "status",
        "dataset_version_id",
        "proposal_id",
        "twin_mutated"
      ],
      "additionalProperties": false
    },
    "RunAccepted": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/RunID"
        },
        "status": {
          "const": "queued"
        },
        "model_version_id": {
          "$ref": "common.schema.json#/$defs/ModelVersionID"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "status",
        "model_version_id",
        "created_at"
      ],
      "additionalProperties": false
    },
    "AnalysisRequest": {
      "type": "object",
      "properties": {
        "baseline_run_id": {
          "$ref": "common.schema.json#/$defs/RunID"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "output_locale": {
          "$ref": "common.schema.json#/$defs/Locale",
          "description": "Language of the AI's prose (REQ-022, AI_SPEC §3); en when absent. The server validates it and states it in the provider instruction. Only prose follows it, never IDs, JSON Pointers, enum or reason codes, metric paths or units. Numbers in the analysis prose are checked as Arabic numerals in either language."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "AnalysisAccepted": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/AnalysisID"
        },
        "status": {
          "const": "generating"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false
    },
    "AnalysisRecord": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/AnalysisID"
        },
        "organization_id": {
          "$ref": "common.schema.json#/$defs/OrganizationID"
        },
        "run_id": {
          "$ref": "common.schema.json#/$defs/RunID"
        },
        "baseline_run_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/RunID"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "generating",
            "completed",
            "failed"
          ]
        },
        "analysis": {
          "anyOf": [
            {
              "$ref": "analysis-output.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "organization_id",
        "run_id",
        "baseline_run_id",
        "status",
        "analysis",
        "created_at",
        "error"
      ],
      "additionalProperties": false
    },
    "SignedDownload": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "url",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "AuditEvent": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/AuditEventID"
        },
        "organization_id": {
          "$ref": "common.schema.json#/$defs/OrganizationID"
        },
        "actor_type": {
          "type": "string",
          "enum": [
            "user",
            "worker",
            "system"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_id": {
          "$ref": "common.schema.json#/$defs/ResourceID"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/RequestID"
        },
        "metadata": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": true,
          "description": "UNTRUSTED_DATA；server 另外限制深度、字串長度及總 bytes。"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "organization_id",
        "actor_type",
        "actor_id",
        "action",
        "target_type",
        "target_id",
        "request_id",
        "metadata",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "ProgressSnapshot": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "common.schema.json#/$defs/RunID"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completed_replications": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "total_replications": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "events_processed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cancellation_requested": {
          "type": "boolean"
        }
      },
      "required": [
        "run_id",
        "status",
        "revision",
        "completed_replications",
        "total_replications",
        "events_processed",
        "cancellation_requested"
      ],
      "additionalProperties": false
    },
    "ComparisonMetric": {
      "type": "object",
      "properties": {
        "metric_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "baseline": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1000000000000000.0,
              "maximum": 1000000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "scenario": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1000000000000000.0,
              "maximum": 1000000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "absolute_delta": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1000000000000000.0,
              "maximum": 1000000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "relative_delta": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1000000000000000.0,
              "maximum": 1000000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "incomparable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
