{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin.example/spec/0.1/common.schema.json",
  "title": "common",
  "$comment": "SOURCE pp. 14–19,29,35–36; PROPOSED D-001,D-006,D-010,D-014. Shared scalar and validation contracts.",
  "$defs": {
    "ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "Hash": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "TimeUnit": {
      "type": "string",
      "enum": [
        "millisecond",
        "second",
        "minute",
        "hour",
        "day"
      ]
    },
    "ModelTimeUnit": {
      "type": "string",
      "enum": [
        "second",
        "minute",
        "hour",
        "day"
      ]
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "ValidationIssue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "path": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        }
      },
      "required": [
        "code",
        "path",
        "message",
        "severity"
      ],
      "additionalProperties": false
    },
    "Validation": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ValidationIssue"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "valid",
        "issues"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 2048
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning"
                    ]
                  }
                },
                "required": [
                  "path",
                  "reason"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 1000
            },
            "request_id": {
              "$ref": "#/$defs/RequestID"
            }
          },
          "required": [
            "code",
            "message",
            "request_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "DatasetBinding": {
      "type": "object",
      "properties": {
        "logical_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^dataset:[a-z0-9_.-]+$"
        },
        "dataset_version_id": {
          "$ref": "#/$defs/DatasetVersionID"
        },
        "content_hash": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "unit": {
          "$ref": "common.schema.json#/$defs/TimeUnit"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "logical_ref",
        "dataset_version_id",
        "content_hash",
        "unit",
        "sample_count"
      ],
      "additionalProperties": false
    },
    "Duration": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 31536000000
        },
        "unit": {
          "$ref": "common.schema.json#/$defs/TimeUnit"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "OrganizationID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^org_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"org_\" + canonical (uppercase) ULID."
    },
    "UserID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^usr_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"usr_\" + canonical (uppercase) ULID."
    },
    "ProjectID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"prj_\" + canonical (uppercase) ULID."
    },
    "ModelID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^mdl_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"mdl_\" + canonical (uppercase) ULID."
    },
    "ModelVersionID": {
      "type": "string",
      "minLength": 29,
      "maxLength": 29,
      "pattern": "^mv_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"mv_\" + canonical (uppercase) ULID."
    },
    "DatasetID": {
      "type": "string",
      "minLength": 29,
      "maxLength": 29,
      "pattern": "^ds_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"ds_\" + canonical (uppercase) ULID."
    },
    "DatasetVersionID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^dsv_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"dsv_\" + canonical (uppercase) ULID."
    },
    "ImportID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^imp_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"imp_\" + canonical (uppercase) ULID."
    },
    "ProposalID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^aip_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"aip_\" + canonical (uppercase) ULID."
    },
    "ScenarioID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^scn_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"scn_\" + canonical (uppercase) ULID."
    },
    "RunID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^sim_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"sim_\" + canonical (uppercase) ULID."
    },
    "AnalysisID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^ana_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"ana_\" + canonical (uppercase) ULID."
    },
    "JobID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^job_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"job_\" + canonical (uppercase) ULID."
    },
    "AuditEventID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^aud_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"aud_\" + canonical (uppercase) ULID."
    },
    "RequestID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^req_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"req_\" + canonical (uppercase) ULID."
    },
    "ArtifactID": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^art_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "D-001 server-issued ID: \"art_\" + canonical (uppercase) ULID."
    },
    "ResourceID": {
      "type": "string",
      "minLength": 29,
      "maxLength": 30,
      "pattern": "^(aip|ana|art|aud|ds|dsv|imp|job|mdl|mv|org|prj|req|scn|sim|usr)_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Any D-001 server-issued resource ID."
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "IDEMPOTENCY_KEY_REQUIRED",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "NOT_FOUND",
        "MODEL_VERSION_CONFLICT",
        "IDEMPOTENCY_KEY_CONFLICT",
        "LIFECYCLE_CONFLICT",
        "RESULT_NOT_READY",
        "PROPOSAL_ALREADY_DECIDED",
        "PAYLOAD_TOO_LARGE",
        "UNSUPPORTED_MEDIA_TYPE",
        "MODEL_VALIDATION_FAILED",
        "REQUEST_VALIDATION_FAILED",
        "PRECONDITION_REQUIRED",
        "RATE_LIMITED",
        "INTERNAL_ERROR",
        "SERVICE_UNAVAILABLE",
        "AI_PROVIDER_NOT_CONFIGURED",
        "AI_POLICY_NOT_APPROVED"
      ],
      "description": "D-025 closed HTTP error-code catalogue. x-http-status maps each code to its only status.",
      "x-http-status": {
        "INVALID_REQUEST": 400,
        "IDEMPOTENCY_KEY_REQUIRED": 400,
        "UNAUTHENTICATED": 401,
        "FORBIDDEN": 403,
        "NOT_FOUND": 404,
        "MODEL_VERSION_CONFLICT": 409,
        "IDEMPOTENCY_KEY_CONFLICT": 409,
        "LIFECYCLE_CONFLICT": 409,
        "RESULT_NOT_READY": 409,
        "PROPOSAL_ALREADY_DECIDED": 409,
        "PAYLOAD_TOO_LARGE": 413,
        "UNSUPPORTED_MEDIA_TYPE": 415,
        "MODEL_VALIDATION_FAILED": 422,
        "REQUEST_VALIDATION_FAILED": 422,
        "PRECONDITION_REQUIRED": 428,
        "RATE_LIMITED": 429,
        "INTERNAL_ERROR": 500,
        "SERVICE_UNAVAILABLE": 503,
        "AI_PROVIDER_NOT_CONFIGURED": 503,
        "AI_POLICY_NOT_APPROVED": 503
      }
    },
    "Locale": {
      "type": "string",
      "enum": [
        "en",
        "zh-Hant"
      ],
      "description": "UI, template and AI prose language (REQ-022, H-005): en is the default; zh-Hant is Traditional Chinese."
    },
    "IdAllocationPool": {
      "type": "object",
      "properties": {
        "node": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 31,
            "maxLength": 31,
            "pattern": "^node_[0-7][0-9a-hjkmnp-tv-z]{25}$"
          },
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true
        },
        "flow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 31,
            "maxLength": 31,
            "pattern": "^flow_[0-7][0-9a-hjkmnp-tv-z]{25}$"
          },
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true
        },
        "resource": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 35,
            "maxLength": 35,
            "pattern": "^resource_[0-7][0-9a-hjkmnp-tv-z]{25}$"
          },
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "node",
        "flow",
        "resource"
      ],
      "additionalProperties": false,
      "description": "D-046: the IDs a proposal may give the nodes, flows and resources it adds, 16 of each kind, generated by the server when the proposal is created and never changed (ai_proposals.id_pool). Lowercase ULIDs, so they match the IR ID pattern and never look like a server resource ID (D-001)."
    },
    "ValidationCode": {
      "type": "string",
      "enum": [
        "JSON_INVALID",
        "IR_SCHEMA_INVALID",
        "LIMIT_EXCEEDED",
        "DUPLICATE_ID",
        "UNKNOWN_REFERENCE",
        "VIEW_REFERENCE_INVALID",
        "ROUTING_INVALID",
        "NO_REACHABLE_SINK",
        "ZERO_TIME_CYCLE",
        "UNREACHABLE_NODE",
        "RESOURCE_REQUIREMENT_INVALID",
        "DISTRIBUTION_INVALID",
        "CONSTRAINT_FAILED",
        "DATASET_BINDING_INVALID",
        "DOMAIN_MISMATCH",
        "PATCH_SCHEMA_INVALID",
        "PATCH_PATH_INVALID",
        "PATCH_PATH_FORBIDDEN",
        "PATCH_TEST_REQUIRED",
        "PATCH_TARGET_MISSING",
        "PATCH_TEST_FAILED",
        "ID_POOL_VIOLATION",
        "AI_OUTPUT_INVALID",
        "BLOCKING_CYCLE",
        "CALENDAR_INVALID",
        "RELEASE_SCHEDULE_INVALID",
        "BATCH_INVALID",
        "SETUP_INVALID",
        "STALL_RISK",
        "PRIMITIVE_NOT_SUPPORTED",
        "STATION_RESOURCE_INVALID",
        "RETEST_RESOURCE_MISMATCH",
        "TEST_RESULT_NOT_IDENTIFIED",
        "DOMAIN_ATTRIBUTES_INVALID"
      ],
      "description": "The issue codes the generic validator (TWIN_IR_SPEC §4, D-023), the patch policy (D-014, D-020), the domain packs and the server's review of an AI proposal (T-025: ID_POOL_VIOLATION for a new entity ID outside the proposal's D-046 pool, AI_OUTPUT_INVALID for a provider answer that is not an acceptable proposal; D-061 PROPOSED) emit; Go tests keep this list equal to their constants. ValidationIssue.code stays open: a later pack may add a code; the UI then shows the issue's own message as English text (ADR-020). T-046 phase 2 (ADR-026, D-050 A): BLOCKING_CYCLE, CALENDAR_INVALID, RELEASE_SCHEDULE_INVALID, BATCH_INVALID, SETUP_INVALID and STALL_RISK (an error) are the line-flow rules (TWIN_IR_SPEC §4); PRIMITIVE_NOT_SUPPORTED refuses a line-flow member this build does not implement yet (D-063 PROPOSED). DOMAIN_MISMATCH is every pack's; the electronics line pack (ELECTRONICS_LINE §3.4, T-051, D-117 PROPOSED) adds STATION_RESOURCE_INVALID (an error: a station process without exactly one resource of its station's role), RETEST_RESOURCE_MISMATCH (an error: a retest without its first test's primary resource), TEST_RESULT_NOT_IDENTIFIED (a warning: a test result decision without exactly one flow to a failure node, so the station's first-pass yield is unavailable) and DOMAIN_ATTRIBUTES_INVALID (a warning: a station, pass or result_of attribute the pack cannot use)."
    },
    "GeneratedBy": {
      "type": "object",
      "description": "H-043: which provider and model wrote an AI result (a proposal or an analysis), and for a photo proposal which segmenter read the image and how many objects it found (at most 64, D-131 (c)), taken from the stored provider metadata. Nothing else of that metadata is shown: no credential label, cost, reservation, request ID, hash or latency. A label for people, not a check of anything: the server's validation and risk stand on their own.",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "description": "The provider that answered, as configured (e.g. meta, anthropic, fake)."
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "description": "The model that answered, as the provider named it (e.g. muse-spark-1.3)."
        },
        "segmenter": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "model": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
            },
            "objects": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          },
          "required": [
            "provider",
            "objects"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    }
  }
}
