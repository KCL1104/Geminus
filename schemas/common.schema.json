{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin.example/spec/0.1/common.schema.json",
  "title": "common",
  "$comment": "SOURCE pp. 14–19,29,35–36; PROPOSED D-001,D-006,D-010,D-014. Shared scalar and validation contracts.",
  "$defs": {
    "ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "Hash": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "TimeUnit": {
      "type": "string",
      "enum": [
        "millisecond",
        "second",
        "minute",
        "hour",
        "day"
      ]
    },
    "ModelTimeUnit": {
      "type": "string",
      "enum": [
        "second",
        "minute",
        "hour",
        "day"
      ]
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "ValidationIssue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "path": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        }
      },
      "required": [
        "code",
        "path",
        "message",
        "severity"
      ],
      "additionalProperties": false
    },
    "Validation": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ValidationIssue"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "valid",
        "issues"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 2048
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "path",
                  "reason"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 1000
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "code",
            "message",
            "request_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "DatasetBinding": {
      "type": "object",
      "properties": {
        "logical_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^dataset:.+$"
        },
        "dataset_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "content_hash": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "unit": {
          "$ref": "common.schema.json#/$defs/TimeUnit"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "logical_ref",
        "dataset_version_id",
        "content_hash",
        "unit",
        "sample_count"
      ],
      "additionalProperties": false
    },
    "Duration": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 31536000000
        },
        "unit": {
          "$ref": "common.schema.json#/$defs/TimeUnit"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    }
  }
}
