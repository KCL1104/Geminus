{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin.example/spec/0.1/import.schema.json",
  "title": "import",
  "$comment": "SOURCE pp. 6–7,30,35–36. APPROVED D-009: commit freezes dataset and queues inference proposal, never mutates canonical Twin before human approval. APPROVED D-043 (T-016): profile is null until profiling completes; preview holds the first rows' raw values keyed by source column name.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/ImportID"
    },
    "organization_id": {
      "$ref": "common.schema.json#/$defs/OrganizationID"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/ProjectID"
    },
    "model_id": {
      "$ref": "common.schema.json#/$defs/ModelID"
    },
    "base_version_id": {
      "$ref": "common.schema.json#/$defs/ModelVersionID"
    },
    "kind": {
      "type": "string",
      "enum": [
        "csv_events",
        "json_events",
        "json_model"
      ]
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "status": {
      "type": "string",
      "enum": [
        "UPLOADED",
        "PROFILING",
        "AWAITING_MAPPING",
        "VALIDATED",
        "COMMITTED",
        "FAILED"
      ]
    },
    "mapping_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total_rows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "invalid_rows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/Profile"
        },
        {
          "type": "null"
        }
      ]
    },
    "preview": {
      "type": "array",
      "items": {
        "type": "object",
        "maxProperties": 256,
        "additionalProperties": true,
        "description": "UNTRUSTED_DATA (D-043): one source row's raw values keyed by source column name, in file order; CSV values are always strings, JSON event values are the raw JSON values. The server cuts strings longer than 256 characters to 255 characters and a final U+2026, and bounds the whole preview to 1 MiB, so it may hold fewer than 100 rows. A CSV row with too few fields lacks the missing columns; fields beyond the header are left out (the error report lists the row)."
      },
      "minItems": 0,
      "maxItems": 100
    },
    "mapping": {
      "anyOf": [
        {
          "$ref": "ai-mapping.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "validation": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Validation"
        },
        {
          "type": "null"
        }
      ]
    },
    "dataset_version_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/DatasetVersionID"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/ProposalID"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Error"
        },
        {
          "type": "null"
        }
      ]
    },
    "mapping_suggestion_status": {
      "type": "string",
      "enum": [
        "none",
        "generating",
        "ready",
        "failed"
      ]
    },
    "mapping_suggestion": {
      "anyOf": [
        {
          "$ref": "ai-mapping.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "organization_id",
    "project_id",
    "model_id",
    "base_version_id",
    "kind",
    "filename",
    "status",
    "mapping_revision",
    "total_rows",
    "invalid_rows",
    "profile",
    "preview",
    "mapping",
    "validation",
    "dataset_version_id",
    "proposal_id",
    "created_at",
    "error",
    "mapping_suggestion_status",
    "mapping_suggestion"
  ],
  "additionalProperties": false,
  "$defs": {
    "Profile": {
      "type": "object",
      "description": "D-043(a): the profile of the whole uploaded file, computed by the import_profile job. rows counts data rows (CSV records after the header, JSON events array elements; 0 for json_model). columns lists the source columns in file order: the CSV header, or the top-level member names of the JSON events in order of first appearance; empty for json_model.",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "json_events",
            "json_model"
          ]
        },
        "encoding": {
          "type": "string",
          "enum": [
            "utf-8",
            "utf-8-bom"
          ]
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProfileColumn"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "format",
        "encoding",
        "rows",
        "columns"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "format": {
            "const": "json_model"
          }
        },
        "required": [
          "format"
        ]
      },
      "then": {
        "properties": {
          "rows": {
            "const": 0
          },
          "columns": {
            "maxItems": 0
          }
        }
      }
    },
    "ProfileColumn": {
      "type": "object",
      "description": "One source column (D-043(a)). inferred is the one type all non-empty values share (integer and number together are number), empty when no value is non-empty, else mixed; JSON objects and arrays count as mixed. non_empty counts values that are present, not null and not the empty string; max_length is the longest value in characters (Unicode code points).",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "inferred": {
          "type": "string",
          "enum": [
            "empty",
            "boolean",
            "integer",
            "number",
            "timestamp",
            "string",
            "mixed"
          ]
        },
        "non_empty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "max_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        }
      },
      "required": [
        "name",
        "index",
        "inferred",
        "non_empty",
        "max_length"
      ],
      "additionalProperties": false
    }
  }
}
