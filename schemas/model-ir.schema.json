{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin.example/spec/0.1/model-ir.schema.json",
  "title": "model-ir",
  "$comment": "SOURCE pp. 14–18 node/flow/resource arrays preserved. PROPOSED D-005,D-014,D-017 complete closed-object P0 profile, delay_time, max_entities, optional domain attributes. JSON Schema does not enforce graph references or probability sums.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "model_id": {
      "$ref": "common.schema.json#/$defs/ModelID"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "time_unit": {
      "$ref": "common.schema.json#/$defs/ModelTimeUnit"
    },
    "entity_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "human",
              "machine",
              "generic"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "queue_discipline": {
            "const": "fifo"
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "capacity",
          "queue_discipline"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "source"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "domain_attributes": {
                "type": "object",
                "maxProperties": 64,
                "additionalProperties": true,
                "description": "UNTRUSTED_DATA；server 另外限制深度、字串長度及總 bytes。"
              },
              "entity_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "arrival": {
                "type": "object",
                "properties": {
                  "distribution": {
                    "$ref": "#/$defs/Distribution"
                  },
                  "max_entities": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  }
                },
                "required": [
                  "distribution"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "entity_type",
              "arrival"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "queue"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "domain_attributes": {
                "type": "object",
                "maxProperties": 64,
                "additionalProperties": true,
                "description": "UNTRUSTED_DATA；server 另外限制深度、字串長度及總 bytes。"
              }
            },
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "process"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "domain_attributes": {
                "type": "object",
                "maxProperties": 64,
                "additionalProperties": true,
                "description": "UNTRUSTED_DATA；server 另外限制深度、字串長度及總 bytes。"
              },
              "service_time": {
                "type": "object",
                "properties": {
                  "distribution": {
                    "$ref": "#/$defs/Distribution"
                  }
                },
                "required": [
                  "distribution"
                ],
                "additionalProperties": false
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "resource_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "units": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    }
                  },
                  "required": [
                    "resource_id",
                    "units"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 100
              }
            },
            "required": [
              "id",
              "type",
              "service_time",
              "requires"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "decision"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "domain_attributes": {
                "type": "object",
                "maxProperties": 64,
                "additionalProperties": true,
                "description": "UNTRUSTED_DATA；server 另外限制深度、字串長度及總 bytes。"
              }
            },
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "delay"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "domain_attributes": {
                "type": "object",
                "maxProperties": 64,
                "additionalProperties": true,
                "description": "UNTRUSTED_DATA；server 另外限制深度、字串長度及總 bytes。"
              },
              "delay_time": {
                "type": "object",
                "properties": {
                  "distribution": {
                    "$ref": "#/$defs/Distribution"
                  }
                },
                "required": [
                  "distribution"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "delay_time"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "sink"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "domain_attributes": {
                "type": "object",
                "maxProperties": 64,
                "additionalProperties": true,
                "description": "UNTRUSTED_DATA；server 另外限制深度、字串長度及總 bytes。"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "completed",
                  "abandoned"
                ]
              }
            },
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "failure"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "domain_attributes": {
                "type": "object",
                "maxProperties": 64,
                "additionalProperties": true,
                "description": "UNTRUSTED_DATA；server 另外限制深度、字串長度及總 bytes。"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "rework"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "domain_attributes": {
                "type": "object",
                "maxProperties": 64,
                "additionalProperties": true,
                "description": "UNTRUSTED_DATA；server 另外限制深度、字串長度及總 bytes。"
              }
            },
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 2,
      "maxItems": 500
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "routing": {
            "type": "object",
            "properties": {
              "type": {
                "const": "probability"
              },
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "type",
              "probability"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "routing"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "outgoing_probability_sum"
          },
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "equals": {
            "const": 1
          }
        },
        "required": [
          "type",
          "node_id",
          "equals"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "metrics": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "entity_cycle_time"
              }
            },
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "sink_throughput"
              },
              "sink_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "resource_utilization"
              },
              "resource_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "required": [
              "id",
              "type",
              "resource_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "queue_wait"
              },
              "node_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "required": [
              "id",
              "type",
              "node_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "failure_count"
              }
            },
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "type": {
                "const": "rework_count"
              }
            },
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "views": {
      "type": "object",
      "properties": {
        "2d": {
          "type": "object",
          "properties": {
            "positions": {
              "type": "object",
              "maxProperties": 500,
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "3d": {
          "type": "object",
          "properties": {
            "layout_mode": {
              "const": "derived_from_2d"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "2d",
        "3d"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true,
      "description": "UNTRUSTED_DATA；server 另外限制深度、字串長度及總 bytes。"
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "domain",
    "name",
    "time_unit",
    "entity_types",
    "resources",
    "nodes",
    "flows",
    "constraints",
    "metrics",
    "views"
  ],
  "additionalProperties": false,
  "$defs": {
    "Distribution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "constant"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "exponential"
            },
            "mean": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000000.0
            }
          },
          "required": [
            "type",
            "mean"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "triangular"
            },
            "min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0
            },
            "mode": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0
            }
          },
          "required": [
            "type",
            "min",
            "mode",
            "max"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "empirical"
            },
            "samples_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^dataset:[a-z0-9_.-]+$"
            }
          },
          "required": [
            "type",
            "samples_ref"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
