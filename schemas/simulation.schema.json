{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin.example/spec/0.1/simulation.schema.json",
  "title": "simulation",
  "$comment": "SOURCE pp. 21–22,33–35. PROPOSED D-005–D-007,D-010–D-011: frozen execution input, nullable evidence-aware stats, populations and resource limits. Numerical semantics are in SIMULATION_SPEC.md.",
  "$ref": "#/$defs/RunRequest",
  "$defs": {
    "RunConfig": {
      "type": "object",
      "properties": {
        "horizon": {
          "$ref": "common.schema.json#/$defs/Duration"
        },
        "warmup": {
          "$ref": "common.schema.json#/$defs/Duration"
        },
        "replications": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trace_level": {
          "type": "string",
          "enum": [
            "none",
            "sampled"
          ]
        }
      },
      "required": [
        "horizon",
        "warmup",
        "replications",
        "seed",
        "trace_level"
      ],
      "additionalProperties": false
    },
    "RunRequest": {
      "type": "object",
      "properties": {
        "model_version_id": {
          "$ref": "common.schema.json#/$defs/ModelVersionID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scenario_patch": {
          "$ref": "json-patch.schema.json"
        },
        "scenario_id": {
          "$ref": "common.schema.json#/$defs/ScenarioID"
        },
        "config": {
          "$ref": "#/$defs/RunConfig"
        }
      },
      "required": [
        "model_version_id",
        "name",
        "config"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "scenario_patch"
          ],
          "not": {
            "required": [
              "scenario_id"
            ]
          }
        },
        {
          "required": [
            "scenario_id"
          ],
          "not": {
            "required": [
              "scenario_patch"
            ]
          }
        }
      ]
    },
    "ExecutionLimits": {
      "type": "object",
      "properties": {
        "wall_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_events": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "max_active_entities": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_entity_visits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_trace_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "wall_timeout_seconds",
        "max_events",
        "max_active_entities",
        "max_entity_visits",
        "max_trace_events"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/RunID"
        },
        "organization_id": {
          "$ref": "common.schema.json#/$defs/OrganizationID"
        },
        "model_id": {
          "$ref": "common.schema.json#/$defs/ModelID"
        },
        "model_version_id": {
          "$ref": "common.schema.json#/$defs/ModelVersionID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scenario_patch": {
          "$ref": "json-patch.schema.json"
        },
        "scenario_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/ScenarioID"
            },
            {
              "type": "null"
            }
          ]
        },
        "config": {
          "$ref": "#/$defs/RunConfig"
        },
        "config_hash": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "model_hash": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effective_model_hash": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dataset_bindings": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/DatasetBinding"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "execution_limits": {
          "$ref": "#/$defs/ExecutionLimits"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "progress": {
          "type": "object",
          "properties": {
            "completed_replications": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "total_replications": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "events_processed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "completed_replications",
            "total_replications",
            "events_processed",
            "revision"
          ],
          "additionalProperties": false
        },
        "cancellation_requested": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Error"
            },
            {
              "type": "null"
            }
          ],
          "$comment": "details[0].code is the job failure code (CB-38(a): no catalogue yet; internal/storage/runs). ADR-026 D-050 adds SIMULATION_DEADLOCK (B1, circular wait) and SIMULATION_STALLED (B2, a bundle that can never be filled), recorded from T-047–T-050 and shown, like the execution limits, as MODEL_VALIDATION_FAILED (T-023 interim mapping; D-063 PROPOSED)."
        }
      },
      "required": [
        "id",
        "organization_id",
        "model_id",
        "model_version_id",
        "name",
        "scenario_patch",
        "scenario_id",
        "config",
        "config_hash",
        "model_hash",
        "effective_model_hash",
        "engine_version",
        "dataset_bindings",
        "execution_limits",
        "status",
        "progress",
        "cancellation_requested",
        "created_at",
        "started_at",
        "finished_at",
        "error"
      ],
      "additionalProperties": false
    },
    "MetricSummary": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "mean": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1000000000000000.0,
              "maximum": 1000000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "p50": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1000000000000000.0,
              "maximum": 1000000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "p95": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1000000000000000.0,
              "maximum": 1000000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "population": {
          "type": "string",
          "enum": [
            "replication",
            "entity",
            "stage_visit",
            "time_weighted"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "confidence_interval_mean": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "level": {
                  "const": 0.95
                },
                "lower": {
                  "type": "number",
                  "minimum": -1000000000000000.0,
                  "maximum": 1000000000000000.0
                },
                "upper": {
                  "type": "number",
                  "minimum": -1000000000000000.0,
                  "maximum": 1000000000000000.0
                },
                "method": {
                  "const": "student_t_replication_means"
                }
              },
              "required": [
                "level",
                "lower",
                "upper",
                "method"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "mean",
        "p50",
        "p95",
        "sample_count",
        "population",
        "unit",
        "confidence_interval_mean",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "mean": {
                "type": "null"
              },
              "p50": {
                "type": "null"
              },
              "p95": {
                "type": "null"
              },
              "confidence_interval_mean": {
                "type": "null"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "mean": {
                "type": "number"
              },
              "p50": {
                "type": "number"
              },
              "p95": {
                "type": "number"
              },
              "sample_count": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "population": {
                "enum": [
                  "entity",
                  "stage_visit",
                  "time_weighted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "confidence_interval_mean": {
                "type": "null"
              }
            }
          }
        }
      ],
      "$comment": "T-022/CB-23: an unavailable summary carries a reason; only population=replication may carry a CI (SIMULATION_SPEC §5)."
    },
    "Result": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "common.schema.json#/$defs/RunID"
        },
        "status": {
          "const": "completed"
        },
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "metrics": {
          "type": "object",
          "properties": {
            "throughput": {
              "$ref": "#/$defs/MetricSummary"
            },
            "lead_time_minutes": {
              "$ref": "#/$defs/MetricSummary"
            },
            "resources": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "utilization_mean": {
                    "$comment": "D-052 (i), D-084 (T-049): the denominator is C·T over the window, off-shift and down time included, for every resource; a resource on a calendar has its scheduled utilization in replication_summaries[].resource_states (scheduled_in_use_ticks / scheduled_ticks) and its overtime there (overtime_ticks).",
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "observation_ticks": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "capacity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "utilization_mean",
                  "observation_ticks",
                  "capacity",
                  "reason"
                ],
                "additionalProperties": false,
                "$comment": "T-022 review (CB-23): a null utilization carries a reason.",
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "utilization_mean": {
                          "type": "null"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "reason": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "queues": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "available",
                      "unavailable"
                    ]
                  },
                  "wait_mean_minutes": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000000000.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "wait_p50_minutes": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000000000.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "wait_p95_minutes": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000000000.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "queue_length_mean": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000000.0
                  },
                  "sample_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "status",
                  "wait_mean_minutes",
                  "wait_p50_minutes",
                  "wait_p95_minutes",
                  "queue_length_mean",
                  "sample_count",
                  "reason"
                ],
                "additionalProperties": false,
                "$comment": "T-022 review (CB-23): an unavailable queue has null waits and a reason; an available one has waits and at least one sample.",
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "unavailable"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "wait_mean_minutes": {
                          "type": "null"
                        },
                        "wait_p50_minutes": {
                          "type": "null"
                        },
                        "wait_p95_minutes": {
                          "type": "null"
                        },
                        "reason": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "available"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "wait_mean_minutes": {
                          "type": "number"
                        },
                        "wait_p50_minutes": {
                          "type": "number"
                        },
                        "wait_p95_minutes": {
                          "type": "number"
                        },
                        "sample_count": {
                          "minimum": 1
                        }
                      }
                    }
                  }
                ]
              }
            },
            "failure_count": {
              "$ref": "#/$defs/MetricSummary"
            },
            "rework_count": {
              "$ref": "#/$defs/MetricSummary"
            },
            "dora": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/MetricSummary"
              }
            },
            "additional_metrics": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/MetricSummary"
              }
            },
            "domain": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/MetricSummary"
              },
              "minProperties": 1,
              "$comment": "D-058: a DomainPack ModelMetricsProvider’s metrics; absent when the pack has none. metrics.dora is unchanged."
            }
          },
          "required": [
            "throughput",
            "lead_time_minutes",
            "resources",
            "queues",
            "failure_count",
            "rework_count",
            "dora",
            "additional_metrics"
          ],
          "additionalProperties": false
        },
        "replication_summaries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "replication_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 999
              },
              "completed_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mean_lead_time_minutes": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000000.0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resource_utilization": {
                "$comment": "∫in_use / (C·T) of each resource over the window, off-shift and down time included (D-052 (i), D-084); the scheduled utilization of a resource on a calendar is resource_states' scheduled_in_use_ticks / scheduled_ticks.",
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "failures": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reworks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "censored_entities": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "resource_states": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/ResourceState"
                },
                "minProperties": 1,
                "$comment": "D-058: per resource, only for resources a line-flow feature applies to."
              },
              "blocking": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/NodeBlocking"
                },
                "minProperties": 1,
                "$comment": "D-049/D-058: per node that can be blocked, when the model has a finite buffer."
              },
              "buffers": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/BufferState"
                },
                "minProperties": 1,
                "$comment": "D-049: per finite buffer (the explicit queue that declares capacity)."
              },
              "batches": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/BatchCounts"
                },
                "minProperties": 1,
                "$comment": "D-054/D-058: per batch process."
              },
              "declared": {
                "type": "object",
                "minProperties": 1,
                "$comment": "D-058: the value of each declared metric (IR metrics[] system_wip, flow_count, sink_count, period_throughput) in this replication; null when unavailable (period_throughput over a window that is not whole periods).",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000000000000.0
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "maxItems": 1000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": [
              "replication_index",
              "completed_count",
              "mean_lead_time_minutes",
              "resource_utilization",
              "failures",
              "reworks",
              "censored_entities"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "measurement_window": {
          "type": "object",
          "properties": {
            "tick_unit": {
              "const": "millisecond"
            },
            "warmup_ticks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "horizon_ticks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "time_boundary": {
              "const": "warmup <= t <= horizon"
            }
          },
          "required": [
            "tick_unit",
            "warmup_ticks",
            "horizon_ticks",
            "time_boundary"
          ],
          "additionalProperties": false
        },
        "reproducibility": {
          "type": "object",
          "properties": {
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "replications": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "model_hash": {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "effective_model_hash": {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "config_hash": {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "dataset_manifest_hash": {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "result_digest": {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "seed",
            "replications",
            "model_hash",
            "effective_model_hash",
            "config_hash",
            "dataset_manifest_hash",
            "result_digest"
          ],
          "additionalProperties": false
        },
        "trace": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "sampled_events": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "artifact_id": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/ArtifactID"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "available",
            "sampled_events",
            "artifact_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "status",
        "engine_version",
        "metrics",
        "replication_summaries",
        "measurement_window",
        "reproducibility",
        "trace"
      ],
      "additionalProperties": false
    },
    "TraceEvent": {
      "type": "object",
      "$comment": "T-022: one fact about a sampled entity, in engine event order (SIMULATION_SPEC §9). sequence is the engine event during which it happened; several trace events can share one. ADR-026: blocked/unblocked (D-049, at the node the entity is blocked in), setup_start (D-055, with the resource changing over) and batch_id on a batch member’s service_start/service_end (D-054, r<rep>/<process>/b<n>).",
      "properties": {
        "time_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000000
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "enum": [
            "arrival",
            "queue_enter",
            "service_start",
            "service_end",
            "delay_start",
            "delay_end",
            "failure",
            "rework",
            "complete",
            "abandon",
            "blocked",
            "unblocked",
            "setup_start"
          ]
        },
        "entity_id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 150,
          "pattern": "^r(0|[1-9][0-9]{0,2})/[A-Za-z][A-Za-z0-9_.:-]{0,127}/[1-9][0-9]{0,15}$"
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "batch_id": {
          "type": "string",
          "minLength": 6,
          "maxLength": 151,
          "pattern": "^r(0|[1-9][0-9]{0,2})/[A-Za-z][A-Za-z0-9_.:-]{0,127}/b[1-9][0-9]{0,15}$"
        }
      },
      "required": [
        "time_tick",
        "sequence",
        "type",
        "entity_id",
        "node_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "setup_start"
              }
            }
          },
          "then": {
            "required": [
              "resource_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "setup_start"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "resource_id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "enum": [
                    "service_start",
                    "service_end"
                  ]
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "batch_id"
              ]
            }
          }
        }
      ]
    },
    "TraceArtifact": {
      "type": "object",
      "$comment": "T-022 (D-039, approved 2026-10-18): the sampled playback trace of one run, stored as a private object (Result.trace.artifact_id). It is not part of result_digest and never changes metrics.",
      "properties": {
        "format": {
          "const": "geminus.trace.v1"
        },
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "replication_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "sampling": {
          "type": "object",
          "properties": {
            "method": {
              "const": "entity_id_sha256"
            },
            "rate": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "max_events": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          "required": [
            "method",
            "rate",
            "max_events"
          ],
          "additionalProperties": false
        },
        "truncated": {
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/TraceEvent"
          },
          "$comment": "Engine processing order: by time_tick, then event priority, then sequence. sequence alone is not monotonic within a tick; consumers keep the array order."
        }
      },
      "required": [
        "format",
        "engine_version",
        "replication_index",
        "sampling",
        "truncated",
        "events"
      ],
      "additionalProperties": false
    },
    "ResourceState": {
      "type": "object",
      "properties": {
        "in_use_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blocked_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "setup_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "setups_started": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "setups_completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completed_setup_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "down_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "breakdowns_started": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "repairs_completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completed_repair_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scheduled_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scheduled_in_use_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overtime_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "available_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "idle_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scheduled_processing_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "in_use_ticks",
        "scheduled_processing_ticks"
      ],
      "additionalProperties": false,
      "$comment": "D-058 (ELECTRONICS_LINE §5): integer-tick integrals and counts over [W, H] of one resource in one replication. A member group is present when its feature applies to the resource: blocked_ticks (the model has a finite buffer), setup_* (setups), down_ticks and the breakdown counts (breakdowns), scheduled_* and overtime_ticks (a calendar), available_ticks and idle_ticks (breakdowns or a calendar); in_use_ticks and scheduled_processing_ticks always. A resource no feature applies to is not listed.",
      "dependentRequired": {
        "setup_ticks": [
          "setups_started",
          "setups_completed",
          "completed_setup_ticks"
        ],
        "setups_started": [
          "setup_ticks",
          "setups_completed",
          "completed_setup_ticks"
        ],
        "setups_completed": [
          "setup_ticks",
          "setups_started",
          "completed_setup_ticks"
        ],
        "completed_setup_ticks": [
          "setup_ticks",
          "setups_started",
          "setups_completed"
        ],
        "down_ticks": [
          "breakdowns_started",
          "repairs_completed",
          "completed_repair_ticks",
          "available_ticks"
        ],
        "breakdowns_started": [
          "down_ticks",
          "repairs_completed",
          "completed_repair_ticks"
        ],
        "repairs_completed": [
          "down_ticks",
          "breakdowns_started",
          "completed_repair_ticks"
        ],
        "completed_repair_ticks": [
          "down_ticks",
          "breakdowns_started",
          "repairs_completed"
        ],
        "scheduled_ticks": [
          "scheduled_in_use_ticks",
          "overtime_ticks",
          "available_ticks"
        ],
        "scheduled_in_use_ticks": [
          "scheduled_ticks",
          "overtime_ticks"
        ],
        "overtime_ticks": [
          "scheduled_ticks",
          "scheduled_in_use_ticks"
        ],
        "available_ticks": [
          "idle_ticks"
        ],
        "idle_ticks": [
          "available_ticks"
        ]
      },
      "anyOf": [
        {
          "required": [
            "blocked_ticks"
          ]
        },
        {
          "required": [
            "setup_ticks"
          ]
        },
        {
          "required": [
            "down_ticks"
          ]
        },
        {
          "required": [
            "scheduled_ticks"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "available_ticks"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "down_ticks"
                ]
              },
              {
                "required": [
                  "scheduled_ticks"
                ]
              }
            ]
          }
        }
      ]
    },
    "NodeBlocking": {
      "type": "object",
      "properties": {
        "blocks_started": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blocks_completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completed_block_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blocked_entity_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "blocks_started",
        "blocks_completed",
        "completed_block_ticks",
        "blocked_entity_ticks"
      ],
      "additionalProperties": false,
      "$comment": "D-049/D-058: blocks that started in [W, H], complete blocks (start >= W, end <= H) and their ticks, and the integral of the number of blocked entities."
    },
    "BufferState": {
      "type": "object",
      "properties": {
        "full_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "full_ticks"
      ],
      "additionalProperties": false,
      "$comment": "D-049: ticks in [W, H] at which the buffer held capacity waiting entities."
    },
    "BatchCounts": {
      "type": "object",
      "properties": {
        "batches_started": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "members_started": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "batches_started",
        "members_started"
      ],
      "additionalProperties": false,
      "$comment": "D-054/D-058: batches started in [W, H] and their members."
    }
  }
}
