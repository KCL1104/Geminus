{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin.example/spec/0.1/ai-mapping.schema.json",
  "title": "ai-mapping",
  "$comment": "SOURCE pp. 6,25. An AI's read-only mapping suggestion (T-027), kept apart from the mapping a person confirms (import-mapping.schema.json, APPROVED D-043 (c)); it is never applied without a person's saveImportMapping, and an entry that requires confirmation is confirmed there by name (D-070 PROPOSED). The target fields and transforms are import-mapping.schema.json's: D-009's bounded transform enum, never arbitrary expressions, scripts or shell.",
  "type": "object",
  "properties": {
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_column": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "target_field": {
            "anyOf": [
              {
                "$ref": "import-mapping.schema.json#/$defs/TargetField"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "transform": {
            "$ref": "import-mapping.schema.json#/$defs/Transform"
          },
          "requires_confirmation": {
            "type": "boolean"
          }
        },
        "required": [
          "source_column",
          "target_field",
          "confidence",
          "evidence",
          "transform",
          "requires_confirmation"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "confidence": {
                  "exclusiveMaximum": 0.8
                }
              },
              "required": [
                "confidence"
              ]
            },
            "then": {
              "properties": {
                "requires_confirmation": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target_field": {
                  "type": "null"
                }
              },
              "required": [
                "target_field"
              ]
            },
            "then": {
              "properties": {
                "requires_confirmation": {
                  "const": true
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "mappings"
  ],
  "additionalProperties": false
}
