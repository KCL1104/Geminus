{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin.example/spec/0.1/proposal.schema.json",
  "title": "proposal",
  "$comment": "SOURCE pp. 24–25,32–33. PROPOSED D-001,D-002,D-004 states and mode-dependent effect. This is a server response, not a client write body. D-027: risk_level = max(server_risk_level, provider_risk_claim). T-026 (D-068 APPROVED): a decided proposal carries decided_by, decided_at and an optional decision_comment. T-056 (H-033): a proposal asked for with a photo carries source_image and is an edit. H-046 (2): a proposal asked for with research on carries generated_by.web_search, and sources when the AI named pages the call opened.",
  "type": "object",
  "properties": {
    "proposal_id": {
      "$ref": "common.schema.json#/$defs/ProposalID"
    },
    "organization_id": {
      "$ref": "common.schema.json#/$defs/OrganizationID"
    },
    "model_id": {
      "$ref": "common.schema.json#/$defs/ModelID"
    },
    "base_version_id": {
      "$ref": "common.schema.json#/$defs/ModelVersionID"
    },
    "mode": {
      "type": "string",
      "enum": [
        "edit",
        "scenario"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "generating",
        "needs_input",
        "ready",
        "invalid",
        "failed",
        "approved",
        "rejected",
        "conflicted"
      ]
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/UserID"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "requires_confirmation": {
      "const": true
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 0,
      "maxItems": 100
    },
    "risk_level": {
      "$ref": "common.schema.json#/$defs/RiskLevel",
      "description": "Effective risk = max(server_risk_level, provider_risk_claim) (D-027)."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "changes": {
      "$ref": "json-patch.schema.json"
    },
    "expected_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 0,
      "maxItems": 100
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "maxItems": 50
    },
    "validation": {
      "$ref": "common.schema.json#/$defs/Validation"
    },
    "new_version_id": {
      "$ref": "common.schema.json#/$defs/ModelVersionID"
    },
    "scenario_id": {
      "$ref": "common.schema.json#/$defs/ScenarioID"
    },
    "patch_hash": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "error": {
      "$ref": "common.schema.json#/$defs/Error"
    },
    "dataset_bindings": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/DatasetBinding"
      },
      "maxItems": 1000
    },
    "server_risk_level": {
      "$ref": "common.schema.json#/$defs/RiskLevel",
      "description": "Risk computed by the server policy (D-016)."
    },
    "provider_risk_claim": {
      "$ref": "common.schema.json#/$defs/RiskLevel",
      "description": "The provider output's risk_level, kept as an untrusted claim."
    },
    "decided_by": {
      "$ref": "common.schema.json#/$defs/UserID",
      "description": "T-026 (D-068 APPROVED): the person whose approve or reject request decided the proposal, or whose approve request found that its base was no longer the model's latest (conflicted). Bound by the server from the verified caller."
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "description": "T-026 (D-068 APPROVED): when the decision committed (the database's time)."
    },
    "decision_comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "T-026 (D-068 APPROVED): the Approve or Reject comment as given; absent when there was none (or it was empty). The person's text: never in audit metadata."
    },
    "source_image": {
      "type": "object",
      "description": "T-056 (H-033): the photo or floor plan the proposal was asked for with (createImageProposal), as the server stored it: the PNG or JPEG it decoded and encoded again, so no EXIF or other metadata of the upload is stored or sent to a provider; its size in pixels and bytes and the SHA-256 of the stored bytes. Absent for a proposal asked for in words. The image itself is never served back, and nothing the AI saw in it is a fact the server checked: its stations and flow are the AI's proposal, reviewed like any other.",
      "properties": {
        "media_type": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        },
        "content_hash": {
          "$ref": "common.schema.json#/$defs/Hash"
        }
      },
      "required": [
        "media_type",
        "width",
        "height",
        "size_bytes",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "generated_by": {
      "$ref": "common.schema.json#/$defs/GeneratedBy"
    },
    "sources": {
      "type": "array",
      "description": "H-046 (2): the web pages the AI said it relied on, kept by the server only when this call opened them (common.schema.json#/$defs/WebSource), in the answer's order, at most 20. Present only with generated_by.web_search, and only in the states that keep what the provider wrote (needs_input, ready, approved, rejected, conflicted): never while generating, for an invalid or a failed proposal.",
      "items": {
        "$ref": "common.schema.json#/$defs/WebSource"
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "proposal_id",
    "organization_id",
    "model_id",
    "base_version_id",
    "mode",
    "status",
    "created_by",
    "created_at",
    "requires_confirmation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "approved"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "summary",
          "assumptions",
          "risk_level",
          "provider_risk_claim",
          "server_risk_level",
          "confidence",
          "changes",
          "expected_effects",
          "validation",
          "patch_hash"
        ],
        "properties": {
          "changes": {
            "minItems": 1
          },
          "validation": {
            "properties": {
              "valid": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_input"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "questions"
        ],
        "not": {
          "required": [
            "changes"
          ]
        }
      }
    },
    {
      "$comment": "T-025 (D-062 (c) PROPOSED; H-003 review L2): an invalid proposal keeps its failed validation and nothing generated, nothing the provider wrote; only a failed one has an error.",
      "if": {
        "properties": {
          "status": {
            "const": "invalid"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "validation"
        ],
        "properties": {
          "validation": {
            "properties": {
              "valid": {
                "const": false
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "summary"
              ]
            },
            {
              "required": [
                "assumptions"
              ]
            },
            {
              "required": [
                "risk_level"
              ]
            },
            {
              "required": [
                "confidence"
              ]
            },
            {
              "required": [
                "changes"
              ]
            },
            {
              "required": [
                "expected_effects"
              ]
            },
            {
              "required": [
                "questions"
              ]
            },
            {
              "required": [
                "patch_hash"
              ]
            },
            {
              "required": [
                "dataset_bindings"
              ]
            },
            {
              "required": [
                "server_risk_level"
              ]
            },
            {
              "required": [
                "provider_risk_claim"
              ]
            },
            {
              "required": [
                "sources"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "$comment": "T-025 (D-062 (c) PROPOSED; H-003 review L2): a failed proposal holds its error and nothing generated, as migration 0012 holds its row.",
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "summary"
              ]
            },
            {
              "required": [
                "assumptions"
              ]
            },
            {
              "required": [
                "risk_level"
              ]
            },
            {
              "required": [
                "confidence"
              ]
            },
            {
              "required": [
                "changes"
              ]
            },
            {
              "required": [
                "expected_effects"
              ]
            },
            {
              "required": [
                "questions"
              ]
            },
            {
              "required": [
                "validation"
              ]
            },
            {
              "required": [
                "patch_hash"
              ]
            },
            {
              "required": [
                "dataset_bindings"
              ]
            },
            {
              "required": [
                "server_risk_level"
              ]
            },
            {
              "required": [
                "provider_risk_claim"
              ]
            },
            {
              "required": [
                "sources"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          },
          "mode": {
            "const": "edit"
          }
        },
        "required": [
          "status",
          "mode"
        ]
      },
      "then": {
        "required": [
          "new_version_id"
        ],
        "not": {
          "required": [
            "scenario_id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          },
          "mode": {
            "const": "scenario"
          }
        },
        "required": [
          "status",
          "mode"
        ]
      },
      "then": {
        "required": [
          "scenario_id"
        ],
        "not": {
          "required": [
            "new_version_id"
          ]
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "required": [
              "server_risk_level",
              "provider_risk_claim",
              "risk_level"
            ]
          },
          {
            "anyOf": [
              {
                "properties": {
                  "server_risk_level": {
                    "const": "high"
                  }
                },
                "required": [
                  "server_risk_level"
                ]
              },
              {
                "properties": {
                  "provider_risk_claim": {
                    "const": "high"
                  }
                },
                "required": [
                  "provider_risk_claim"
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "risk_level": {
            "const": "high"
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "required": [
              "server_risk_level",
              "provider_risk_claim",
              "risk_level"
            ]
          },
          {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "server_risk_level": {
                      "const": "high"
                    }
                  },
                  "required": [
                    "server_risk_level"
                  ]
                },
                {
                  "properties": {
                    "provider_risk_claim": {
                      "const": "high"
                    }
                  },
                  "required": [
                    "provider_risk_claim"
                  ]
                }
              ]
            }
          },
          {
            "anyOf": [
              {
                "properties": {
                  "server_risk_level": {
                    "const": "medium"
                  }
                },
                "required": [
                  "server_risk_level"
                ]
              },
              {
                "properties": {
                  "provider_risk_claim": {
                    "const": "medium"
                  }
                },
                "required": [
                  "provider_risk_claim"
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "risk_level": {
            "const": "medium"
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "required": [
              "server_risk_level",
              "provider_risk_claim",
              "risk_level"
            ]
          },
          {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "server_risk_level": {
                      "const": "high"
                    }
                  },
                  "required": [
                    "server_risk_level"
                  ]
                },
                {
                  "properties": {
                    "provider_risk_claim": {
                      "const": "high"
                    }
                  },
                  "required": [
                    "provider_risk_claim"
                  ]
                }
              ]
            }
          },
          {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "server_risk_level": {
                      "const": "medium"
                    }
                  },
                  "required": [
                    "server_risk_level"
                  ]
                },
                {
                  "properties": {
                    "provider_risk_claim": {
                      "const": "medium"
                    }
                  },
                  "required": [
                    "provider_risk_claim"
                  ]
                }
              ]
            }
          }
        ]
      },
      "then": {
        "properties": {
          "risk_level": {
            "const": "low"
          }
        }
      }
    },
    {
      "$comment": "T-026 (D-068 APPROVED): a decided proposal names who decided it and when; no other state has a decision record (migrations 0001, 0013).",
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "rejected",
              "conflicted"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "decided_by",
          "decided_at"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "decided_by"
              ]
            },
            {
              "required": [
                "decided_at"
              ]
            },
            {
              "required": [
                "decision_comment"
              ]
            }
          ]
        }
      }
    },
    {
      "$comment": "T-026 (D-068 APPROVED): a conflicted proposal has no comment: the approval that found the base moved decided nothing but the state.",
      "if": {
        "properties": {
          "status": {
            "const": "conflicted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "decision_comment"
          ]
        }
      }
    },
    {
      "$comment": "T-056 (H-033): a photo proposal adds steps to the model, so it is an edit; a scenario never comes from a photo.",
      "if": {
        "required": [
          "source_image"
        ]
      },
      "then": {
        "properties": {
          "mode": {
            "const": "edit"
          }
        }
      }
    },
    {
      "$comment": "H-046 (2): sources come only from a call that ran with research on.",
      "if": {
        "required": [
          "sources"
        ]
      },
      "then": {
        "required": [
          "generated_by"
        ],
        "properties": {
          "generated_by": {
            "required": [
              "web_search"
            ]
          }
        }
      }
    },
    {
      "$comment": "H-046 (2): a proposal being generated holds only what the server bound.",
      "if": {
        "properties": {
          "status": {
            "const": "generating"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "sources"
          ]
        }
      }
    }
  ]
}
