{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker",
    "watchPatterns": ["/cmd/**", "/internal/**", "/schemas/**", "/prompts/**", "/go.mod", "/go.sum", "/Dockerfile.worker", "/.dockerignore"]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "drainingSeconds": 30,
    "numReplicas": 1,
    "multiRegionConfig": {"us-east4-eqdc4a": {"numReplicas": 1}, "asia-southeast1-eqsg3a": null, "us-west2": null}
  }
}
