{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.api",
    "watchPatterns": ["/migrations/**", "/cmd/migrate/**", "/internal/storage/migrations/**", "/Dockerfile.api", "/.dockerignore"]
  },
  "deploy": {
    "startCommand": "/usr/local/bin/geminus-migrate -dir /migrations up",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
