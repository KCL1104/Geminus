{
  "about": "Railway service variables of the hackathon deployment (T-039; H-031: Railway only; H-032: the coordinator applies them with deploy/railway/deploy.sh). 'value' is set as written after the script fills {{INPUT}} (an environment variable of the run, see deploy.sh --help), {{bucket:field}} (the bucket's S3 credentials) and {{seed:organization_id}} (cmd/provision-tenant's output); ${{...}} are Railway reference variables, kept as written. 'secret': true has no value here: 'source' says where it comes from: 'generated' (made by the script with Python's secrets module, piped to the CLI on stdin, never printed, then sealed), 'bucket:<field>' (copied from the bucket's credentials on stdin, then sealed), 'auth0' (T-057, H-034: the Auth0 step writes the Auth0 application's client secret from the Auth0 CLI's JSON on stdin and seals it; with GEMINUS_AUTH0_SETUP=manual the owner fills it as an 'owner' variable; its value is never kept either) or 'owner' (the owner enters it in Railway's UI and seals it if it is secret; the script never sets it: the CLI's variable listing returns every unsealed value, and the script drops the owner's on receipt, keeps only the name, checks that it exists where 'required' is true and names the owner's secrets that are not sealed). 'when': 'absent' is set only if the service does not have it yet (the owner may change it). scripts/check_deploy.py checks this file against the code and the rules of docs/runbooks/deploy.md (no AI key on the API, whose AI settings are the worker's (T-053 I5), no database on the web, no test-only AI provider or local file storage, secrets without values).",
  "bucket": "geminus-objects",
  "database": "Postgres",
  "services": {
    "migrate": {
      "config": "deploy/railway/migrate.railway.json",
      "variables": {
        "GEMINUS_MIGRATOR_DB_PASSWORD": {"secret": true, "source": "generated", "login": "geminus_migrator"},
        "GEMINUS_MIGRATE_DATABASE_URL": {"value": "postgresql://geminus_migrator:${{GEMINUS_MIGRATOR_DB_PASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}"}
      }
    },
    "api": {
      "config": "deploy/railway/api.railway.json",
      "public_domain": {"port": 8080},
      "variables": {
        "APP_ENV": {"value": "production"},
        "PORT": {"value": "8080"},
        "API_LISTEN_ADDR": {"value": ":8080"},
        "GEMINUS_API_DB_PASSWORD": {"secret": true, "source": "generated", "login": "geminus_api"},
        "DATABASE_URL": {"value": "postgresql://geminus_api:${{GEMINUS_API_DB_PASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}"},
        "AUTH_OIDC_ISSUER": {"value": "{{GEMINUS_AUTH0_ISSUER}}"},
        "AUTH_OIDC_AUDIENCE": {"value": "{{GEMINUS_AUTH0_AUDIENCE}}"},
        "AUTH_OIDC_JWKS_URL": {"value": "{{GEMINUS_AUTH0_ISSUER}}.well-known/jwks.json"},
        "AUTH_OIDC_REQUIRE_AT_JWT": {"value": "true"},
        "OBJECT_STORAGE_PROVIDER": {"value": "s3"},
        "OBJECT_STORAGE_S3_ENDPOINT": {"value": "{{bucket:endpoint}}"},
        "OBJECT_STORAGE_S3_BUCKET": {"value": "{{bucket:bucketName}}"},
        "OBJECT_STORAGE_S3_REGION": {"value": "{{bucket:region}}"},
        "OBJECT_STORAGE_S3_URL_STYLE": {"value": "{{bucket:urlStyle}}"},
        "OBJECT_STORAGE_S3_ACCESS_KEY_ID": {"secret": true, "source": "bucket:accessKeyId"},
        "OBJECT_STORAGE_S3_SECRET_ACCESS_KEY": {"secret": true, "source": "bucket:secretAccessKey"},
        "AI_PROVIDER": {"value": "disabled", "when": "absent", "later": "the owner sets the worker's AI_PROVIDER, AI_POLICY_APPROVAL, AI_MODEL and GEMINUS_AI_LIVE here too, and its photo path's AI_VISION_PROVIDER, AI_VISION_POLICY_APPROVAL and AI_VISION_MODEL: the API accepts proposals and photos from these settings alone and never holds a key (T-053 I5, D-124, docs/runbooks/deploy.md §4.4); otherwise they are refused with 503"},
        "AI_POLICY_APPROVAL": {"secret": false, "source": "owner", "required": false},
        "AI_MODEL": {"secret": false, "source": "owner", "required": false},
        "GEMINUS_AI_LIVE": {"secret": false, "source": "owner", "required": false},
        "AI_VISION_PROVIDER": {"secret": false, "source": "owner", "required": false},
        "AI_VISION_POLICY_APPROVAL": {"secret": false, "source": "owner", "required": false},
        "AI_VISION_MODEL": {"secret": false, "source": "owner", "required": false}
      },
      "forbidden": ["GEMINUS_ANTHROPIC_API_KEY_A", "GEMINUS_ANTHROPIC_API_KEY_B", "GEMINUS_MUSE_API_KEY", "GEMINUS_META_API_KEY", "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN", "AI_API_KEY", "MODEL_API_KEY",
        "GEMINUS_MIGRATE_DATABASE_URL", "GEMINUS_MIGRATOR_DB_PASSWORD", "GEMINUS_PROVISION_DATABASE_URL", "GEMINUS_WORKER_DB_PASSWORD",
        "BFF_OIDC_CLIENT_SECRET", "SESSION_KEYS", "GEMINUS_UI_GALLERY"]
    },
    "worker": {
      "config": "deploy/railway/worker.railway.json",
      "variables": {
        "APP_ENV": {"value": "production"},
        "GEMINUS_WORKER_DB_PASSWORD": {"secret": true, "source": "generated", "login": "geminus_worker"},
        "DATABASE_URL": {"value": "postgresql://geminus_worker:${{GEMINUS_WORKER_DB_PASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}"},
        "WORKER_ID": {"value": "railway-worker-1"},
        "AI_MAX_PROMPT_BYTES": {"value": "262144", "about": "T-030 (2026-10-28): an analysis of the electronics template's two runs with their comparison is about 127 KB of the 128 KiB default; 256 KiB leaves room for a station the AI adds and a long question (cap 512 KiB, provider.BudgetCaps; spend stays under D-110's daily limits)"},
        "WORKER_ORGANIZATION_IDS": {"value": "{{seed:organization_id}}", "when": "absent"},
        "OBJECT_STORAGE_PROVIDER": {"value": "s3"},
        "OBJECT_STORAGE_S3_ENDPOINT": {"value": "{{bucket:endpoint}}"},
        "OBJECT_STORAGE_S3_BUCKET": {"value": "{{bucket:bucketName}}"},
        "OBJECT_STORAGE_S3_REGION": {"value": "{{bucket:region}}"},
        "OBJECT_STORAGE_S3_URL_STYLE": {"value": "{{bucket:urlStyle}}"},
        "OBJECT_STORAGE_S3_ACCESS_KEY_ID": {"secret": true, "source": "bucket:accessKeyId"},
        "OBJECT_STORAGE_S3_SECRET_ACCESS_KEY": {"secret": true, "source": "bucket:secretAccessKey"},
        "AI_PROVIDER": {"value": "disabled", "when": "absent", "later": "the owner may set anthropic or meta (T-055) with AI_POLICY_APPROVAL and AI_MODEL, and AI_VISION_PROVIDER (with AI_VISION_POLICY_APPROVAL and AI_VISION_MODEL for another provider) for the photo path; live stays off unless the owner also sets GEMINUS_AI_LIVE=on and the keys; the API's seven AI settings are these (T-053 I5, D-124)"},
        "AI_POLICY_APPROVAL": {"secret": false, "source": "owner", "required": false},
        "AI_MODEL": {"secret": false, "source": "owner", "required": false},
        "GEMINUS_AI_LIVE": {"secret": false, "source": "owner", "required": false},
        "AI_VISION_PROVIDER": {"secret": false, "source": "owner", "required": false},
        "AI_VISION_POLICY_APPROVAL": {"secret": false, "source": "owner", "required": false},
        "AI_VISION_MODEL": {"secret": false, "source": "owner", "required": false},
        "GEMINUS_ANTHROPIC_API_KEY_A": {"secret": true, "source": "owner", "required": false},
        "GEMINUS_ANTHROPIC_API_KEY_B": {"secret": true, "source": "owner", "required": false},
        "GEMINUS_MUSE_API_KEY": {"secret": true, "source": "owner", "required": false}
      },
      "forbidden": ["GEMINUS_MIGRATE_DATABASE_URL", "GEMINUS_MIGRATOR_DB_PASSWORD", "GEMINUS_PROVISION_DATABASE_URL", "GEMINUS_API_DB_PASSWORD",
        "BFF_OIDC_CLIENT_SECRET", "SESSION_KEYS", "AI_API_KEY", "GEMINUS_UI_GALLERY"]
    },
    "web": {
      "config": "deploy/railway/web.railway.json",
      "public_domain": {"port": 3000},
      "variables": {
        "PORT": {"value": "3000"},
        "HOSTNAME": {"value": "0.0.0.0"},
        "BFF_APP_ORIGIN": {"value": "https://${{RAILWAY_PUBLIC_DOMAIN}}"},
        "BFF_API_URL": {"value": "https://${{api.RAILWAY_PUBLIC_DOMAIN}}"},
        "BFF_OIDC_ISSUER": {"value": "{{GEMINUS_AUTH0_ISSUER}}"},
        "BFF_OIDC_AUTHORIZATION_URL": {"value": "{{GEMINUS_AUTH0_ISSUER}}authorize"},
        "BFF_OIDC_TOKEN_URL": {"value": "{{GEMINUS_AUTH0_ISSUER}}oauth/token"},
        "BFF_OIDC_REVOCATION_URL": {"value": "{{GEMINUS_AUTH0_ISSUER}}oauth/revoke"},
        "BFF_OIDC_END_SESSION_URL": {"value": "{{GEMINUS_AUTH0_ISSUER}}oidc/logout"},
        "BFF_OIDC_JWKS_URL": {"value": "{{GEMINUS_AUTH0_ISSUER}}.well-known/jwks.json"},
        "BFF_OIDC_CLIENT_ID": {"value": "{{GEMINUS_AUTH0_CLIENT_ID}}"},
        "BFF_OIDC_AUDIENCE": {"value": "{{GEMINUS_AUTH0_AUDIENCE}}"},
        "BFF_OIDC_CLIENT_SECRET": {"secret": true, "source": "auth0", "required": true},
        "SESSION_KEYS": {"secret": true, "source": "generated", "format": "session-key"}
      },
      "forbidden": ["DATABASE_URL", "GEMINUS_API_DB_PASSWORD", "GEMINUS_WORKER_DB_PASSWORD", "GEMINUS_MIGRATOR_DB_PASSWORD",
        "GEMINUS_MIGRATE_DATABASE_URL", "GEMINUS_PROVISION_DATABASE_URL", "OBJECT_STORAGE_S3_SECRET_ACCESS_KEY",
        "GEMINUS_ANTHROPIC_API_KEY_A", "GEMINUS_ANTHROPIC_API_KEY_B", "GEMINUS_MUSE_API_KEY", "GEMINUS_AI_LIVE", "AI_API_KEY", "GEMINUS_UI_GALLERY"]
    }
  }
}
